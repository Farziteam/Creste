        "subheading": "Every review below comes from a confirmed order. Scroll for more."
      },
      "blocks": {
        "r1": { "type": "review", "settings": { "quote": "The Paper Craft Adventure Kit is too good. Everything you need is in the box and my daughter didn't need me once after the first step.", "author": "Vansh Arora", "rating": 5, "badge": "Verified purchase" } },
        "r2": { "type": "review", "settings": { "quote": "With two kids at different ages, finding one activity they'll both sit through has always been a challenge — some kits are too fiddly, others too babyish. Creste hits the balance perfectly.", "author": "Mrinal Sharma", "rating": 5, "badge": "Verified purchase" } },
        "r3": { "type": "review", "settings": { "quote": "It is my second purchase and I loved it. This time it was delivered a day before the expected date, so I'm very happy.", "author": "Harshita Sharma", "rating": 5, "badge": "Repeat customer" } },
        "r4": { "type": "review", "settings": { "quote": "Bought it as a rainy-day backup and it turned into a full weekend project. The instruction booklet is genuinely well designed.", "author": "Neha Kulkarni", "rating": 5, "badge": "Verified purchase" } },
        "r5": { "type": "review", "settings": { "quote": "Ordered for my nephew's 5th birthday. Sturdy pieces, no sharp edges, and nothing went missing in the post. He's already asked for the next one.", "author": "Aditya Menon", "rating": 4, "badge": "Gifted" } },
        "r6": { "type": "review", "settings": { "quote": "Packaging is gorgeous but the contents are the real win — 24 pieces and every single one had a purpose. No filler.", "author": "Ritika Bansal", "rating": 5, "badge": "Verified purchase" } },
        "r7": { "type": "review", "settings": { "quote": "Support answered my query in under an hour and helped me pick the right kit for a 4-year-old. Rare these days.", "author": "Sameer Qureshi", "rating": 5, "badge": "Support experience" } },
        "r8": { "type": "review", "settings": { "quote": "Honestly did not expect much at this price. Six kits later, it's our default birthday gift for the whole class. Converted.", "author": "Prachi Deshmukh", "rating": 5, "badge": "Repeat customer" } }
      },
