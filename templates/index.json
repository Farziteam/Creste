    "creste_howitbegan": {
      "type": "creste-howitbegan",
      "blocks": {
        "t1": {
          "type": "tile",
          "settings": {
            "image": "shopify://shop_images/IMAGE_1981e49e-d93b-4f66-ba34-e60e9385e708.png",
            "color": "#f4793a",
            "heading": "It all started in the middle of the 2020 lockdown",
            "body": "Screens didn’t just take over playtime, they took over studies and school. Kids were on a screen at least five hours a day, and something about that didn’t sit right with Nidhi.",
            "btn1_label": "",
            "btn1_link": "",
            "btn2_label": "",
            "btn2_link": ""
          }
        },
        "t2": {
          "type": "tile",
          "settings": {
            "image": "shopify://shop_images/image_50.png",
            "color": "#3aa6c0",
            "heading": "The joy of learning by doing went missing",
            "body": "It wasn’t just the screen time. The feel of paper, the fun of projects, real research, and learning beside friends were all quietly going missing.",
            "btn1_label": "",
            "btn1_link": "",
            "btn2_label": "",
            "btn2_link": ""
          }
        },
        "t3": {
          "type": "tile",
          "settings": {
            "image": "shopify://shop_images/image_51.png",
            "color": "#8e6fd6",
            "heading": "That’s when Nidhi decided to build something better.",
            "body": "So she started a little school for her own kids at the dining table, bells ringing for lessons and breaks, experiments and models bringing each topic to life. Soon her friends were asking her to teach their kids too.",
            "btn1_label": "",
            "btn1_link": "",
            "btn2_label": "",
            "btn2_link": ""
          }
        },
        "t4": {
          "type": "tile",
          "settings": {
            "image": "shopify://shop_images/100_Pure_Himalayan_Kapiva_Shilajit_Resin_-_30gm.png",
            "color": "#6bb07a",
            "heading": " A dining-table school turned into Creste",
            "body": "Then came friends of friends, and a cycle began. By 2022 this was needed everywhere, and Creste was born, turning that same spirit into DIY kits for kids that make hands-on learning something they build with their own two hands.",
            "btn1_label": "Learn More About Us",
            "btn1_link": "/pages/our-story",
            "btn2_label": "Explore Products",
            "btn2_link": "/collections/all"
          }
        }
      },
