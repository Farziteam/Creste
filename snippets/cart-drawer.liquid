              <span class="creste-cart-note__icon">

                 <span class="creste-cart-note__icon">
  <img
    src="https://cdn.shopify.com/s/files/1/0673/0114/6782/files/52db2e7ef254d8193e49405b79dd7646563b6b8c.jpg?v=1787814819"
