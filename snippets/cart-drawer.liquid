              </label>

                <textarea
                  class="creste-cart-note__textarea"
                  id="CartDrawer-NoteText"
                  maxlength="600"
                  placeholder="Write your message here..."
                >{%- for item in cart.items -%}
                  {%- if item.variant.id == creste_note_variant_id -%}
                    {{ item.properties['Handwritten Note'] | escape }}
                  {%- endif -%}
                {%- endfor -%}</textarea>

            </div>
{%- if collections['age-group-up-to-3years']
  and collections['age-group-up-to-3years'].products.size > 0
-%}

  <div class="creste-cart-picks">

    <p class="creste-cart-picks__title">
      Picked for ages 0&ndash;3
    </p>

    <div class="creste-cart-picks__row">

      {%- for product in collections['age-group-up-to-3years'].products limit: 8 -%}

        {%- assign pv = product.selected_or_first_available_variant -%}

        <div class="creste-cart-pick">

          <div class="creste-cart-pick__image">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 160
                | image_tag: alt: product.title, loading: 'lazy'
              }}
            {%- endif -%}
          </div>

          <div class="creste-cart-pick__body">

            <p class="creste-cart-pick__name">
              {{ product.title }}
            </p>

            <p class="creste-cart-pick__price">
              {{ pv.price | money | replace: ".00", "" | replace: "Rs. ", "₹ " }}

              {%- if pv.compare_at_price > pv.price -%}

                <span class="creste-cart-pick__compare">
                  {{ pv.compare_at_price | money_without_currency | replace: ".00", "" | replace: "Rs. ", "₹ " }}
                </span>

                {%- assign pick_off = pv.compare_at_price
                  | minus: pv.price
                  | times: 100
                  | divided_by: pv.compare_at_price
                -%}

                <span class="creste-cart-pick__off">
                  {{ pick_off }}% off
                </span>

              {%- endif -%}
            </p>

            <button
              type="button"
              class="creste-cart-pick__btn"
              data-pick-add
              data-variant-id="{{ pv.id }}"
              {% unless pv.available %}disabled{% endunless %}
            >
              {%- if pv.available -%}
                Add To Cart
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>

          </div>

        </div>

      {%- endfor -%}

    </div>

  </div>

{%- endif -%}
{%- endif -%}
    </div>
    <div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
             <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

  
        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="discounts__discount discounts__discount--end">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                  {{ discount.title | escape }}
                  (-{{ discount.total_allocated_amount | money }})
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- liquid
            assign creste_mrp = 0
            assign creste_gift_count = 0
            for line in cart.items
              assign creste_line_compare = line.variant.compare_at_price | default: 0
              if creste_line_compare < line.original_price
                assign creste_line_compare = line.original_price
              endif
              assign creste_mrp = creste_line_compare | times: line.quantity | plus: creste_mrp
              if line.properties['Gift wrapping'] == 'Yes'
                assign creste_gift_count = creste_gift_count | plus: 1
              endif
            endfor
            assign creste_items_subtotal = cart.items_subtotal_price
            assign creste_item_discount = creste_mrp | minus: creste_items_subtotal
            assign creste_cart_discount = creste_items_subtotal | minus: cart.total_price
            assign creste_total_savings = creste_mrp | minus: cart.total_price
            assign creste_grand_total = cart.total_price
          -%}

          <details class="creste-view-summary" id="CartDrawer-ViewSummary">
            <summary class="visually-hidden">View Summary</summary>
            <div class="creste-view-summary__body">
              <div class="creste-view-summary__row">
                <span>MRP</span>
                <span>{{ creste_mrp | money  | replace: "Rs. ", "₹ " }}</span>
              </div>
              {%- if creste_cart_discount > 0 -%}
                <div class="creste-view-summary__row creste-view-summary__row--discount">
                  <span>Card Price</span>
                  <span>-{{ creste_cart_discount | money  | replace: "Rs. ", "₹ " }}</span>
                </div>
              {%- endif -%}
              {%- if creste_item_discount > 0 -%}
                <div class="creste-view-summary__row creste-view-summary__row--discount">
                  <span>Item Discount</span>
                  <span>-{{ creste_item_discount | money | replace: "Rs. ", "₹ " }}</span>
                </div>
              {%- endif -%}
              {%- if creste_gift_count > 0 -%}
                <div class="creste-view-summary__row creste-view-summary__row--free">
                  <span>Gift wrapping ({{ creste_gift_count }})</span>
                  <span>Free</span>
                </div>
              {%- endif -%}
              {%- if creste_note_active -%}
                <div class="creste-view-summary__row" id="CartDrawer-NoteFeeRow">
                  <span>Handwritten Note</span>
                  <span>{{ creste_note_price | times:100 | money | replace: "Rs. ", "₹ " }}</span>
                </div>
              {%- endif -%}
              <div class="creste-view-summary__row creste-view-summary__row--total">
                <span>Sub Total</span>
                <span>{{ cart.total_price | money | replace: "Rs. ", "₹ " }}</span>
              </div>
            </div>
          </details>

          <div class="creste-cart-summary">
            <div class="creste-cart-summary__row">
              <span class="creste-cart-summary__subtotal-label">
                Subtotal &middot; {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
                &nbsp;<button type="button" class="creste-cart-summary__toggle" data-view-summary-toggle aria-expanded="false" aria-controls="CartDrawer-ViewSummary">View Summary</button>
              </span>
              <span class="creste-cart-summary__total totals__total-value" role="status">
                {{ creste_grand_total | money_with_currency | replace: "Rs. " , "₹ " | replace: ".00", "" }}
              </span>
            </div>
            <div class="creste-cart-summary__row">
              <small class="creste-cart-summary__note tax-note caption-large rte">
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              </small>
              {%- if creste_total_savings > 0 -%}
                <span class="creste-cart-summary__savings">You saved {{ creste_total_savings | money | replace: "Rs. ", "₹ " | replace: ".00", ""}}</span>
              {%- endif -%}
            </div>
          </div>
        </div>

          <div class="cart__ctas" {{ block.shopify_attributes }}>
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button"
              name="checkout"
              form="CartDrawer-Form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              {{ 'sections.cart.checkout' | t }}
                  <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.6 6L0 1.4L1.4 0L7.4 6L1.4 12L0 10.6L4.6 6Z" fill="white"/>
            </svg>
        </button>
        

          </div>

          <div class="creste-trust-badges">
            <span>COD available</span>
            <span>7-day easy returns</span>
            <span>Child-safe materials</span>
          </div>
      </div>
    </div>
  </div>
  
</cart-drawer>

<script>
(function () {
  if (window.__cresteCartDrawerBound) return;
  window.__cresteCartDrawerBound = true;

  function refreshDrawer(sectionsHtml) {
    if (!sectionsHtml) return;

    var doc = new DOMParser().parseFromString(sectionsHtml, 'text/html');
    var fresh = doc.querySelector('cart-drawer');
    var current = document.querySelector('cart-drawer');

    if (fresh && current) {
      current.innerHTML = fresh.innerHTML;
    }
  }

function refreshDrawerKeepScroll(sectionsHtml) {
  if (!sectionsHtml) return;

  var wrap = document.querySelector('.wrap');

  if (!wrap) {
    refreshDrawer(sectionsHtml);
    return;
  }

  /*
   * Save the current scroll position
   */
  var savedScrollTop = wrap.scrollTop;

  /*
   * Find the first cart item visible in the viewport
   */
  var items = wrap.querySelectorAll('.creste-cart-item');

  var anchorItem = null;
  var anchorOffset = 0;

  items.forEach(function (item) {
    var rect = item.getBoundingClientRect();
    var wrapRect = wrap.getBoundingClientRect();

    if (
      !anchorItem &&
      rect.bottom > wrapRect.top
    ) {
      anchorItem = item;
      anchorOffset = rect.top - wrapRect.top;
    }
  });

  /*
   * Re-render the drawer
   */
  refreshDrawer(sectionsHtml);

  requestAnimationFrame(function () {
    var newWrap = document.querySelector('.wrap');

    if (!newWrap) return;

    /*
     * Find the same item in the new drawer
     */
    if (anchorItem) {
      var anchorId = anchorItem.id;
      var newAnchor = document.getElementById(anchorId);

      if (newAnchor) {
        var newWrapRect = newWrap.getBoundingClientRect();
        var newAnchorRect = newAnchor.getBoundingClientRect();

        /*
         * Keep the item at the same screen position
         */
        newWrap.scrollTop +=
          (newAnchorRect.top - newWrapRect.top) -
          anchorOffset;
      } else {
        newWrap.scrollTop = savedScrollTop;
      }
    } else {
      newWrap.scrollTop = savedScrollTop;
    }
  });
}


  async function refreshCartDrawer() {
    try {
      var res = await fetch('/?sections=cart-drawer', {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!res.ok) {
        throw new Error('Drawer refresh failed');
      }

      var data = await res.json();

      if (data['cart-drawer']) {
        refreshDrawer(data['cart-drawer']);
      }
    } catch (err) {
      console.error('cart-drawer-refresh', err);
    }
  }


  /* =========================
     VIEW SUMMARY
  ========================= */

  document.addEventListener('click', function (e) {
    var toggle = e.target.closest('[data-view-summary-toggle]');

    if (!toggle) return;

    var details = document.getElementById('CartDrawer-ViewSummary');

    if (details) {
      var willOpen = !details.open;

      details.open = willOpen;

      toggle.setAttribute(
        'aria-expanded',
        String(willOpen)
      );

      toggle.textContent = willOpen
        ? 'Hide Summary'
        : 'View Summary';
    }
  });


  /* =========================
     GIFT WRAPPING
  ========================= */

  document.addEventListener('click', async function (e) {
    var gwBtn = e.target.closest('[data-gw-toggle]');

    if (!gwBtn) return;

    e.preventDefault();

    if (gwBtn.__busy) return;

    gwBtn.__busy = true;
    gwBtn.style.opacity = '0.6';

    var line =
      Number(gwBtn.getAttribute('data-line')) || 1;

    var qty =
      Number(gwBtn.getAttribute('data-qty')) || 1;

    var add =
      gwBtn.getAttribute('data-add') === '1';

    try {
      var res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          line: line,
          quantity: qty,
          properties: add
            ? { 'Gift wrapping': 'Yes' }
            : { 'Gift wrapping': '' },
          sections: 'cart-drawer',
          sections_url: location.pathname
        })
      });

      if (!res.ok) {
        throw new Error('Gift wrap update failed');
      }

      var data = await res.json();

      if (
        data.sections &&
        data.sections['cart-drawer']
      ) {
        refreshDrawer(
          data.sections['cart-drawer']
        );
      }

    } catch (err) {
      console.error('gw', err);

    } finally {
      gwBtn.__busy = false;
      gwBtn.style.opacity = '';
    }
  });


  /* =========================
     HANDWRITTEN NOTE
  ========================= */

  var HANDWRITTEN_NOTE_VARIANT_ID = 48203361779870;

  async function getCart() {
    var res = await fetch('/cart.js', {
      headers: {
        'Accept': 'application/json'
      }
    });

    if (!res.ok) {
      throw new Error('Could not get cart');
    }

    return await res.json();
  }


  async function addHandwrittenNote(noteText) {
    var cart = await getCart();

    var existingNoteItem = cart.items.find(function (item) {
      return Number(item.variant_id) === HANDWRITTEN_NOTE_VARIANT_ID;
    });

    /* Already added - just update the message */
    if (existingNoteItem) {
      return updateHandwrittenNote(
        existingNoteItem.key,
        noteText
      );

    }

    var res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: [
          {
            id: HANDWRITTEN_NOTE_VARIANT_ID,
            quantity: 1,
            properties: {
              'Handwritten Note': noteText || ''
            }
          }
        ],
        sections: 'cart-drawer',
        sections_url: location.pathname
      })
    });

    if (!res.ok) {
      var errorData = await res.json().catch(function () {
        return {};
      });

      throw new Error(
        errorData.description ||
        'Could not add handwritten note'
      );
    }

    return await res.json();
  }


  async function updateHandwrittenNote(lineKey, noteText) {
    var res = await fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: lineKey,
        quantity: 1,
        properties: {
          'Handwritten Note': noteText || ''
        },
        sections: 'cart-drawer',
        sections_url: location.pathname
      })
    });

    if (!res.ok) {
      throw new Error('Could not update handwritten note');
    }

    return await res.json();
  }

      async function saveCurrentHandwrittenNote() {
  var toggle =
    document.getElementById('CartDrawer-NoteToggle');

  var noteText =
    document.getElementById('CartDrawer-NoteText');

  if (!toggle || !toggle.checked || !noteText) {
    return;
  }

  var cart = await getCart();

  var noteItem = cart.items.find(function (item) {
    return Number(item.variant_id) ===
      HANDWRITTEN_NOTE_VARIANT_ID;
  });

  if (!noteItem) {
    return;
  }

  await updateHandwrittenNote(
    noteItem.key,
    noteText.value.trim()
  );
}


  async function removeHandwrittenNote() {
    var cart = await getCart();

    var noteItem = cart.items.find(function (item) {
      return Number(item.variant_id) === HANDWRITTEN_NOTE_VARIANT_ID;
    });

    if (!noteItem) {
      return;
    }

    var res = await fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: noteItem.key,
        quantity: 0,
        sections: 'cart-drawer',
        sections_url: location.pathname
      })
    });

    if (!res.ok) {
      throw new Error('Could not remove handwritten note');
    }

    return await res.json();
  }


  document.addEventListener('change', async function (e) {
    var toggle = e.target.closest('#CartDrawer-NoteToggle');

    if (!toggle) return;

    var field = document.getElementById('CartDrawer-NoteField');

    if (field) {
      field.classList.toggle(
        'is-open',
        toggle.checked
      );
    }

    if (toggle.__busy) return;

    toggle.__busy = true;
    toggle.disabled = true;

    try {

      if (toggle.checked) {

        var noteTextElement =
          document.getElementById('CartDrawer-NoteText');

        var noteText =
          noteTextElement
            ? noteTextElement.value.trim()
            : '';

        var data =
          await addHandwrittenNote(noteText);

 if (
  data.sections &&
  data.sections['cart-drawer']
) {
  refreshDrawerKeepScroll(
    data.sections['cart-drawer']
  );
} else {
  var wrap = document.querySelector('.wrap');
  var savedScrollTop = wrap ? wrap.scrollTop : 0;

  await refreshCartDrawer();

  requestAnimationFrame(function () {
    var newWrap = document.querySelector('.wrap');

    if (newWrap) {
      newWrap.scrollTop = savedScrollTop;
    }
  });
}

      } else {

        var data =
          await removeHandwrittenNote();

        if (
          data &&
          data.sections &&
          data.sections['cart-drawer']
        ) {
          refreshDrawer(
            data.sections['cart-drawer']
          );
        } else {
          await refreshCartDrawer();
        }

      }

    } catch (err) {

      console.error(
        'handwritten-note-toggle',
        err
      );

      /*
       * If something failed, restore checkbox state.
       */
      toggle.checked = !toggle.checked;

      if (field) {
        field.classList.toggle(
          'is-open',
          toggle.checked
        );
      }

    } finally {

      toggle.__busy = false;
      toggle.disabled = false;

    }
  });


  /*
   * Save handwritten message to the ₹50 product
   * line-item property.
   */
  document.addEventListener('blur', async function (e) {

    var noteText =
      e.target.closest('#CartDrawer-NoteText');

    if (!noteText) return;

    var toggle =
      document.getElementById('CartDrawer-NoteToggle');

    if (!toggle || !toggle.checked) return;

    var text =
      noteText.value.trim();

    try {

      var cart = await getCart();

      var noteItem = cart.items.find(function (item) {
        return Number(item.variant_id) ===
          HANDWRITTEN_NOTE_VARIANT_ID;
      });

      if (!noteItem) return;

      await updateHandwrittenNote(
        noteItem.key,
        text
      );

    } catch (err) {

      console.error(
        'handwritten-note-text',
        err
      );

    }

  }, true);
  /* =========================
   CHECKOUT - SAVE NOTE FIRST
========================= */

document.addEventListener('click', async function (e) {

  var checkoutButton =
    e.target.closest('#CartDrawer-Checkout');

  if (!checkoutButton) return;

  if (checkoutButton.__noteSaving) return;

  var toggle =
    document.getElementById('CartDrawer-NoteToggle');

  if (!toggle || !toggle.checked) {
    return;
  }

  e.preventDefault();

  checkoutButton.__noteSaving = true;
  checkoutButton.disabled = true;

  try {

    await saveCurrentHandwrittenNote();

    /*
     * Now allow checkout to continue.
     */
    window.location.href = '/checkout';

  } catch (err) {

    console.error(
      'checkout-note-save',
      err
    );

    checkoutButton.__noteSaving = false;
    checkoutButton.disabled = false;

    alert(
      'Please wait a moment and try checkout again.'
    );
  }

});


  /* =========================
     ADD CART PICK
  ========================= */

  document.addEventListener('click', async function (e) {
    var btn = e.target.closest('[data-pick-add]');

    if (!btn) return;

    e.preventDefault();

    if (btn.disabled) return;

    var variantId =
      btn.getAttribute('data-variant-id');

    var originalText =
      btn.textContent.trim();

    btn.disabled = true;
    btn.textContent = 'Adding...';

    try {
      var res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [
            {
              id: Number(variantId),
              quantity: 1
            }
          ]
        })
      });

      if (!res.ok) {
        var errorData = await res.json().catch(function () {
          return {};
        });

        throw new Error(
          errorData.description ||
          'Product could not be added'
        );
      }

      /* Get the latest cart drawer */
      await refreshCartDrawer();

      btn.textContent = 'Added!';

      /* Restore the button after a short delay */
      setTimeout(function () {
        btn.textContent = originalText;
        btn.disabled = false;
      }, 1500);

    } catch (err) {
      console.error('pick-add', err);

      btn.textContent = 'Try Again';

      setTimeout(function () {
        btn.textContent = originalText;
        btn.disabled = false;
      }, 1500);
    }
  });

})();
</script>


