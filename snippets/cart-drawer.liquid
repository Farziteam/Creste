{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }

/* Creste Cart Drawer Redesign — Figma-accurate rebuild */
  .cart-drawer, .cart-drawer * { box-sizing: border-box; }
    .cart-drawer .drawer__inner { background: #FFFFFF; border-radius: 24px 0 0 24px; font-family: 'Nunito Sans', sans-serif; color: #2E2418; display: flex; flex-direction: column; }
      @media screen and (min-width: 750px) { .cart-drawer .drawer__inner { width: 500px; max-width: 500px; } }
        @media screen and (max-width: 749px) { .cart-drawer .drawer__inner { border-radius: 0; width: 100vw; max-width: 100vw; } }
          .cart-drawer .drawer__header { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 20px 20px 16px; border-bottom: 2px solid #FFCE00; }
            .cart-drawer .drawer__heading { font-family: 'Nunito Sans', sans-serif; font-weight: 700; font-size: 24px; line-height: 1.2; color: #2E2418; display: flex; align-items: center; gap: 10px; margin: 0; flex: 1 1 auto; }
              .cart-drawer .creste-cart-badge { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 12px; background: #FFF2BE; color: #5C4B38; padding: 5px 13px; border-radius: 999px; }
                .cart-drawer .drawer__close { background: #FFF3C4; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
                  .cart-drawer .creste-cart-tagline { width: 100%; margin: 0; font-family: 'Fredoka One', cursive; font-weight: 400; font-size: 12px; line-height: 1.2; color: #3AACCC; }

                    /* Shipping / gift progress card — single unified design matching Figma */
                      .creste-cart-progress { margin: 16px 20px; padding: 16px 12px; border-radius: 16px; background: #EDF7F0; display: flex; flex-direction: column; gap: 8px; }
                        .creste-cart-progress__heading { font-family: 'Quicksand', sans-serif; font-weight: 700; font-size: 14px; line-height: 1.2; color: #2F6B41; margin: 0; }
                          .creste-cart-progress__bar { position: relative; height: 10px; border-radius: 999px; background: #D6EBDD; margin-top: 4px; }
                            .creste-cart-progress__fill { position: absolute; top: 0; left: 0; height: 100%; border-radius: 999px; background: #5BAD6F; transition: width .3s ease; }
                              .creste-cart-progress__message { margin: 0; font-family: 'Poppins', sans-serif; font-weight: 400; font-size: 13px; line-height: 1.2; color: #5C4B38; }
                                .creste-cart-progress__message strong { font-weight: 600; }

                                  /* Cart items */
                                    .cart-drawer-items thead th { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
                                      .cart-drawer-items tbody { display: block; padding: 4px 20px; }
                                        .cart-drawer-items tr.cart-item { display: flex; align-items: flex-start; gap: 12px; position: relative; padding: 16px 0; border-bottom: 1px dashed #E7DCC5; }
                                          .cart-drawer-items tr.cart-item:last-child { border-bottom: 0; }
                                            .cart-drawer-items .cart-item td { display: block; padding: 0; border: 0; }
                                              .cart-drawer-items .cart-item__media { flex: 0 0 80px; }
                                                .cart-drawer-items .cart-item__image { width: 80px; height: 75px; border-radius: 12px; object-fit: cover; }
                                                  .cart-drawer-items .cart-item__details { flex: 1 1 auto; min-width: 0; padding-right: 28px !important; }
                                                    .cart-drawer-items .cart-item__name { font-family: 'Nunito Sans', sans-serif; font-weight: 800; font-size: 14px; color: #2E2418; }
                                                      .cart-drawer-items .cart-item__quantity { flex: 0 0 auto; margin-top: 8px; }
                                                        .cart-drawer-items .cart-remove-button { position: absolute; top: 16px; right: 0; color: #E0483E; }

                                                          .creste-item-prices { display: flex; align-items: center; gap: 8px; margin-top: 4px; flex-wrap: wrap; }
                                                            .creste-item-price { font-family: 'Nunito Sans', sans-serif; font-weight: 900; font-size: 16px; color: #F4793A; }
                                                              .creste-item-compare { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 13px; color: #2B1702; opacity: .4; text-decoration: line-through; }
                                                                .creste-item-discount { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 12px; color: #5BAD6F; }

                                                                  .quantity-popover-wrapper { background: #FFFFFF; border: 1px solid #E7DCC5; border-radius: 999px; padding: 2px 4px; }

                                                                    /* Gift wrap — applies to the whole order */
                                                                      .creste-gift-wrap { margin: 4px 20px 16px; background: #FCF0F6; border-radius: 22px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
                                                                        .creste-gift-wrap__label { display: flex; align-items: center; gap: 10px; }
                                                                          .creste-gift-wrap__title { font-family: 'Nunito Sans', sans-serif; font-weight: 800; font-size: 14px; color: #2E2418; margin: 0; }
                                                                            .creste-gift-wrap__subtitle { font-family: 'Poppins', sans-serif; font-weight: 400; font-size: 11px; color: #8A6D8F; margin: 2px 0 0; }
                                                                              .creste-gift-wrap input[type="checkbox"] { width: 20px; height: 20px; accent-color: #F4793A; flex: 0 0 auto; }

                                                                                /* Footer / summary */
                                                                                  .cart-drawer__footer, .cart-drawer .drawer__footer { background: #FFFFFF; padding: 16px 20px 20px; border-top: 2px solid #FFCE00; }
                                                                                    .creste-cart-summary { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
                                                                                      .creste-cart-summary__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
                                                                                        .creste-cart-summary__subtotal { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 14px; color: #5C4B38; display: flex; align-items: center; gap: 8px; }
                                                                                          .creste-cart-summary__view-link { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 14px; color: #F4793A; text-decoration: underline; background: none; border: 0; padding: 0; cursor: pointer; }
                                                                                            .creste-cart-summary__total { font-family: 'Nunito Sans', sans-serif; font-weight: 700; font-size: 20px; color: #2E2418; margin: 0; }
                                                                                              .creste-cart-summary__note { font-family: 'Poppins', sans-serif; font-weight: 400; font-size: 11px; color: #A08B76; }
                                                                                                .creste-cart-summary__savings { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 11px; color: #3E8A54; }

                                                                                                  .cart__checkout-button { background: #F4793A !important; border-radius: 999px !important; width: 100%; min-height: 56px; font-family: 'Quicksand', sans-serif; font-weight: 700; font-size: 20px; color: #FFFFFF; padding: 14px 48px !important; display: flex; align-items: center; justify-content: center; gap: 8px; }

                                                                                                    .creste-trust-badges { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 14px; flex-wrap: wrap; }
                                                                                                      .creste-trust-badges span { font-family: 'Poppins', sans-serif; font-weight: 400; font-size: 11px; color: #7A5C3E; }/* Creste Cart Drawer Redesign — Figma-accurate rebuild */
