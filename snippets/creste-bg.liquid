{%- comment -%}Applies desktop/mobile background image to a section. Params: id (element id), d (desktop image), m (mobile image){%- endcomment -%}
{%- if d != blank or m != blank -%}
<style>
#{{ id }}{background-size:cover;background-position:center;background-repeat:no-repeat;{% if m != blank %}background-image:url({{ m | image_url: width: 1200 }});{% elsif d != blank %}background-image:url({{ d | image_url: width: 2600 }});{% endif %}}
@media(min-width:750px){ {% if d != blank %}#{{ id }}{background-image:url({{ d | image_url: width: 2600 }});}{% endif %} }
</style>
{%- endif -%}