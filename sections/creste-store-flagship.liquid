creste-store-gallery.liquid
<section id="store-flagship-{{ section.id }}" class="store-flagship">
  <div class="store-flagship__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="store-flagship__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="store-flagship__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="store-flagship__card">
      <div class="store-flagship__photo">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'store-flagship__photo-img', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- else -%}
          <span class="store-flagship__photo-pin" aria-hidden="true"></span>
          <span class="store-flagship__photo-placeholder">{{ section.settings.photo_placeholder }}</span>
        {%- endif -%}
      </div>
      <div class="store-flagship__info">
        {%- if section.settings.status_label != blank -%}
          <p class="store-flagship__status store-flagship__status--{{ section.settings.status_color }}">
            <span class="store-flagship__status-dot"></span>{{ section.settings.status_label }}
          </p>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="store-flagship__field"><p class="store-flagship__field-label">Address</p><p class="store-flagship__field-value">{{ section.settings.address }}</p></div>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div class="store-flagship__field"><p class="store-flagship__field-label">Hours</p><p class="store-flagship__field-value">{{ section.settings.hours }}</p></div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="store-flagship__field"><p class="store-flagship__field-label">Phone</p><p class="store-flagship__field-value">{{ section.settings.phone }}</p></div>
        {%- endif -%}
        <div class="store-flagship__actions">
          {%- if section.settings.directions_link != blank -%}
            <a href="{{ section.settings.directions_link }}" class="store-flagship__btn store-flagship__btn--primary" target="_blank" rel="noopener">Get directions</a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="store-flagship__btn store-flagship__btn--secondary">Call store</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #store-flagship-{{ section.id }} { background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #store-flagship-{{ section.id }} .store-flagship__inner { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  #store-flagship-{{ section.id }} .store-flagship__eyebrow { margin: 0 0 6px; font-family: 'Quicksand', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #f4793a; }
  #store-flagship-{{ section.id }} .store-flagship__heading { margin: 0 0 28px; color: #2c2a27; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: clamp(22px, 3vw, 30px); }
  #store-flagship-{{ section.id }} .store-flagship__card { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0; background: #fff; border-radius: 22px; overflow: hidden; box-shadow: 0 16px 40px rgba(44, 42, 39, 0.07); }
  #store-flagship-{{ section.id }} .store-flagship__photo { position: relative; min-height: 340px; background: #e0d8cc; overflow: hidden; }
  #store-flagship-{{ section.id }} .store-flagship__photo::before, #store-flagship-{{ section.id }} .store-flagship__photo::after { content: ''; position: absolute; border-radius: 50%; background: #e6e1d8; }
  #store-flagship-{{ section.id }} .store-flagship__photo::before { width: 65%; padding-bottom: 65%; left: -10%; bottom: -18%; }
  #store-flagship-{{ section.id }} .store-flagship__photo::after { width: 32%; padding-bottom: 32%; background: #ede7de; right: 12%; top: 18%; }
  #store-flagship-{{ section.id }} .store-flagship__photo-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #store-flagship-{{ section.id }} .store-flagship__photo-pin { position: absolute; top: 50%; left: 42%; width: 16px; height: 16px; border-radius: 50%; background: #f4793a; border: 4px solid #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.15); transform: translate(-50%, -50%); z-index: 2; }
  #store-flagship-{{ section.id }} .store-flagship__photo-placeholder { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); color: #9c968d; font-family: 'Poppins', sans-serif; font-size: 13px; z-index: 2; }
  #store-flagship-{{ section.id }} .store-flagship__info { padding: 36px 40px; display: flex; flex-direction: column; gap: 16px; }
  #store-flagship-{{ section.id }} .store-flagship__status { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 6px 14px; width: fit-content; border-radius: 999px; font-family: 'Poppins', sans-serif; font-size: 12.5px; font-weight: 600; background: #e2f0e6; color: #3f8a56; }
  #store-flagship-{{ section.id }} .store-flagship__status--closed { background: #fbe4ee; color: #b34766; }
  #store-flagship-{{ section.id }} .store-flagship__status-dot { width: 7px; height: 7px; border-radius: 50%; background: #5bad6d; }
  #store-flagship-{{ section.id }} .store-flagship__status--closed .store-flagship__status-dot { background: #d95c81; }
  #store-flagship-{{ section.id }} .store-flagship__field-label { margin: 0 0 3px; font-family: 'Quicksand', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #9c968d; }
  #store-flagship-{{ section.id }} .store-flagship__field-value { margin: 0; font-family: 'Poppins', sans-serif; font-size: 15px; line-height: 1.5; color: #2c2a27; }
  #store-flagship-{{ section.id }} .store-flagship__actions { display: flex; gap: 12px; margin-top: 8px; flex-wrap: wrap; }
  #store-flagship-{{ section.id }} .store-flagship__btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; border-radius: 999px; font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 600; text-decoration: none; border: 1.5px solid transparent; }
  #store-flagship-{{ section.id }} .store-flagship__btn--primary { background: #f4793a; color: #fff; }
  #store-flagship-{{ section.id }} .store-flagship__btn--secondary { background: #fff; color: #2c2a27; border-color: #e6e1d8; }
  @media screen and (max-width: 749px) {
    #store-flagship-{{ section.id }} .store-flagship__card { grid-template-columns: 1fr; }
    #store-flagship-{{ section.id }} .store-flagship__photo { min-height: 220px; }
    #store-flagship-{{ section.id }} .store-flagship__info { padding: 28px 24px; }
    #store-flagship-{{ section.id }} .store-flagship__actions { flex-direction: column; }
    #store-flagship-{{ section.id }} .store-flagship__btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Store Flagship",
  "tag": "section",
  "class": "section-store-flagship",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our flagship store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Creste Studio — Lucknow" },
    { "type": "image_picker", "id": "image", "label": "Store photo" },
    { "type": "text", "id": "photo_placeholder", "label": "Placeholder text (shown until a photo is added)", "default": "Store photo / map coming soon" },
    { "type": "text", "id": "status_label", "label": "Status label", "default": "Open now · closes 7:00 PM" },
    { "type": "select", "id": "status_color", "label": "Status color", "options": [
        { "value": "open", "label": "Open (green)" }, { "value": "closed", "label": "Closed (pink)" }
      ], "default": "open" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Flat no.1, 1st Floor, 3 Gokhle Marg, Near Red Hill School, Lucknow — 226001, Uttar Pradesh" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon – Sat · 10:00 AM – 7:00 PM" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 80810 26320" },
    { "type": "url", "id": "directions_link", "label": "Get directions link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F7F4EF" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 40 }
  ],
  "presets": [ { "name": "Store Flagship" } ]
}
{% endschema %}
