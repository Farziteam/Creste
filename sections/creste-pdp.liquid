<script>
  (function(){
    var root = document.getElementById('Cpdp-{{ uid }}');
    if(!root) return;
    var data = (window.CPDP && window.CPDP["{{ uid }}"]) || { variants:{} };
    var slides = root.querySelectorAll('.cpdp__slide');
    var thumbs = root.querySelectorAll('.cpdp__thumb');
    var cur = 0;
    function show(i){
      if(!slides.length) return;
      cur = (i + slides.length) % slides.length;
      slides.forEach(function(s,idx){ s.classList.toggle('is-active', idx===cur); });
      thumbs.forEach(function(t,idx){ t.classList.toggle('is-active', idx===cur); });
    }
    thumbs.forEach(function(t){ t.addEventListener('click', function(){ show(parseInt(t.dataset.target,10)); }); });
    var prev = root.querySelector('.cpdp__nav--prev');
    var next = root.querySelector('.cpdp__nav--next');
    if(prev) prev.addEventListener('click', function(){ show(cur-1); });
    if(next) next.addEventListener('click', function(){ show(cur+1); });
    var idInput = root.querySelector('.cpdp__var-id');
    var priceEl = root.querySelector('[data-price]');
    var compareEl = root.querySelector('[data-compare]');
    var offEl = root.querySelector('[data-off]');
    var sPrice = root.querySelector('[data-sticky-price]');
    var sCompare = root.querySelector('[data-sticky-compare]');
    var sOff = root.querySelector('[data-sticky-off]');
    var atcLabels = root.querySelectorAll('[data-atc-label]');
    var atcBtns = root.querySelectorAll('[data-atc]');
    var qtyVal = root.querySelector('.cpdp__qty-val');
    function selectVariant(id){
      var v = data.variants[id];
      if(!v) return;
      if(idInput) idInput.value = id;
      if(priceEl) priceEl.textContent = v.price;
      if(sPrice) sPrice.textContent = v.price;
      if(compareEl){ if(v.compare){ compareEl.textContent = v.compare; compareEl.style.display=''; } else { compareEl.style.display='none'; } }
      if(sCompare){ if(v.compare){ sCompare.textContent = v.compare; sCompare.style.display=''; } else { sCompare.style.display='none'; } }
      if(offEl){ if(v.off){ offEl.textContent = v.off; offEl.style.display=''; } else { offEl.style.display='none'; } }
      if(sOff){ if(v.off){ sOff.textContent = v.off; sOff.style.display=''; } else { sOff.style.display='none'; } }
      atcLabels.forEach(function(l){ l.textContent = v.available ? 'Add to Cart' : 'Sold out'; });
      atcBtns.forEach(function(b){ b.disabled = !v.available; });
      if(v.mediaId){ var idx=-1; slides.forEach(function(s,i){ if(s.dataset.mediaId === String(v.mediaId)) idx=i; }); if(idx>=0) show(idx); }
    }
    root.querySelectorAll('.cpdp__theme').forEach(function(btn){
      btn.addEventListener('click', function(){
        root.querySelectorAll('.cpdp__theme').forEach(function(b){ b.classList.remove('is-selected'); b.setAttribute('aria-checked','false'); });
        btn.classList.add('is-selected'); btn.setAttribute('aria-checked','true');
        selectVariant(btn.dataset.variantId);
      });
    });
    root.querySelectorAll('.cpdp__qty-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        var val = parseInt(qtyVal.value,10) || 1;
        val += parseInt(btn.dataset.dir,10);
        if(val < 1) val = 1;
        qtyVal.value = val;
      });
    });
    root.querySelectorAll('.cpdp__tab').forEach(function(tab){
      tab.addEventListener('click', function(){
        var name = tab.dataset.tab;
        root.querySelectorAll('.cpdp__tab').forEach(function(t){ var on=t===tab; t.classList.toggle('is-active',on); t.setAttribute('aria-selected', on?'true':'false'); });
        root.querySelectorAll('.cpdp__panel').forEach(function(p){ p.classList.toggle('is-active', p.dataset.panel===name); });
      });
    });
    root.querySelectorAll('.cpdp__offer-code').forEach(function(btn){
      btn.addEventListener('click', function(){
        var code = btn.dataset.code || '';
        var done = function(){ var lbl = btn.querySelector('span'); var old = lbl.textContent; btn.classList.add('is-copied'); lbl.textContent='Copied!'; setTimeout(function(){ lbl.textContent=old; btn.classList.remove('is-copied'); },1400); };
        if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(code).then(done).catch(done); } else { done(); }
      });
    });
    root.querySelectorAll('.cpdp__po-card').forEach(function(c){
      c.addEventListener('click', function(){
        root.querySelectorAll('.cpdp__po-card').forEach(function(x){ x.classList.remove('is-selected'); });
        c.classList.add('is-selected');
        if(qtyVal){ qtyVal.value = c.dataset.qty || '1'; }
      });
    });
    var buynow = root.querySelector('[data-buynow]');
    if(buynow){
      buynow.addEventListener('click', function(){
        var form = document.getElementById('cpdp-form-{{ uid }}');
        if(!form) return;
        var fd = new FormData(form);
        fetch('/cart/add.js', { method:'POST', body:fd, headers:{ 'Accept':'application/json' } }).then(function(r){ return r.json(); }).then(function(){ window.location.href = '/checkout'; }).catch(function(){ form.submit(); });
      });
    }
    var cpdpMainForm = document.getElementById('cpdp-form-{{ uid }}');
    if(cpdpMainForm){
    cpdpMainForm.addEventListener('submit', function(e){
    e.preventDefault();
    var submitBtn = cpdpMainForm.querySelector('[type="submit"]');
    if(submitBtn){ submitBtn.disabled = true; }
    var fd = new FormData(cpdpMainForm);
    fd.append('sections', 'cart-drawer,cart-icon-bubble');
    fetch('/cart/add.js', { method:'POST', body:fd, headers:{ 'Accept':'application/json' } })
    .then(function(r){ return r.json(); })
    .then(function(data){
    if(data.status){
    alert(data.description || 'Could not add this item to your cart.');
    return;
    }
    var cartDrawerEl = document.querySelector('cart-drawer');
    if(cartDrawerEl && typeof cartDrawerEl.renderContents === 'function'){
    cartDrawerEl.renderContents(data);
    } else {
    window.location.href = '/cart';
    }
    })
    .catch(function(){ cpdpMainForm.submit(); })
    .finally(function(){ if(submitBtn){ submitBtn.disabled = false; } });
    });
    }
    var shareBtn = root.querySelector('[data-share]');
    if(shareBtn){
      shareBtn.addEventListener('click', function(){
        var url = shareBtn.getAttribute('data-share-url') || location.href;
        var title = shareBtn.getAttribute('data-share-title') || document.title;
        if(navigator.share){ navigator.share({ title:title, url:url }).catch(function(){}); }
        else if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(url); var t=shareBtn.getAttribute('aria-label'); shareBtn.setAttribute('aria-label','Link copied'); setTimeout(function(){ shareBtn.setAttribute('aria-label', t); },1400); }
      });
    }
    var sticky = root.querySelector('.cpdp__sticky');
    var anchor = root.querySelector('.cpdp__buy');
    if(sticky && anchor && 'IntersectionObserver' in window){
      new IntersectionObserver(function(entries){
        entries.forEach(function(e){ sticky.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0); });
      }, {threshold:0}).observe(anchor);
    } else if(sticky){ sticky.classList.add('is-visible'); }
  })();
</script>

