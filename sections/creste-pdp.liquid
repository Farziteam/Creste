{%- comment -%}
  Creste — Custom Product Detail Page (PDP) — product-driven
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign wa = section.settings.whatsapp_number | default: '919999999999'
  assign cur = product.selected_or_first_available_variant
  assign heading_title = section.settings.title_override
  if heading_title == blank
    assign heading_title = product.title
  endif
-%}

<section id="Cpdp-{{ uid }}" class="cpdp" data-section-id="{{ uid }}">
  <div class="cpdp__wrap">

    <nav class="cpdp__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="cpdp__crumb-sep">›</span>
      <span class="cpdp__crumb-current">{{ heading_title }}</span>
    </nav>

    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="cpdp-form-{{ uid }}" class="cpdp__form">
    <div class="cpdp__hero">

      <div class="cpdp__col-left">
        <div class="cpdp__gallery">
          <div class="cpdp__badges">
            {%- if section.settings.badge_1 != blank -%}<span class="cpdp__badge cpdp__badge--best">{{ section.settings.badge_1 }}</span>{%- endif -%}
            {%- if section.settings.badge_2 != blank -%}<span class="cpdp__badge cpdp__badge--soft">{{ section.settings.badge_2 }}</span>{%- endif -%}
          </div>
          <button type="button" class="cpdp__expand" aria-label="Expand image"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>
          <div class="cpdp__stage">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="cpdp__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">{{ media | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cpdp__img', alt: media.alt | default: product.title }}</div>
              {%- endfor -%}
            {%- else -%}
              <div class="cpdp__slide is-active" data-index="0"><div class="cpdp__img cpdp__img--ph">{{ 'product-apparel-1' | placeholder_svg_tag: 'cpdp__ph-svg' }}</div></div>
            {%- endif -%}
          </div>
          <button type="button" class="cpdp__nav cpdp__nav--prev" aria-label="Previous image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button type="button" class="cpdp__nav cpdp__nav--next" aria-label="Next image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cpdp__thumbs">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button type="button" class="cpdp__thumb{% if forloop.first %} is-active{% endif %}" data-target="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">{{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="cpdp__tutorial">
          <h3 class="cpdp__tutorial-title">Watch Tutorial</h3>
          {%- if section.settings.tutorial_url != blank -%}<a href="{{ section.settings.tutorial_url }}" target="_blank" rel="noopener" class="cpdp__video-link">{%- endif -%}
          <div class="cpdp__video">
            {%- if section.settings.tutorial_thumb != blank -%}{{ section.settings.tutorial_thumb | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cpdp__video-thumb', alt: 'Tutorial' }}{%- else -%}<div class="cpdp__video-thumb cpdp__video-thumb--ph"></div>{%- endif -%}
            <span class="cpdp__play" aria-label="Play tutorial"><svg viewBox="0 0 24 24" width="26" height="26" fill="#fff"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          {%- if section.settings.tutorial_url != blank -%}</a>{%- endif -%}
        </div>
      </div>

      <div class="cpdp__col-right">
        <div class="cpdp__pills">
          {%- assign pills = section.settings.feature_pills | default: 'Ages 3-8, 45-60 min play, Screen-free, Mess-free' | split: ',' -%}
          {%- assign pcolors = 'y,b,g,p' | split: ',' -%}
          {%- for p in pills -%}
            {%- assign pc = forloop.index0 | modulo: 4 -%}
            <span class="cpdp__pill cpdp__pill--{{ pcolors[pc] }}">{{ p | strip }}</span>
          {%- endfor -%}
        </div>
        <h1 class="cpdp__title">{{ heading_title }}</h1>
        <div class="cpdp__rating">
          <span class="cpdp__stars" aria-hidden="true">★★★★★</span>
          <a href="#cpdp-reviews" class="cpdp__rating-link">{{ section.settings.rating_text | default: '4.9 · 2,148 reviews' }}</a>
          <span class="cpdp__rating-sold">{{ section.settings.sold_text | default: '1,900+ bought this month' }}</span>
        </div>
        {%- if section.settings.short_desc != blank -%}<p class="cpdp__desc">{{ section.settings.short_desc }}</p>{%- elsif product.description != blank -%}<p class="cpdp__desc">{{ product.description | strip_html | truncatewords: 40 }}</p>{%- endif -%}

        <div class="cpdp__buybox">
        {%- if product.variants.size > 1 -%}
        <div class="cpdp__themebox">
          <h3 class="cpdp__themebox-title">Pick a bag theme</h3>
          <div class="cpdp__themegrid" role="radiogroup" aria-label="Pick a bag theme">
            {%- assign theme_map = 'Dinosaur Theme|🦕,Dog Theme|🐶,Princess Theme|👸,Back to School Theme|🎒,Candy Theme|🍬,Animal Theme|🐰' | split: ',' -%}
            {%- assign rendered = '' -%}
            {%- for tm in theme_map -%}
              {%- assign tparts = tm | split: '|' -%}
              {%- assign tname = tparts[0] -%}
              {%- assign tv = product.variants | where: 'title', tname | first -%}
              {%- if tv -%}
                <button type="button" class="cpdp__theme{% if tv.id == cur.id %} is-selected{% endif %}" role="radio" aria-checked="{% if tv.id == cur.id %}true{% else %}false{% endif %}" data-variant-id="{{ tv.id }}"><span class="cpdp__theme-ico">{{ tparts[1] }}</span><span class="cpdp__theme-name">{{ tname }}</span></button>
                {%- assign rendered = rendered | append: tname | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for variant in product.variants -%}
              {%- unless rendered contains variant.title -%}
                <button type="button" class="cpdp__theme{% if variant.id == cur.id %} is-selected{% endif %}" role="radio" aria-checked="{% if variant.id == cur.id %}true{% else %}false{% endif %}" data-variant-id="{{ variant.id }}"><span class="cpdp__theme-ico">🎨</span><span class="cpdp__theme-name">{{ variant.title }}</span></button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
        <div class="cpdp__price">
          <span class="cpdp__price-now" data-price>{{ cur.price | money }}</span>
          {%- if cur.compare_at_price > cur.price -%}<span class="cpdp__price-was" data-compare>{{ cur.compare_at_price | money }}</span><span class="cpdp__price-off" data-off>{{ cur.compare_at_price | minus: cur.price | times: 100 | divided_by: cur.compare_at_price | round }}% off</span>{%- else -%}<span class="cpdp__price-was" data-compare style="display:none"></span><span class="cpdp__price-off" data-off style="display:none"></span>{%- endif -%}
        </div>
        <label class="cpdp__giftwrap"><span class="cpdp__gift-ico">🎁</span><span class="cpdp__gift-body"><b>Add gift wrapping — free</b><em>Kraft paper, ribbon and a handwritten note</em></span><input type="checkbox" name="properties[Gift wrapping]" value="Yes" class="cpdp__gift-check"></label>
        <div class="cpdp__po">
          <h3 class="cpdp__po-title">Choose Purchase Option</h3>
          <div class="cpdp__po-grid">
            {%- assign tiers = '1|2,2|5,4|15' | split: ',' -%}
            {%- for tier in tiers -%}
              {%- assign tp = tier | split: '|' -%}
              {%- assign q = tp[0] | times: 1 -%}
              {%- assign off = tp[1] | times: 1 -%}
              {%- assign base = cur.price | times: q -%}
              {%- assign discount = base | times: off | divided_by: 100 -%}
              {%- assign final = base | minus: discount -%}
              <button type="button" class="cpdp__po-card{% if forloop.first %} is-selected{% endif %}" data-qty="{{ q }}"><span class="cpdp__po-ico">✊</span><span class="cpdp__po-body"><span class="cpdp__po-top">Buy {{ q }} <em>{{ off }}% off</em></span><span class="cpdp__po-price">{{ final | money }} <s>{{ base | money }}</s></span>{% if forloop.last %}<span class="cpdp__po-badge">Smart Saver</span>{% endif %}</span></button>
            {%- endfor -%}
          </div>
        </div>
        <p class="cpdp__ship">{{ section.settings.ship_text | default: 'Order before 4 PM → ships today · COD available' }}</p>
        <input type="hidden" name="id" value="{{ cur.id }}" class="cpdp__var-id">
        <div class="cpdp__buy">
          <div class="cpdp__qty" aria-label="Quantity">
            <button type="button" class="cpdp__qty-btn" data-dir="-1" aria-label="Decrease">−</button>
            <input class="cpdp__qty-val" type="text" name="quantity" inputmode="numeric" value="1" aria-label="Quantity" readonly>
            <button type="button" class="cpdp__qty-btn" data-dir="1" aria-label="Increase">+</button>
          </div>
          <button type="submit" class="cpdp__atc" data-atc{% unless cur.available %} disabled{% endunless %}><span data-atc-label>{% if cur.available %}Add to Cart{% else %}Sold out{% endif %}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <button type="button" class="cpdp__buynow" data-buynow>Buy Now <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cpdp__trust">
          <div class="cpdp__trust-item"><span class="cpdp__trust-ico">🛡️</span><span class="cpdp__trust-t">100% Secure</span><span class="cpdp__trust-s">secure payment</span></div>
          <div class="cpdp__trust-item"><span class="cpdp__trust-ico">🔄</span><span class="cpdp__trust-t">7-day returns</span><span class="cpdp__trust-s">No questions asked</span></div>
          <div class="cpdp__trust-item"><span class="cpdp__trust-ico">🇮🇳</span><span class="cpdp__trust-t">Made in India</span><span class="cpdp__trust-s">By a small team</span></div>
          <div class="cpdp__trust-item"><span class="cpdp__trust-ico">🎁</span><span class="cpdp__trust-t">Gift wrap free</span><span class="cpdp__trust-s">Add a note at checkout</span></div>
        </div>
        {%- if section.settings.safety_text != blank -%}<div class="cpdp__safety"><span class="cpdp__safety-ico">⚠️</span><span class="cpdp__safety-t">{{ section.settings.safety_text }}</span>{%- if section.settings.safety_link != blank -%}<a href="{{ section.settings.safety_link }}" class="cpdp__safety-link">Safety details</a>{%- endif -%}</div>{%- endif -%}
        <div class="cpdp__offers">
          <h3 class="cpdp__offers-title"><span class="cpdp__offers-ico">🏷️</span> Available Offers</h3>
          <div class="cpdp__offers-track">
            {%- assign offers = section.settings.offers | default: 'Get EXTRA 5% Off on First Order|WELCOME5;Get a EXTRA 10% Off on a Cart value of Rs1499|SUMMER10;Get a EXTRA 25% Off on a Cart value of Rs2199|SUMMER20' | split: ';' -%}
            {%- for o in offers -%}
              {%- assign op = o | split: '|' -%}
              <div class="cpdp__offer"><p class="cpdp__offer-text">{{ op[0] | strip }}</p><button type="button" class="cpdp__offer-code" data-code="{{ op[1] | strip }}"><span>Code: {{ op[1] | strip }}</span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
    </form>

    <div class="cpdp__green">
      <div class="cpdp__green-arrow" aria-hidden="true"><svg viewBox="0 0 24 40" width="24" height="40" fill="none" stroke="rgba(255,255,255,.75)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v32M5 27l7 7 7-7"/></svg></div>
      <div class="cpdp__tabs" role="tablist">
        <button type="button" class="cpdp__tab is-active" data-tab="overview" role="tab" aria-selected="true">✦ Overview</button>
        <button type="button" class="cpdp__tab" data-tab="faqs" role="tab" aria-selected="false">❔ FAQs</button>
      </div>
      <div class="cpdp__panel is-active" data-panel="overview">
        <div class="cpdp__panel-grid">
          <div class="cpdp__panel-copy">
            <h2 class="cpdp__panel-title">{{ section.settings.overview_heading | default: 'A blank canvas bag, waiting for their imagination' }}</h2>
            <div class="cpdp__panel-text">{{ product.description | default: 'Add a product description to populate this section.' }}</div>
            <div class="cpdp__feat-grid">
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🎨</span><span class="cpdp__feat-body"><strong>Made for creating</strong><em>Blank cotton canvas + markers</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🧼</span><span class="cpdp__feat-body"><strong>Non-toxic &amp; washable</strong><em>Gentle on hands and clothes</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">💪</span><span class="cpdp__feat-body"><strong>Built to be used</strong><em>Durable everyday tote</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🎉</span><span class="cpdp__feat-body"><strong>Great for groups</strong><em>Perfect for parties &amp; playdates</em></span></div>
            </div>
          </div>
          <div class="cpdp__panel-media">
            {%- if section.settings.overview_image != blank -%}{{ section.settings.overview_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'cpdp__panel-photo', alt: 'Child coloring a bag' }}{%- elsif product.media[1] -%}{{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'cpdp__panel-photo', alt: product.title }}{%- else -%}<div class="cpdp__panel-photo cpdp__panel-photo--ph"></div>{%- endif -%}
            <span class="cpdp__mascot" aria-hidden="true">🐱</span>
          </div>
        </div>
      </div>
      <div class="cpdp__panel" data-panel="faqs">
        <div class="cpdp__faq-card">
          {%- assign faqs = section.settings.faqs | default: 'What age is this kit for?|Designed for kids aged 3–8 with adult supervision for the youngest crafters.;Are the paints safe?|Yes — all paints are non-toxic and washable off skin and clothes.;How long does one bag take?|Most kids finish in 45–60 minutes of happy focused play.;Can the bag be washed after painting?|Absolutely — let it cure for 24 hours then gently hand-wash.' | split: ';' -%}
          {%- for f in faqs -%}
            {%- assign fp = f | split: '|' -%}
            <details class="cpdp__faq"{% if forloop.first %} open{% endif %}><summary class="cpdp__faq-q"><span>{{ fp[0] | strip }}</span><span class="cpdp__faq-chev" aria-hidden="true"></span></summary><p class="cpdp__faq-a">{{ fp[1] | strip }}</p></details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="cpdp__sticky" data-sticky>
    <div class="cpdp__sticky-info">
      <div class="cpdp__sticky-thumb">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ 'product-apparel-1' | placeholder_svg_tag }}{%- endif -%}</div>
      <div class="cpdp__sticky-meta">
        <span class="cpdp__sticky-name">{{ heading_title }}</span>
        <span class="cpdp__sticky-price">{%- if cur.compare_at_price > cur.price -%}<s data-sticky-compare>{{ cur.compare_at_price | money }}</s> {%- endif -%}<b data-sticky-price>{{ cur.price | money }}</b>{%- if cur.compare_at_price > cur.price -%} <em data-sticky-off>{{ cur.compare_at_price | minus: cur.price | times: 100 | divided_by: cur.compare_at_price | round }}% off</em>{%- endif -%}</span>
      </div>
    </div>
    <button type="submit" form="cpdp-form-{{ uid }}" class="cpdp__atc cpdp__atc--sticky"><span data-atc-label>{% if cur.available %}Add to Cart{% else %}Sold out{% endif %}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
  </div>

  <a class="cpdp__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" width="30" height="30" fill="#fff"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/></svg></a>
</section>

<script>
  window.CPDP = window.CPDP || {};
  window.CPDP["{{ uid }}"] = {
    variants: {
      {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        "available": {{ variant.available }},
        "price": {{ variant.price | money | json }},
        "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
        "off": {% if variant.compare_at_price > variant.price %}"{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price | round }}% off"{% else %}null{% endif %},
        "mediaId": {% if variant.featured_media %}"{{ variant.featured_media.id }}"{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  };
</script>

<style>
  #Cpdp-{{ uid }}{
    --cpdp-orange:#F26E21; --cpdp-orange-d:#d95d15;
    --cpdp-yellow:#F7C948; --cpdp-cream:#FBF3D9;
    --cpdp-green:#6EA847; --cpdp-purple:#5A2D8C; --cpdp-brown:#3D2817;
    --cpdp-ink:#4B5563; --cpdp-line:#E7E3DA; --cpdp-radius:22px;
    --cpdp-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdp-body: var(--font-body-family, 'Poppins','Nunito',system-ui,sans-serif);
    font-family:var(--cpdp-body); color:var(--cpdp-brown); position:relative;
  }
  #Cpdp-{{ uid }} *{box-sizing:border-box;}
  #Cpdp-{{ uid }} .cpdp__form{margin:0;}
  #Cpdp-{{ uid }} .cpdp__wrap{max-width:1240px;margin:0 auto;padding:14px 20px 0;overflow-x:hidden;}
  #Cpdp-{{ uid }} .cpdp__crumbs{display:flex;align-items:center;gap:8px;font-size:14px;color:#6b7280;padding:8px 4px 18px;}
  #Cpdp-{{ uid }} .cpdp__crumbs a{color:#6b7280;text-decoration:none;}
  #Cpdp-{{ uid }} .cpdp__crumb-current{color:var(--cpdp-brown);font-weight:700;}
  #Cpdp-{{ uid }} .cpdp__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:44px;align-items:start;}
  #Cpdp-{{ uid }} .cpdp__gallery{position:relative;background:#EFE7F7;border-radius:var(--cpdp-radius);overflow:hidden;aspect-ratio:1/1;}
  #Cpdp-{{ uid }} .cpdp__stage,#Cpdp-{{ uid }} .cpdp__slide{position:absolute;inset:0;}
  #Cpdp-{{ uid }} .cpdp__slide{opacity:0;transition:opacity .3s ease;}
  #Cpdp-{{ uid }} .cpdp__slide.is-active{opacity:1;}
  #Cpdp-{{ uid }} .cpdp__img{width:100%;height:100%;object-fit:cover;display:block;}
  #Cpdp-{{ uid }} .cpdp__img--ph,#Cpdp-{{ uid }} .cpdp__ph-svg{width:100%;height:100%;background:#E7D9F5;}
  #Cpdp-{{ uid }} .cpdp__badges{position:absolute;top:16px;left:16px;z-index:3;display:flex;flex-direction:column;gap:8px;align-items:flex-start;}
  #Cpdp-{{ uid }} .cpdp__badge{font-size:13px;font-weight:700;padding:7px 14px;border-radius:999px;box-shadow:0 4px 10px rgba(0,0,0,.08);}
  #Cpdp-{{ uid }} .cpdp__badge--best{background:var(--cpdp-orange);color:#fff;}
  #Cpdp-{{ uid }} .cpdp__badge--soft{background:#fff;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__expand{position:absolute;top:16px;right:16px;z-index:3;width:40px;height:40px;border:none;border-radius:12px;background:#fff;color:var(--cpdp-brown);display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 10px rgba(0,0,0,.1);}
  #Cpdp-{{ uid }} .cpdp__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;border:none;border-radius:999px;background:#fff;color:var(--cpdp-brown);display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.14);}
  #Cpdp-{{ uid }} .cpdp__nav--prev{left:14px;color:#c9c4bd;}
  #Cpdp-{{ uid }} .cpdp__nav--next{right:14px;color:var(--cpdp-orange);}
  #Cpdp-{{ uid }} .cpdp__thumbs{display:flex;gap:12px;margin-top:14px;overflow-x:auto;padding-bottom:4px;}
  #Cpdp-{{ uid }} .cpdp__thumb{flex:0 0 84px;height:84px;border-radius:14px;border:2px solid var(--cpdp-line);background:#f4f1ec;overflow:hidden;cursor:pointer;padding:0;}
  #Cpdp-{{ uid }} .cpdp__thumb.is-active{border-color:var(--cpdp-orange);}
  #Cpdp-{{ uid }} .cpdp__thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  #Cpdp-{{ uid }} .cpdp__tutorial{margin-top:26px;}
  #Cpdp-{{ uid }} .cpdp__video-link{display:block;text-decoration:none;}
  #Cpdp-{{ uid }} .cpdp__tutorial-title{font-family:var(--cpdp-head);font-size:22px;font-weight:800;margin:0 0 12px;}
  #Cpdp-{{ uid }} .cpdp__video{position:relative;border-radius:18px;overflow:hidden;aspect-ratio:16/10;background:#FBE9E4;}
  #Cpdp-{{ uid }} .cpdp__video-thumb{width:100%;height:100%;object-fit:cover;}
  #Cpdp-{{ uid }} .cpdp__video-thumb--ph{background:linear-gradient(135deg,#FBE0D8,#F6C9Bb);}
