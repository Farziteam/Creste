{%- comment -%}
  Creste — Custom Product Detail Page (PDP) — product-driven
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign wa = section.settings.whatsapp_number | default: '919999999999'
  assign cur = product.selected_or_first_available_variant
  assign heading_title = section.settings.title_override
  if heading_title == blank
    assign heading_title = product.title
  endif
-%}

<section id="Cpdp-{{ uid }}" class="cpdp" data-section-id="{{ uid }}">
  <div class="cpdp__wrap">

    {%- if section.settings.promo_banner_desktop != blank or section.settings.promo_banner_mobile != blank or request.design_mode -%}
      <div class="cpdp__promo-banner">
        {%- if section.settings.promo_banner_link != blank -%}<a href="{{ section.settings.promo_banner_link }}" class="cpdp__promo-link">{%- endif -%}
          {%- if section.settings.promo_banner_desktop != blank -%}
            {{ section.settings.promo_banner_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'cpdp__promo-img cpdp__promo-img--desktop', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdp__promo-img cpdp__promo-img--desktop cpdp__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdp__promo-ph-svg' }}<span class="cpdp__promo-ph-label">Desktop banner — upload in section settings</span></div>
          {%- endif -%}
          {%- if section.settings.promo_banner_mobile != blank -%}
            {{ section.settings.promo_banner_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'cpdp__promo-img cpdp__promo-img--mobile', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdp__promo-img cpdp__promo-img--mobile cpdp__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdp__promo-ph-svg' }}<span class="cpdp__promo-ph-label">Mobile banner — upload in section settings</span></div>
          {%- endif -%}
        {%- if section.settings.promo_banner_link != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}

    <nav class="cpdp__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="cpdp__crumb-sep">›</span>
      <span class="cpdp__crumb-current">{{ heading_title }}</span>
    </nav>

    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="cpdp-form-{{ uid }}" class="cpdp__form">
    <div class="cpdp__hero">

      <div class="cpdp__col-left">
        <div class="cpdp__gallery">
          <div class="cpdp__badges">
            {%- if section.settings.badge_1 != blank -%}<span class="cpdp__badge cpdp__badge--best">{{ section.settings.badge_1 }}</span>{%- endif -%}
            {%- if section.settings.badge_2 != blank -%}<span class="cpdp__badge cpdp__badge--soft">{{ section.settings.badge_2 }}</span>{%- endif -%}
          </div>
          <button type="button" class="cpdp__expand" data-share data-share-url="{{ shop.secure_url }}{{ product.url }}" data-share-title="{{ product.title | escape }}" aria-label="Share"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg></button>
          <div class="cpdp__stage">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="cpdp__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">{{ media | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cpdp__img', alt: media.alt | default: product.title }}</div>
              {%- endfor -%}
            {%- else -%}
              <div class="cpdp__slide is-active" data-index="0"><div class="cpdp__img cpdp__img--ph">{{ 'product-apparel-1' | placeholder_svg_tag: 'cpdp__ph-svg' }}</div></div>
            {%- endif -%}
          </div>
          <button type="button" class="cpdp__nav cpdp__nav--prev" aria-label="Previous image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button type="button" class="cpdp__nav cpdp__nav--next" aria-label="Next image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cpdp__thumbs">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button type="button" class="cpdp__thumb{% if forloop.first %} is-active{% endif %}" data-target="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">{{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="cpdp__tutorial">
          <h3 class="cpdp__tutorial-title">Watch Tutorial</h3>
          {%- if section.settings.tutorial_url != blank -%}<a href="{{ section.settings.tutorial_url }}" target="_blank" rel="noopener" class="cpdp__video-link">{%- endif -%}
          <div class="cpdp__video">
            {%- if section.settings.tutorial_thumb != blank -%}{{ section.settings.tutorial_thumb | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cpdp__video-thumb', alt: 'Tutorial' }}{%- else -%}<div class="cpdp__video-thumb cpdp__video-thumb--ph"></div>{%- endif -%}
            <span class="cpdp__play" aria-label="Play tutorial"><svg viewBox="0 0 24 24" width="26" height="26" fill="#fff"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          {%- if section.settings.tutorial_url != blank -%}</a>{%- endif -%}
        </div>
      </div>

      <div class="cpdp__col-right">
        <div class="cpdp__pills">
          {%- assign pills = section.settings.feature_pills | default: 'Ages 3-8, 45-60 min play, Screen-free, Mess-free' | split: ',' -%}
          {%- assign pcolors = 'y,b,g,p' | split: ',' -%}
          {%- for p in pills -%}
            {%- assign pc = forloop.index0 | modulo: 4 -%}
            <span class="cpdp__pill cpdp__pill--{{ pcolors[pc] }}">{{ p | strip }}</span>
          {%- endfor -%}
        </div>
        <h1 class="cpdp__title">{{ heading_title }}</h1>
        <div class="cpdp__rating">
          <span class="cpdp__stars" aria-hidden="true">★★★★★</span>
          <a href="#cpdp-reviews" class="cpdp__rating-link">{{ section.settings.rating_text | default: '4.9 · 2,148 reviews' }}</a>
          <span class="cpdp__rating-sold">{{ section.settings.sold_text | default: '1,900+ bought this month' }}</span>
        </div>
        {%- if section.settings.short_desc != blank -%}<p class="cpdp__desc">{{ section.settings.short_desc }}</p>{%- elsif product.description != blank -%}<p class="cpdp__desc">{{ product.description | strip_html | truncatewords: 40 }}</p>{%- endif -%}

        <div class="cpdp__buybox">
        {%- if product.variants.size > 1 -%}
        <div class="cpdp__themebox">
          <h3 class="cpdp__themebox-title">Pick a bag theme</h3>
          <div class="cpdp__themegrid" role="radiogroup" aria-label="Pick a bag theme">
            {%- assign theme_map = 'Dinosaur Theme|🦕|Dinosaur,Dog Theme|🐶|Dog,Princess Theme|👸|Princess,Back to School Theme|🎒|Back 2 school,Candy Theme|🍬|Candy,Animal Theme|🐰|Animal' | split: ',' -%}
            {%- assign rendered = '' -%}
            {%- for tm in theme_map -%}
              {%- assign tparts = tm | split: '|' -%}
              {%- assign tname = tparts[0] -%}
              {%- assign tv = product.variants | where: 'title', tname | first -%}
              {%- if tv -%}
                <button type="button" class="cpdp__theme{% if tv.id == cur.id %} is-selected{% endif %}" role="radio" aria-checked="{% if tv.id == cur.id %}true{% else %}false{% endif %}" data-variant-id="{{ tv.id }}"><span class="cpdp__theme-ico">{{ tparts[1] }}</span><span class="cpdp__theme-name">{{ tparts[2] }}<br>Theme</span></button>
                {%- assign rendered = rendered | append: tname | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for variant in product.variants -%}
              {%- unless rendered contains variant.title -%}
                <button type="button" class="cpdp__theme{% if variant.id == cur.id %} is-selected{% endif %}" role="radio" aria-checked="{% if variant.id == cur.id %}true{% else %}false{% endif %}" data-variant-id="{{ variant.id }}"><span class="cpdp__theme-ico">🎨</span><span class="cpdp__theme-name">{{ variant.title }}</span></button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
        <div class="cpdp__hr"></div>
        <div class="cpdp__price">
          <span class="cpdp__price-now" data-price>{{ cur.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span>
          {%- if cur.compare_at_price > cur.price -%}<span class="cpdp__price-was" data-compare>{{ cur.compare_at_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span><span class="cpdp__price-off" data-off>{{ cur.compare_at_price | minus: cur.price | times: 100 | divided_by: cur.compare_at_price | round }}% off</span>{%- else -%}<span class="cpdp__price-was" data-compare style="display:none"></span><span class="cpdp__price-off" data-off style="display:none"></span>{%- endif -%}
        </div>
        <label class="cpdp__giftwrap"><span class="cpdp__gift-ico"><svg viewBox="0 0 40 40" width="30" height="30" aria-hidden="true"><circle cx="11" cy="13" r="2.4" fill="#EC407A"/><circle cx="21" cy="10" r="2" fill="#FF7043"/><circle cx="30" cy="14" r="2.4" fill="#EF5350"/><circle cx="15" cy="22" r="2" fill="#F06292"/><circle cx="25" cy="21" r="2.4" fill="#FF8A65"/><circle cx="31" cy="27" r="2" fill="#EC407A"/><circle cx="11" cy="29" r="2.4" fill="#FF7043"/><circle cx="21" cy="31" r="2" fill="#EF5350"/></svg></span><span class="cpdp__gift-body"><b>Add gift wrapping — free</b><em>Kraft paper, ribbon and a handwritten note</em></span><input type="checkbox" name="properties[Gift wrapping]" value="Yes" class="cpdp__gift-check"></label>
        <div class="cpdp__hr cpdp__hr--blank"></div>
        <div class="cpdp__po">
          <h3 class="cpdp__po-title">Choose Purchase Option</h3>
          <div class="cpdp__po-grid">
            {%- assign tiers = '1|2,2|5,4|15' | split: ',' -%}
            {%- for tier in tiers -%}
              {%- assign tp = tier | split: '|' -%}
              {%- assign q = tp[0] | times: 1 -%}
              {%- assign off = tp[1] | times: 1 -%}
              {%- assign base = cur.price | times: q -%}
              {%- assign discount = base | times: off | divided_by: 100 -%}
              {%- assign final = base | minus: discount -%}
              <button type="button" class="cpdp__po-card{% if forloop.last %} is-selected{% endif %}" data-qty="{{ q }}"><span class="cpdp__po-ico">✊</span><span class="cpdp__po-body"><span class="cpdp__po-top">Buy {{ q }} <em>{{ off }}% off</em></span><span class="cpdp__po-price">{{ final | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }} <s>{{ base | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</s></span></span>{% if forloop.last %}<span class="cpdp__po-badge">Smart Saver</span>{% endif %}</button>
            {%- endfor -%}
          </div>
        </div>
        <div class="cpdp__hr cpdp__hr--blank"></div>
        <p class="cpdp__ship">{{ section.settings.ship_text | default: 'Order before 4 PM → ships today · COD available' }}</p>
        <input type="hidden" name="id" value="{{ cur.id }}" class="cpdp__var-id">
        <div class="cpdp__buy">
          <div class="cpdp__qty" aria-label="Quantity">
            <button type="button" class="cpdp__qty-btn" data-dir="-1" aria-label="Decrease">−</button>
            <input class="cpdp__qty-val" type="text" name="quantity" inputmode="numeric" value="1" aria-label="Quantity" readonly>
            <button type="button" class="cpdp__qty-btn" data-dir="1" aria-label="Increase">+</button>
          </div>
          <button type="submit" class="cpdp__atc" data-atc{% unless cur.available %} disabled{% endunless %}><span data-atc-label>{% if cur.available %}Add to Cart{% else %}Sold out{% endif %}</span></button>
        </div>
        <button type="button" class="cpdp__buynow" data-buynow>Buy Now <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cpdp__trust">
          <div class="cpdp__trust-item cpdp__trust-item--g"><span class="cpdp__trust-ico">{%- if section.settings.trust_icon_1 != blank -%}{{ section.settings.trust_icon_1 | image_url: width: 60 | image_tag: loading: 'lazy', class: 'cpdp__trust-ico-img', alt: '' }}{%- elsif request.design_mode -%}<span class="cpdp__trust-ico-ph" title="Upload icon in section settings"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>{%- else -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#34A853" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>{%- endif -%}</span><span class="cpdp__trust-t">100% Secure</span><span class="cpdp__trust-s">secure payment</span></div>
          <div class="cpdp__trust-item cpdp__trust-item--b"><span class="cpdp__trust-ico">{%- if section.settings.trust_icon_2 != blank -%}{{ section.settings.trust_icon_2 | image_url: width: 60 | image_tag: loading: 'lazy', class: 'cpdp__trust-ico-img', alt: '' }}{%- elsif request.design_mode -%}<span class="cpdp__trust-ico-ph" title="Upload icon in section settings"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>{%- else -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#3B82C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="M15.5 15.2a3 3 0 1 1-.9-3.1"/><path d="M15.6 12.2v2h-2"/></svg>{%- endif -%}</span><span class="cpdp__trust-t">7-day returns</span><span class="cpdp__trust-s">No questions asked</span></div>
          <div class="cpdp__trust-item cpdp__trust-item--a"><span class="cpdp__trust-ico">{%- if section.settings.trust_icon_3 != blank -%}{{ section.settings.trust_icon_3 | image_url: width: 60 | image_tag: loading: 'lazy', class: 'cpdp__trust-ico-img', alt: '' }}{%- elsif request.design_mode -%}<span class="cpdp__trust-ico-ph" title="Upload icon in section settings"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>{%- else -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#E0902A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><path d="M9 13.4L7 22l5-3 5 3-2-8.6"/><circle cx="12" cy="9" r="1.6" fill="#138808" stroke="none"/></svg>{%- endif -%}</span><span class="cpdp__trust-t">Made in India</span><span class="cpdp__trust-s">By a small team</span></div>
          <div class="cpdp__trust-item cpdp__trust-item--p"><span class="cpdp__trust-ico">{%- if section.settings.trust_icon_4 != blank -%}{{ section.settings.trust_icon_4 | image_url: width: 60 | image_tag: loading: 'lazy', class: 'cpdp__trust-ico-img', alt: '' }}{%- elsif request.design_mode -%}<span class="cpdp__trust-ico-ph" title="Upload icon in section settings"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>{%- else -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18M12 8v13"/><path d="M12 8S9.6 8 8.6 6.7 8.7 3.6 10.1 4.4 12 8 12 8zM12 8s2.4 0 3.4-1.3-.1-3.1-1.5-2.3S12 8 12 8z"/></svg>{%- endif -%}</span><span class="cpdp__trust-t">Gift wrap free</span><span class="cpdp__trust-s">Add a note at checkout</span></div>
        </div>
        {%- if section.settings.safety_text != blank -%}<div class="cpdp__safety"><span class="cpdp__safety-ico">⚠️</span><span class="cpdp__safety-t">{{ section.settings.safety_text }}</span>{%- if section.settings.safety_link != blank -%}<a href="{{ section.settings.safety_link }}" class="cpdp__safety-link">Safety details</a>{%- endif -%}</div>{%- endif -%}
        <div class="cpdp__offers">
          <h3 class="cpdp__offers-title"><span class="cpdp__offers-ico">%</span> Available Offers</h3>
          <div class="cpdp__offers-track">
            {%- assign offers = section.settings.offers | default: 'Get EXTRA 5% Off on First Order|WELCOME5;Get a EXTRA 10% Off on a Cart value of Rs1499|SUMMER10;Get a EXTRA 25% Off on a Cart value of Rs2199|SUMMER20' | split: ';' -%}
            {%- for o in offers -%}
              {%- assign op = o | split: '|' -%}
              <div class="cpdp__offer"><p class="cpdp__offer-text">{{ op[0] | strip }}</p><button type="button" class="cpdp__offer-code" data-code="{{ op[1] | strip }}"><span>Code: {{ op[1] | strip }}</span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
    </form>

    <div class="cpdp__green">
      {%- if section.settings.green_banner_desktop != blank or section.settings.green_banner_mobile != blank or request.design_mode -%}
        <div class="cpdp__green-bg">
          {%- if section.settings.green_banner_desktop != blank -%}
            {{ section.settings.green_banner_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'cpdp__green-bg-img cpdp__green-bg-img--desktop', alt: section.settings.green_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdp__green-bg-img cpdp__green-bg-img--desktop cpdp__green-bg-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdp__green-bg-ph-svg' }}<span class="cpdp__green-bg-ph-label">Desktop background — upload in section settings</span></div>
          {%- endif -%}
          {%- if section.settings.green_banner_mobile != blank -%}
            {{ section.settings.green_banner_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'cpdp__green-bg-img cpdp__green-bg-img--mobile', alt: section.settings.green_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdp__green-bg-img cpdp__green-bg-img--mobile cpdp__green-bg-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdp__green-bg-ph-svg' }}<span class="cpdp__green-bg-ph-label">Mobile background — upload in section settings</span></div>
          {%- endif -%}
          <div class="cpdp__green-bg-overlay"></div>
        </div>
      {%- endif -%}
      <div class="cpdp__tabs" role="tablist">
        <button type="button" class="cpdp__tab is-active" data-tab="overview" role="tab" aria-selected="true">✦ Overview</button>
        <button type="button" class="cpdp__tab" data-tab="faqs" role="tab" aria-selected="false">❔ FAQs</button>
      </div>
      <div class="cpdp__panel is-active" data-panel="overview">
        <div class="cpdp__panel-grid">
          <div class="cpdp__panel-copy">
            <h2 class="cpdp__panel-title">{{ section.settings.overview_heading | default: 'A blank canvas bag, waiting for their imagination' }}</h2>
            <div class="cpdp__panel-text">{%- if section.settings.overview_text != blank -%}{{ section.settings.overview_text }}{%- else -%}{{ product.description | strip_html | truncatewords: 60 }}{%- endif -%}</div>
            <div class="cpdp__feat-grid">
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🎨</span><span class="cpdp__feat-body"><strong>Made for creating</strong><em>Blank cotton canvas + 8 markers</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🧼</span><span class="cpdp__feat-body"><strong>Non-toxic &amp; washable</strong><em>Gentle on hands and clothes</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">💪</span><span class="cpdp__feat-body"><strong>Built to be used</strong><em>Roomy enough for books &amp; toys</em></span></div>
              <div class="cpdp__feat"><span class="cpdp__feat-ico">🎉</span><span class="cpdp__feat-body"><strong>Great for groups</strong><em>A hit at parties &amp; playdates</em></span></div>
            </div>
          </div>
          <div class="cpdp__panel-media">
            {%- if section.settings.overview_image != blank -%}{{ section.settings.overview_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'cpdp__panel-photo', alt: 'Child coloring a bag' }}{%- elsif product.media[2] -%}{{ product.media[2] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'cpdp__panel-photo', alt: product.title }}{%- elsif product.media[1] -%}{{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'cpdp__panel-photo', alt: product.title }}{%- else -%}<div class="cpdp__panel-photo cpdp__panel-photo--ph"></div>{%- endif -%}
            <span class="cpdp__mascot" aria-hidden="true">🐱</span>
          </div>
        </div>
      </div>
      <div class="cpdp__panel" data-panel="faqs">
        <div class="cpdp__faq-card">
          {%- assign faqs = section.settings.faqs | default: 'What age is this kit for?|Designed for kids aged 3–8 with adult supervision for the youngest crafters.;Are the paints safe?|Yes — all paints are non-toxic and washable off skin and clothes.;How long does one bag take?|Most kids finish in 45–60 minutes of happy focused play.;Can the bag be washed after painting?|Absolutely — let it cure for 24 hours then gently hand-wash.' | split: ';' -%}
          {%- for f in faqs -%}
            {%- assign fp = f | split: '|' -%}
            <details class="cpdp__faq"{% if forloop.first %} open{% endif %}><summary class="cpdp__faq-q"><span>{{ fp[0] | strip }}</span><span class="cpdp__faq-chev" aria-hidden="true"></span></summary><p class="cpdp__faq-a">{{ fp[1] | strip }}</p></details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="cpdp__sticky" data-sticky>
    <div class="cpdp__sticky-info">
      <div class="cpdp__sticky-thumb">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ 'product-apparel-1' | placeholder_svg_tag }}{%- endif -%}</div>
      <div class="cpdp__sticky-meta">
        <span class="cpdp__sticky-name">{{ heading_title }}</span>
        <span class="cpdp__sticky-price">{%- if cur.compare_at_price > cur.price -%}<s data-sticky-compare>{{ cur.compare_at_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</s> {%- endif -%}<b data-sticky-price>{{ cur.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</b>{%- if cur.compare_at_price > cur.price -%} <em data-sticky-off>{{ cur.compare_at_price | minus: cur.price | times: 100 | divided_by: cur.compare_at_price | round }}% off</em>{%- endif -%}</span>
      </div>
    </div>
    <button type="submit" form="cpdp-form-{{ uid }}" class="cpdp__atc cpdp__atc--sticky"><span data-atc-label>{% if cur.available %}Add to Cart{% else %}Sold out{% endif %}</span></button>
  </div>

  <a class="cpdp__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" width="30" height="30" fill="#fff"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/></svg></a>
</section>

<script>
  window.CPDP = window.CPDP || {};
  window.CPDP["{{ uid }}"] = {
    variants: {
      {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        "available": {{ variant.available }},
        "price": {{ variant.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | json }},
        "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | json }}{% else %}null{% endif %},
        "off": {% if variant.compare_at_price > variant.price %}"{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price | round }}% off"{% else %}null{% endif %},
        "mediaId": {% if variant.featured_media %}"{{ variant.featured_media.id }}"{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  };
</script>

<style>
  #Cpdp-{{ uid }}{
    --cpdp-orange:#F26E21; --cpdp-orange-d:#d95d15;
    --cpdp-yellow:#F7C948; --cpdp-cream:#FBF3D9;
    --cpdp-green:#6EA847; --cpdp-purple:#5A2D8C; --cpdp-brown:#3D2817;
    --cpdp-ink:#4B5563; --cpdp-line:#E7E3DA; --cpdp-radius:22px;
    --cpdp-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdp-body: var(--font-body-family, 'Poppins','Nunito',system-ui,sans-serif);
    font-family:var(--cpdp-body); color:var(--cpdp-brown); position:relative;
  }
  #Cpdp-{{ uid }} *{box-sizing:border-box;}
  #Cpdp-{{ uid }} .cpdp__form{margin:0;}
  #Cpdp-{{ uid }} .cpdp__wrap{max-width:1320px;margin:0 auto;padding:14px 20px 0;overflow-x:clip;}
  #Cpdp-{{ uid }} .cpdp__promo-banner{width:100%;margin:0 0 22px;border-radius:var(--cpdp-radius);overflow:hidden;}
  #Cpdp-{{ uid }} .cpdp__promo-link{display:block;}
  #Cpdp-{{ uid }} .cpdp__promo-img{display:block;width:100%;height:auto;}
  #Cpdp-{{ uid }} .cpdp__promo-img--mobile{display:none;}
  #Cpdp-{{ uid }} .cpdp__promo-ph{position:relative;aspect-ratio:4/1;background:#E7D9F5;display:flex;align-items:center;justify-content:center;}
  #Cpdp-{{ uid }} .cpdp__promo-img--mobile.cpdp__promo-ph{aspect-ratio:3/4;}
  #Cpdp-{{ uid }} .cpdp__promo-ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.45;}
  #Cpdp-{{ uid }} .cpdp__promo-ph-label{position:relative;z-index:1;font-weight:700;font-size:13px;color:var(--cpdp-brown);background:rgba(255,255,255,.9);padding:6px 14px;border-radius:999px;}
  @media (max-width:749px){
    #Cpdp-{{ uid }} .cpdp__promo-img--desktop{display:none;}
    #Cpdp-{{ uid }} .cpdp__promo-img--mobile{display:block;}
  }
  #Cpdp-{{ uid }} .cpdp__col-left{position:sticky;top:20px;align-self:start;}
  #Cpdp-{{ uid }} .cpdp__crumbs{display:flex;align-items:center;gap:8px;font-size:14px;color:#6b7280;padding:8px 4px 18px;}
  #Cpdp-{{ uid }} .cpdp__crumbs a{color:#6b7280;text-decoration:none;}
  #Cpdp-{{ uid }} .cpdp__crumb-current{color:var(--cpdp-brown);font-weight:700;}
  #Cpdp-{{ uid }} .cpdp__hero{display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1fr);gap:36px;align-items:start;}
  #Cpdp-{{ uid }} .cpdp__gallery{position:relative;background:#EFE7F7;border-radius:var(--cpdp-radius);overflow:hidden;aspect-ratio:1/1;}
  #Cpdp-{{ uid }} .cpdp__stage,#Cpdp-{{ uid }} .cpdp__slide{position:absolute;inset:0;}
  #Cpdp-{{ uid }} .cpdp__slide{opacity:0;transition:opacity .3s ease;}
  #Cpdp-{{ uid }} .cpdp__slide.is-active{opacity:1;}
  #Cpdp-{{ uid }} .cpdp__img{width:100%;height:100%;object-fit:cover;display:block;}
  #Cpdp-{{ uid }} .cpdp__img--ph,#Cpdp-{{ uid }} .cpdp__ph-svg{width:100%;height:100%;background:#E7D9F5;}
  #Cpdp-{{ uid }} .cpdp__badges{position:absolute;top:16px;left:16px;z-index:3;display:flex;flex-direction:column;gap:8px;align-items:flex-start;}
  #Cpdp-{{ uid }} .cpdp__badge{font-size:13px;font-weight:700;padding:7px 14px;border-radius:999px;box-shadow:0 4px 10px rgba(0,0,0,.08);}
  #Cpdp-{{ uid }} .cpdp__badge--best{background:var(--cpdp-orange);color:#fff;}
  #Cpdp-{{ uid }} .cpdp__badge--soft{background:#fff;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__expand{position:absolute;top:16px;right:16px;z-index:3;width:40px;height:40px;border:none;border-radius:12px;background:#fff;color:var(--cpdp-brown);display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 10px rgba(0,0,0,.1);}
  #Cpdp-{{ uid }} .cpdp__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;border:none;border-radius:999px;background:#fff;color:var(--cpdp-brown);display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.14);}
  #Cpdp-{{ uid }} .cpdp__nav--prev{left:14px;color:#c9c4bd;}
  #Cpdp-{{ uid }} .cpdp__nav--next{right:14px;color:var(--cpdp-orange);}
  #Cpdp-{{ uid }} .cpdp__thumbs{display:flex;gap:12px;margin-top:14px;overflow-x:auto;padding-bottom:4px;}
  #Cpdp-{{ uid }} .cpdp__thumb{flex:0 0 84px;height:84px;border-radius:14px;border:2px solid var(--cpdp-line);background:#f4f1ec;overflow:hidden;cursor:pointer;padding:0;}
  #Cpdp-{{ uid }} .cpdp__thumb.is-active{border-color:var(--cpdp-orange);}
  #Cpdp-{{ uid }} .cpdp__thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  #Cpdp-{{ uid }} .cpdp__tutorial{margin-top:26px;}
  #Cpdp-{{ uid }} .cpdp__video-link{display:block;text-decoration:none;}
  #Cpdp-{{ uid }} .cpdp__tutorial-title{font-family:var(--cpdp-head);font-size:22px;font-weight:800;margin:0 0 12px;}
  #Cpdp-{{ uid }} .cpdp__video{position:relative;border-radius:18px;overflow:hidden;aspect-ratio:16/10;background:#FBE9E4;}
  #Cpdp-{{ uid }} .cpdp__video-thumb{width:100%;height:100%;object-fit:cover;}
  #Cpdp-{{ uid }} .cpdp__video-thumb--ph{background:linear-gradient(135deg,#FBE0D8,#F6C9Bb);}
  #Cpdp-{{ uid }} .cpdp__play{position:absolute;inset:0;margin:auto;width:74px;height:74px;border-radius:999px;background:rgba(0,0,0,.55);color:#fff;display:grid;place-items:center;}
  #Cpdp-{{ uid }} .cpdp__pills{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px;}
  #Cpdp-{{ uid }} .cpdp__pill{font-size:14px;font-weight:600;padding:8px 16px;border-radius:999px;}
  #Cpdp-{{ uid }} .cpdp__pill--y{background:#FEF3C7;color:#B45309;}
  #Cpdp-{{ uid }} .cpdp__pill--b{background:#DBEAFE;color:#1D4ED8;}
  #Cpdp-{{ uid }} .cpdp__pill--g{background:#DCFCE7;color:#15803D;}
  #Cpdp-{{ uid }} .cpdp__pill--p{background:#FCE7F3;color:#BE185D;}
  #Cpdp-{{ uid }} .cpdp__title{font-family:var(--cpdp-head);font-weight:800;font-size:clamp(32px,3.8vw,54px);line-height:1.08;margin:6px 0 14px;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__rating{display:flex;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:16px;}
  #Cpdp-{{ uid }} .cpdp__stars{color:#F5B301;font-size:20px;letter-spacing:2px;}
  #Cpdp-{{ uid }} .cpdp__rating-link{color:var(--cpdp-brown);font-weight:700;text-decoration:underline;}
  #Cpdp-{{ uid }} .cpdp__rating-sold{color:#16A34A;font-weight:700;}
  #Cpdp-{{ uid }} .cpdp__desc{font-size:18px;line-height:1.55;color:var(--cpdp-ink);margin:0 0 22px;}
  #Cpdp-{{ uid }} .cpdp__buybox{background:#FBF5E3;border-radius:22px;padding:24px;margin-bottom:18px;}
  #Cpdp-{{ uid }} .cpdp__buybox .cpdp__themebox{background:transparent;padding:0;margin-bottom:0;}
  #Cpdp-{{ uid }} .cpdp__themebox-title{font-family:var(--cpdp-body);font-size:18px;font-weight:700;color:var(--cpdp-brown);margin:0 0 14px;}
  #Cpdp-{{ uid }} .cpdp__themegrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;}
  #Cpdp-{{ uid }} .cpdp__theme{display:flex;align-items:center;gap:6px;text-align:left;background:#fff;border:1.5px solid #DBD5C6;border-radius:14px;padding:11px;cursor:pointer;font-family:inherit;transition:border-color .15s,background .15s;}
  #Cpdp-{{ uid }} .cpdp__theme.is-selected{border:2px solid #5FB85A;background:#F4FBF1;}
  #Cpdp-{{ uid }} .cpdp__theme-ico{width:34px;height:34px;flex:0 0 auto;border-radius:0;background:transparent;display:grid;place-items:center;font-size:28px;box-shadow:none;}
  #Cpdp-{{ uid }} .cpdp__theme-name{font-size:13px;font-weight:700;color:var(--cpdp-brown);line-height:1.25;}
  #Cpdp-{{ uid }} .cpdp__hr{border:none;border-top:1px solid #E3D9C2;margin:18px 0;}
  #Cpdp-{{ uid }} .cpdp__hr--blank{border-top-color:transparent;margin:12px 0;}
  #Cpdp-{{ uid }} .cpdp__price{display:flex;align-items:baseline;gap:14px;margin:0;}
  #Cpdp-{{ uid }} .cpdp__price-now{font-family:var(--cpdp-head);font-size:44px;font-weight:800;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__price-was{font-size:20px;color:#9aa0a6;text-decoration:line-through;}
  #Cpdp-{{ uid }} .cpdp__price-off{background:var(--cpdp-yellow);color:#7a5b00;font-weight:700;font-size:14px;padding:5px 12px;border-radius:999px;}
  #Cpdp-{{ uid }} .cpdp__giftwrap{display:flex;align-items:center;gap:14px;background:#DCEDF8;border-radius:18px;padding:16px 18px;cursor:pointer;margin-top:16px;}
  #Cpdp-{{ uid }} .cpdp__gift-ico{width:56px;height:56px;flex:0 0 auto;border-radius:999px;background:#FDE7EE;display:grid;place-items:center;box-shadow:0 2px 6px rgba(0,0,0,.05);}
  #Cpdp-{{ uid }} .cpdp__gift-body{flex:1;display:flex;flex-direction:column;gap:2px;}
  #Cpdp-{{ uid }} .cpdp__gift-body b{font-size:17px;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__gift-body em{font-style:normal;font-size:14px;color:#6b7280;}
  #Cpdp-{{ uid }} .cpdp__gift-check{-webkit-appearance:none;appearance:none;width:28px;height:28px;flex:0 0 auto;border:2px solid #C4D2DC;border-radius:8px;background:#fff;cursor:pointer;position:relative;}
  #Cpdp-{{ uid }} .cpdp__gift-check:checked{background:var(--cpdp-orange);border-color:var(--cpdp-orange);}
  #Cpdp-{{ uid }} .cpdp__gift-check:checked::after{content:"";position:absolute;left:9px;top:4px;width:6px;height:11px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg);}
  #Cpdp-{{ uid }} .cpdp__po-title{font-family:var(--cpdp-body);font-size:17px;font-weight:700;color:var(--cpdp-brown);margin:0 0 12px;}
  #Cpdp-{{ uid }} .cpdp__po-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:0;align-items:start;}
  #Cpdp-{{ uid }} .cpdp__po-card{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:10px;text-align:left;background:#fff;border:1.5px solid #DBD5C6;border-radius:14px;padding:12px;cursor:pointer;font-family:inherit;}
  #Cpdp-{{ uid }} .cpdp__po-card.is-selected{border:2px solid #4CA36A;background:#F1F9F2;}
  #Cpdp-{{ uid }} .cpdp__po-ico{font-size:30px;flex:0 0 auto;}
  #Cpdp-{{ uid }} .cpdp__po-body{flex:1;display:flex;flex-direction:column;gap:3px;min-width:0;}
  #Cpdp-{{ uid }} .cpdp__po-top{display:flex;align-items:center;gap:6px;font-weight:600;font-size:15px;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__po-top em{font-style:normal;background:#4CA36A;color:#fff;font-size:11px;padding:2px 7px;border-radius:6px;}
  #Cpdp-{{ uid }} .cpdp__po-price{display:flex;flex-direction:column;font-weight:800;font-size:16px;color:var(--cpdp-brown);}
  #Cpdp-{{ uid }} .cpdp__po-price s{font-weight:500;font-size:12px;color:#9aa0a6;}
  #Cpdp-{{ uid }} .cpdp__po-badge{flex-basis:100%;margin:8px 0 0;background:#4CA36A;color:#fff;text-align:center;font-size:11px;font-weight:700;padding:6px 10px;border-radius:8px;}
  #Cpdp-{{ uid }} .cpdp__ship{text-align:center;font-size:14px;color:#6b7280;margin:0 0 16px;}
  #Cpdp-{{ uid }} .cpdp__buybox .cpdp__buy{margin-bottom:0;}
  #Cpdp-{{ uid }} .cpdp__buynow{width:100%;border:none;border-radius:999px;background:#4FB0E0;color:#fff;font-family:var(--cpdp-head);font-weight:800;font-size:19px;padding:15px;margin-top:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .15s;}
  #Cpdp-{{ uid }} .cpdp__buynow:hover{background:#3fa0d3;}
  #Cpdp-{{ uid }} .cpdp__buy{display:flex;gap:14px;margin-bottom:24px;align-items:center;}
  #Cpdp-{{ uid }} .cpdp__qty{display:flex;align-items:center;gap:8px;}
  #Cpdp-{{ uid }} .cpdp__qty-btn{width:48px;height:48px;border:1px solid var(--cpdp-line);border-radius:999px;background:#fff;font-size:22px;cursor:pointer;color:var(--cpdp-brown);display:grid;place-items:center;box-shadow:0 2px 6px rgba(0,0,0,.06);}
  #Cpdp-{{ uid }} .cpdp__qty-val{width:26px;border:none;text-align:center;font-size:18px;font-weight:700;color:var(--cpdp-brown);background:transparent;}
  #Cpdp-{{ uid }} .cpdp__atc{flex:1;border:none;border-radius:999px;background:var(--cpdp-orange);color:#fff;font-family:var(--cpdp-head);font-weight:800;font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;transition:background .15s;}
  #Cpdp-{{ uid }} .cpdp__atc:hover{background:var(--cpdp-orange-d);}
  #Cpdp-{{ uid }} .cpdp__atc[disabled]{background:#c7c2ba;cursor:not-allowed;}
  #Cpdp-{{ uid }} .cpdp__trust{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px;}
  #Cpdp-{{ uid }} .cpdp__trust-item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;padding:6px 4px;}
  #Cpdp-{{ uid }} .cpdp__trust-ico{position:relative;display:grid;place-items:center;height:32px;}
  #Cpdp-{{ uid }} .cpdp__trust-ico-img{width:30px;height:30px;object-fit:contain;display:block;}
  #Cpdp-{{ uid }} .cpdp__trust-ico-ph{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;border:1.5px dashed #c9c4bd;color:#9a958c;background:#F8F6F1;}
  #Cpdp-{{ uid }} .cpdp__trust-t{font-weight:700;font-size:14px;color:var(--cpdp-purple);}
  #Cpdp-{{ uid }} .cpdp__trust-s{font-size:12px;color:#8a8f98;}
  #Cpdp-{{ uid }} .cpdp__trust-t,#Cpdp-{{ uid }} .cpdp__trust-s{overflow-wrap:break-word;}
  #Cpdp-{{ uid }} .cpdp__trust-item--g .cpdp__trust-t{color:#16A34A;}
  #Cpdp-{{ uid }} .cpdp__trust-item--b .cpdp__trust-t{color:#2F82C7;}
  #Cpdp-{{ uid }} .cpdp__trust-item--a .cpdp__trust-t{color:#E08A1E;}
  #Cpdp-{{ uid }} .cpdp__trust-item--p .cpdp__trust-t{color:#7C3AED;}
  #Cpdp-{{ uid }} .cpdp__safety{display:flex;align-items:center;gap:10px;background:#FEF6E0;border:1px solid #F4E3B0;border-radius:14px;padding:14px 16px;margin-bottom:18px;}
  #Cpdp-{{ uid }} .cpdp__safety-ico{font-size:18px;}
  #Cpdp-{{ uid }} .cpdp__safety-t{flex:1;font-size:15px;color:#8a6d1f;font-weight:600;}
  #Cpdp-{{ uid }} .cpdp__safety-link{color:var(--cpdp-brown);font-weight:700;text-decoration:underline;white-space:nowrap;}
  #Cpdp-{{ uid }} .cpdp__offers{background:#E9F3FB;border-radius:18px;padding:18px;}
  #Cpdp-{{ uid }} .cpdp__offers-title{display:flex;align-items:center;gap:8px;font-family:var(--cpdp-body);font-size:17px;font-weight:700;color:var(--cpdp-brown);margin:0 0 14px;}
  #Cpdp-{{ uid }} .cpdp__offers-ico{display:inline-grid;place-items:center;width:26px;height:26px;background:#2F82C7;color:#fff;border-radius:8px;font-size:14px;font-weight:800;}
  #Cpdp-{{ uid }} .cpdp__offers-track{display:flex;gap:12px;overflow-x:auto;padding-bottom:12px;scrollbar-width:thin;scrollbar-color:#2F7FBF #CFE3F5;}
  #Cpdp-{{ uid }} .cpdp__offers-track::-webkit-scrollbar{height:7px;}
  #Cpdp-{{ uid }} .cpdp__offers-track::-webkit-scrollbar-track{background:#CFE3F5;border-radius:999px;}
  #Cpdp-{{ uid }} .cpdp__offers-track::-webkit-scrollbar-thumb{background:#2F7FBF;border-radius:999px;}
  #Cpdp-{{ uid }} .cpdp__offer{flex:0 0 240px;background:#fff;border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px;}
  #Cpdp-{{ uid }} .cpdp__offer-text{margin:0;font-size:14px;color:#334155;line-height:1.4;}
  #Cpdp-{{ uid }} .cpdp__offer-code{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px dashed #b9c4cf;border-radius:9px;background:#f8fafc;padding:8px 12px;font-weight:700;font-size:13px;color:#334155;cursor:pointer;}
  #Cpdp-{{ uid }} .cpdp__offer-code.is-copied{border-color:#16A34A;color:#16A34A;}
  #Cpdp-{{ uid }} .cpdp__green{position:relative;margin-top:40px;background:var(--cpdp-green);padding:44px 20px 54px;}
  #Cpdp-{{ uid }} .cpdp__green::before{content:"";position:absolute;top:-12px;left:0;right:0;height:14px;background:radial-gradient(circle at 9px -3px, var(--cpdp-green) 9px, transparent 10px) 0 0/18px 14px repeat-x;}
  #Cpdp-{{ uid }} .cpdp__green::after{content:"";position:absolute;bottom:-12px;left:0;right:0;height:14px;background:radial-gradient(circle at 9px 17px, var(--cpdp-green) 9px, transparent 10px) 0 0/18px 14px repeat-x;}
  #Cpdp-{{ uid }} .cpdp__green-bg{position:absolute;inset:0;overflow:hidden;}
  #Cpdp-{{ uid }} .cpdp__green-bg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #Cpdp-{{ uid }} .cpdp__green-bg-img--mobile{display:none;}
  #Cpdp-{{ uid }} .cpdp__green-bg-ph{background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;}
  #Cpdp-{{ uid }} .cpdp__green-bg-ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.35;}
  #Cpdp-{{ uid }} .cpdp__green-bg-ph-label{position:relative;z-index:1;font-weight:700;font-size:13px;color:var(--cpdp-purple);background:rgba(255,255,255,.9);padding:6px 14px;border-radius:999px;}
