</style>

<script>
  (function(){
    var root = document.getElementById('Cpdp-{{ uid }}');
    if(!root) return;
    var slides = root.querySelectorAll('.cpdp__slide');
    var thumbs = root.querySelectorAll('.cpdp__thumb');
    var cur = 0;
    function show(i){
      if(!slides.length) return;
      cur = (i + slides.length) % slides.length;
      slides.forEach(function(s,idx){ s.classList.toggle('is-active', idx===cur); });
      thumbs.forEach(function(t,idx){ t.classList.toggle('is-active', idx===cur); });
    }
    thumbs.forEach(function(t){ t.addEventListener('click', function(){ show(parseInt(t.dataset.target,10)); }); });
    var prev = root.querySelector('.cpdp__nav--prev');
    var next = root.querySelector('.cpdp__nav--next');
    if(prev) prev.addEventListener('click', function(){ show(cur-1); });
    if(next) next.addEventListener('click', function(){ show(cur+1); });
    root.querySelectorAll('.cpdp__theme').forEach(function(btn){
      btn.addEventListener('click', function(){
        root.querySelectorAll('.cpdp__theme').forEach(function(b){ b.classList.remove('is-selected'); b.setAttribute('aria-checked','false'); });
        btn.classList.add('is-selected'); btn.setAttribute('aria-checked','true');
      });
    });
    var qtyVal = root.querySelector('.cpdp__qty-val');
    root.querySelectorAll('.cpdp__qty-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        var v = parseInt(qtyVal.value,10) || 1;
        v += parseInt(btn.dataset.dir,10);
        if(v < 1) v = 1;
        qtyVal.value = v;
      });
    });
    root.querySelectorAll('.cpdp__tab').forEach(function(tab){
      tab.addEventListener('click', function(){
        var name = tab.dataset.tab;
        root.querySelectorAll('.cpdp__tab').forEach(function(t){ var on = t===tab; t.classList.toggle('is-active',on); t.setAttribute('aria-selected', on?'true':'false'); });
        root.querySelectorAll('.cpdp__panel').forEach(function(p){ p.classList.toggle('is-active', p.dataset.panel===name); });
      });
    });
    root.querySelectorAll('.cpdp__offer-code').forEach(function(btn){
      btn.addEventListener('click', function(){
        var code = btn.dataset.code || '';
        var done = function(){ var lbl = btn.querySelector('span'); var old = lbl.textContent; btn.classList.add('is-copied'); lbl.textContent = 'Copied!'; setTimeout(function(){ lbl.textContent = old; btn.classList.remove('is-copied'); },1400); };
        if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(code).then(done).catch(done); } else { done(); }
      });
    });
    var sticky = root.querySelector('.cpdp__sticky');
    var anchor = root.querySelector('.cpdp__buy');
    if(sticky && anchor && 'IntersectionObserver' in window){
      new IntersectionObserver(function(entries){
        entries.forEach(function(e){ sticky.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0); });
      }, {threshold:0}).observe(anchor);
    } else if(sticky){ sticky.classList.add('is-visible'); }
  })();
</script>

