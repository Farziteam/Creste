<script>
(function () {
var root = document.querySelector('.cr-collection[data-section-id="{{ section.id }}"]');
if (!root) return;
var sortWrap = root.querySelector('.js-cr-sort-wrap');
if (sortWrap) {
var sortBtn = sortWrap.querySelector('.js-cr-sort-btn');
var sortPanel = sortWrap.querySelector('.js-cr-sort-panel');
var closeSort = function () {
sortWrap.classList.remove('is-open');
sortBtn.setAttribute('aria-expanded', 'false');
sortPanel.setAttribute('hidden', '');
};
sortBtn.addEventListener('click', function (e) {
e.stopPropagation();
var open = sortWrap.classList.contains('is-open');
if (open) { closeSort(); }
else {
sortWrap.classList.add('is-open');
sortBtn.setAttribute('aria-expanded', 'true');
sortPanel.removeAttribute('hidden');
}
});
sortPanel.querySelectorAll('.js-cr-sort-opt').forEach(function (opt) {
opt.addEventListener('click', function () {
var url = new URL(window.location.href);
url.searchParams.set('sort_by', opt.getAttribute('data-value'));
url.searchParams.delete('page');
window.location.href = url.toString();
});
});
document.addEventListener('click', function (e) {
if (!sortWrap.contains(e.target)) { closeSort(); }
});
document.addEventListener('keydown', function (e) {
if (e.key === 'Escape') { closeSort(); }
});
}
root.querySelectorAll('.js-cr-price').forEach(function (box) {
var maxI = box.querySelector('.js-cr-max');
var fill = box.querySelector('.js-cr-fill');
if (!maxI) return;
var ceil = parseFloat(box.getAttribute('data-ceil')) || 100;
function paint() {
var b = parseFloat(maxI.value);
var hi = ceil ? (b / ceil) * 100 : 100;
fill.style.left = '0%';
fill.style.width = hi + '%';
}
function apply() {
var url = new URL(window.location.href);
url.searchParams.set(box.getAttribute('data-max-param'), parseFloat(maxI.value));
url.searchParams.delete('page');
window.location.href = url.toString();
}
maxI.addEventListener('input', paint);
maxI.addEventListener('change', apply);
paint();
});
var toggle = root.querySelector('.js-cr-toggle-filters');
var layout = root.querySelector('.cr-layout');
var sidebar = root.querySelector('.cr-sidebar');
if (toggle && layout && sidebar) {
var label = toggle.querySelector('.js-cr-filter-label');
{% comment %} toggle.addEventListener('click', function () {
var open = layout.getAttribute('data-filters') === 'open'; {% endcomment %}
{% comment %} layout.setAttribute('data-filters', open ? 'closed' : 'open');
toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
toggle.classList.toggle('is-active', !open);
if (label) { label.textContent = open ? 'Show Filters' : 'Hide Filters'; }
if (open) { sidebar.setAttribute('hidden', ''); } else { sidebar.removeAttribute('hidden'); } {% endcomment %}
{% comment %} layout.setAttribute('data-filters', open ? 'closed' : 'open');

toggle.setAttribute('aria-expanded', open ? 'false' : 'true');

toggle.classList.toggle('is-active', !open);

if (label) {
    label.textContent = open ? 'Show Filters' : 'Hide Filters';
}

if (open) {
    sidebar.setAttribute('hidden', '');
} else {
    sidebar.removeAttribute('hidden');
} {% endcomment %}

toggle.addEventListener("click", function () {
      console.log("CLICK");
    var isOpen = layout.getAttribute("data-filters") === "open";
     console.log("Before:", layout.getAttribute("data-filters"));
    if (isOpen) {

    // First slide the sidebar out
    sidebar.style.opacity = "0";
    sidebar.style.transform = "translateX(-40px)";

    toggle.setAttribute("aria-expanded","false");
    toggle.classList.remove("is-active");

    if(label) label.textContent = "Show Filters";

    setTimeout(function(){

        layout.setAttribute("data-filters","closed");

        sidebar.style.visibility = "hidden";

        // Reset for next open
        sidebar.style.removeProperty("opacity");
        sidebar.style.removeProperty("transform");

    },450);

    }  else {

    layout.setAttribute("data-filters","open");

    requestAnimationFrame(function(){

        sidebar.style.visibility = "visible";

        // Force the browser to apply visibility first
        requestAnimationFrame(function(){

            sidebar.style.opacity = "1";
            sidebar.style.transform = "translateX(0)";

        });

    });

    toggle.setAttribute("aria-expanded","true");
    toggle.classList.add("is-active");

    if(label) label.textContent = "Hide Filters";
}


});
}
var body = document.body;
function closeSheets() { root.querySelectorAll('.cr-sheet-wrap').forEach(function (w) { w.classList.remove('is-open'); }); body.classList.remove('cr-noscroll'); }
function openSheet(sel) { var w = root.querySelector(sel); if (!w) return; closeSheets(); w.classList.add('is-open'); body.classList.add('cr-noscroll'); }
var openF = root.querySelector('.js-cr-open-filters');
if (openF) openF.addEventListener('click', function () { openSheet('.js-cr-filter-sheet'); });
var openS = root.querySelector('.js-cr-open-sort');
if (openS) openS.addEventListener('click', function () { openSheet('.js-cr-sort-sheet'); });
root.querySelectorAll('.js-cr-sheet-close').forEach(function (b) { b.addEventListener('click', closeSheets); });
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSheets(); });
var sortSheet = root.querySelector('.js-cr-sort-sheet');
if (sortSheet) {
sortSheet.querySelectorAll('.js-cr-msort-opt').forEach(function (o) {
o.addEventListener('click', function () {
sortSheet.querySelectorAll('.js-cr-msort-opt').forEach(function (x) { x.classList.remove('is-active'); });
o.classList.add('is-active');
});
});
var msApply = sortSheet.querySelector('.js-cr-msort-apply');
if (msApply) msApply.addEventListener('click', function () {
var sel = sortSheet.querySelector('.js-cr-msort-opt.is-active');
var url = new URL(window.location.href);
if (sel) url.searchParams.set('sort_by', sel.getAttribute('data-value'));
url.searchParams.delete('page');
window.location.href = url.toString();
});
}
var fSheet = root.querySelector('.js-cr-filter-sheet');
if (fSheet) {
fSheet.querySelectorAll('.js-cr-ftab').forEach(function (t) {
t.addEventListener('click', function () {
var id = t.getAttribute('data-tab');
fSheet.querySelectorAll('.js-cr-ftab').forEach(function (x) { x.classList.toggle('is-active', x === t); });
fSheet.querySelectorAll('.js-cr-fpane').forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-pane') === id); });
});
});
fSheet.querySelectorAll('.js-cr-chip-x').forEach(function (x) {
x.addEventListener('click', function () {
var n = x.getAttribute('data-name'), v = x.getAttribute('data-value');
var cb = fSheet.querySelector('.js-cr-mcheck[data-name="' + n + '"][value="' + v + '"]');
if (cb) cb.checked = false;
var chip = x.closest('.cr-fchip');
if (chip) chip.parentNode.removeChild(chip);
});
});
var mp = fSheet.querySelector('.js-cr-mprice');
if (mp) {
var mmx = mp.querySelector('.js-cr-mmax'), mfl = mp.querySelector('.js-cr-mfill');
var mceil = parseFloat(mp.getAttribute('data-ceil')) || 100;
var mpaint = function () { var b = parseFloat(mmx.value); mfl.style.left = '0%'; mfl.style.width = (mceil ? (b / mceil) * 100 : 100) + '%'; };
mmx.addEventListener('input', mpaint);
mpaint();
}
var mfApply = fSheet.querySelector('.js-cr-mfilter-apply');
if (mfApply) mfApply.addEventListener('click', function () {
var base = fSheet.getAttribute('data-base'), sort = fSheet.getAttribute('data-sort');
var url = new URL(base, window.location.origin);
if (sort) url.searchParams.set('sort_by', sort);
fSheet.querySelectorAll('.js-cr-mcheck:checked').forEach(function (cb) { url.searchParams.append(cb.getAttribute('data-name'), cb.value); });
var mp2 = fSheet.querySelector('.js-cr-mprice');
if (mp2) { var mx = mp2.querySelector('.js-cr-mmax'); if (mx && parseFloat(mx.value) < parseFloat(mx.getAttribute('max'))) url.searchParams.set(mp2.getAttribute('data-max-param'), mx.value); }
window.location.href = url.toString();
});
}
})();
</script>
<script>
/* =========================================
   CRESTE COLLECTION
   AJAX ADD TO CART
   DAWN CART DRAWER
   CART ICON BUBBLE
   ========================================= */

(function () {

  var root = document.querySelector(
    '.cr-collection[data-section-id="{{ section.id }}"]'
  );

  if (!root) return;


  /* =========================================
     COLLECTION ATC FORMS
     ========================================= */

  var forms = root.querySelectorAll('.cr-atc-form');

  if (!forms.length) return;


  forms.forEach(function (form) {

    form.addEventListener('submit', function (event) {

      event.preventDefault();
      event.stopPropagation();


      var button = form.querySelector('button[type="submit"]');

      if (!button) return;


      /* Prevent double click */

      if (button.classList.contains('loading')) {
        return;
      }


      var originalHTML = button.innerHTML;


      button.classList.add('loading');
      button.disabled = true;


      var formData = new FormData(form);


      /* =========================================
         ASK SHOPIFY FOR UPDATED SECTIONS
         ========================================= */

      formData.append(
        'sections',
        'cart-drawer,cart-icon-bubble'
      );

      formData.append(
        'sections_url',
        window.location.pathname
      );


      /* =========================================
         AJAX ADD
         ========================================= */

      fetch(
        window.routes && window.routes.cart_add_url
          ? window.routes.cart_add_url
          : '/cart/add.js',
        {
          method: 'POST',

          headers: {
            'Accept': 'application/json'
          },

          body: formData
        }
      )


      /* =========================================
         RESPONSE
         ========================================= */

      .then(function (response) {

        if (!response.ok) {

          return response.json().then(function (data) {

            throw new Error(
              data.description ||
              data.message ||
              'Add to cart failed'
            );

          });

        }

        return response.json();

      })


      .then(function (response) {

        console.log(
          'CRESTE COLLECTION: Cart AJAX response',
          response
        );


        /* =========================================
           1. UPDATE CART DRAWER
           ========================================= */

        var drawerHTML =
          response.sections &&
          response.sections['cart-drawer'];


        var currentDrawer =
          document.querySelector('cart-drawer');


        if (
          drawerHTML &&
          currentDrawer
        ) {

          var parser =
            new DOMParser();


          var drawerDoc =
            parser.parseFromString(
              drawerHTML,
              'text/html'
            );


          var newDrawer =
            drawerDoc.querySelector(
              'cart-drawer'
            );


          if (newDrawer) {

            /*
             * IMPORTANT:
             *
             * Existing working Favourites
             * code ka same approach.
             */

            var opener = button;


            currentDrawer.replaceWith(
              newDrawer
            );


            /*
             * Browser ko new custom element
             * register/upgrade karne ka chance.
             */

            var updatedDrawer =
              document.querySelector(
                'cart-drawer'
              );


            if (
              updatedDrawer &&
              typeof updatedDrawer.open === 'function'
            ) {

              updatedDrawer.open(
                opener
              );

            }

            else if (updatedDrawer) {

              /*
               * Fallback
               */

              updatedDrawer.classList.remove(
                'is-empty'
              );

              updatedDrawer.classList.add(
                'active'
              );

              updatedDrawer.setAttribute(
                'open',
                ''
              );

            }

          }

        }


        /* =========================================
           2. UPDATE CART ICON BUBBLE
           ========================================= */

        updateCollectionCartBubble(
          response.sections &&
          response.sections['cart-icon-bubble']
        );


        /* =========================================
           3. EXTRA CART COUNT SYNC
           ========================================= */

        syncCollectionCartBubble();

      })


      /* =========================================
         ERROR
         ========================================= */

      .catch(function (error) {

        console.error(
          'CRESTE COLLECTION Cart AJAX Error:',
          error
        );

      })


      /* =========================================
         FINALLY
         ========================================= */

      .finally(function () {

        button.classList.remove(
          'loading'
        );

        button.disabled = false;

        button.innerHTML =
          originalHTML;

      });

    });

  });


  /* =========================================
     UPDATE CART ICON BUBBLE
     ========================================= */

  function updateCollectionCartBubble(
    bubbleHTML
  ) {

    if (!bubbleHTML) {

      console.warn(
        'CRESTE COLLECTION: cart-icon-bubble section missing'
      );

      return;

    }


    var oldBubble =
      document.querySelector(
        '#cart-icon-bubble'
      );


    if (!oldBubble) {

      console.warn(
        'CRESTE COLLECTION: #cart-icon-bubble not found'
      );

      return;

    }


    var parser =
      new DOMParser();


    var bubbleDoc =
      parser.parseFromString(
        bubbleHTML,
        'text/html'
      );


    /*
     * Shopify section wrapper
     */

    var sectionWrapper =
      bubbleDoc.querySelector(
        '[id^="shopify-section"]'
      );


    var newContent;


    if (sectionWrapper) {

      newContent =
        sectionWrapper.innerHTML;

    }

    else {

      newContent =
        bubbleDoc.body.innerHTML;

    }


    if (!newContent) {

      console.warn(
        'CRESTE COLLECTION: Cart bubble HTML empty'
      );

      return;

    }


    /*
     * IMPORTANT:
     *
     * Existing <a id="cart-icon-bubble">
     * ko replace nahi karna.
     *
     * Sirf andar ka HTML update karna hai.
     */

    oldBubble.innerHTML =
      newContent;


    oldBubble.removeAttribute(
      'aria-disabled'
    );

  }


  /* =========================================
     EXTRA CART COUNT SYNC
     ========================================= */

  function syncCollectionCartBubble() {

    fetch(
      (
        window.routes &&
        window.routes.cart_url
      )
        ? window.routes.cart_url + '.js'
        : '/cart.js',
      {
        method: 'GET',

        headers: {
          'Accept': 'application/json'
        },

        cache: 'no-store'
      }
    )

    .then(function (response) {

      if (!response.ok) {

        throw new Error(
          'Cart sync failed'
        );

      }

      return response.json();

    })

    .then(function (cart) {

      var bubble =
        document.querySelector(
          '#cart-icon-bubble'
        );

      if (!bubble) return;


      var quantity =
        Number(
          cart.item_count || 0
        );


      var countBubble =
        bubble.querySelector(
          '.cart-count-bubble'
        );


      /* =========================================
         EMPTY CART
         ========================================= */

      if (quantity <= 0) {

        if (countBubble) {
          countBubble.remove();
        }

        return;

      }


      /* =========================================
         EXISTING BUBBLE
         ========================================= */

      if (countBubble) {

        var countSpans =
          countBubble.querySelectorAll(
            'span'
          );


        if (countSpans.length) {

          countSpans[0].textContent =
            quantity;


          if (countSpans[1]) {

            countSpans[1].textContent =
              quantity + ' items';

          }

        }

        else {

          countBubble.textContent =
            quantity;

        }

        return;

      }


      /* =========================================
         CREATE BUBBLE
         ========================================= */

      var newCountBubble =
        document.createElement('div');


      newCountBubble.className =
        'cart-count-bubble';


      newCountBubble.innerHTML =
        '<span aria-hidden="true">' +
        quantity +
        '</span>' +

        '<span class="visually-hidden">' +
        quantity +
        ' items' +
        '</span>';


      bubble.appendChild(
        newCountBubble
      );

    })

    .catch(function (error) {

      console.warn(
        'CRESTE COLLECTION: Cart bubble sync failed',
        error
      );

    });

  }

})();
</script>

