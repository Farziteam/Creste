{%- comment -%}
============================================================
Creste — Custom Collection Page  (Figma node 782:1650)
Hero banner + horizontal toolbar (Show Filters / Sort /
category pills) + collapsible filter panel + product grid +
promo CTA banner + pagination. Data-driven from products.
============================================================
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Nunito+Sans:wght@700;900&family=Poppins:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap">
{%- liquid
assign ppp = section.settings.products_per_page
assign cols = section.settings.columns_desktop
assign tints = 'rgba(139,92,246,0.10),rgba(255,206,0,0.12),rgba(58,172,204,0.12),rgba(91,173,111,0.12),rgba(244,121,58,0.10),rgba(236,72,153,0.10)' | split: ','
assign hero_title = section.settings.hero_title | default: collection.title
-%}
<section class="cr-collection color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
{%- comment -%} ===== HERO BANNER ===== {%- endcomment -%}
{%- if section.settings.show_hero -%}
<div class="cr-hero">
<div class="cr-hero-inner">
<p class="cr-hero-count">{{ collection.all_products_count }} Products</p>
<h1 class="cr-hero-title">{{ hero_title | escape }}</h1>
{%- if section.settings.hero_subtitle != blank -%}
<p class="cr-hero-sub">{{ section.settings.hero_subtitle | escape }}</p>
{%- elsif collection.description != blank -%}
<p class="cr-hero-sub">{{ collection.description | strip_html | truncatewords: 26 }}</p>
{%- endif -%}
</div>
</div>
{%- endif -%}
<div class="cr-wrap">
{%- comment -%} ===== BREADCRUMB ===== {%- endcomment -%}
<nav class="cr-breadcrumb" aria-label="Breadcrumb">
<a href="{{ routes.root_url }}">Home</a>
<span class="cr-crumb-sep" aria-hidden="true">
<svg width="7" height="12" viewBox="0 0 7 12" fill="none"><path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
</span>
<span class="cr-crumb-current">{{ hero_title | escape }}</span>
</nav>
{%- comment -%} ===== TOOLBAR ===== {%- endcomment -%}
<div class="cr-toolbar">
<div class="cr-toolbar-left">
{%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
<button type="button" class="cr-pill cr-pill--filter js-cr-toggle-filters" aria-expanded="false">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 5h16l-6.4 7.5v5.2l-3.2 1.6v-6.8L4 5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
<span class="js-cr-filter-label">Show Filters</span>
</button>
{%- endif -%}
{%- if section.settings.enable_sorting -%}
{%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
{%- assign current_sort_name = collection.sort_options.first.name -%}
{%- for opt in collection.sort_options -%}{%- if opt.value == current_sort -%}{%- assign current_sort_name = opt.name -%}{%- endif -%}{%- endfor -%}
<div class="cr-sort js-cr-sort-wrap">
<button type="button" class="cr-sort-btn js-cr-sort-btn" aria-haspopup="listbox" aria-expanded="false">
<span class="cr-sort-lead">Sort:</span>
<span class="cr-sort-current">{{ current_sort_name }}</span>
<svg class="cr-sort-caret" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<div class="cr-sort-panel js-cr-sort-panel" role="listbox" hidden>
{%- for opt in collection.sort_options -%}
<button type="button" class="cr-sort-opt {% if opt.value == current_sort %}is-active{% endif %} js-cr-sort-opt" role="option" data-value="{{ opt.value }}" aria-selected="{% if opt.value == current_sort %}true{% else %}false{% endif %}">
<span class="cr-radio" aria-hidden="true"></span>
<span class="cr-sort-opt-label">{{ opt.name }}</span>
</button>
{%- endfor -%}
</div>
</div>
{%- endif -%}
</div>
{%- if section.settings.show_category_pills and section.settings.category_menu != blank -%}
{%- assign cr_cur_url = collection.url -%}
{%- assign cr_all_url = section.settings.all_kits_link | default: '/collections/frontpage' -%}
{%- assign cr_cat_matched = false -%}
{%- for link in linklists[section.settings.category_menu].links -%}
{%- if link.url == cr_cur_url -%}{%- assign cr_cat_matched = true -%}{%- endif -%}
{%- endfor -%}
<div class="cr-cats">
<a class="cr-pill {% unless cr_cat_matched %}is-active{% endunless %}" href="{{ cr_all_url }}">All Kits</a>
{%- assign cr_cat_done = false -%}
{%- for link in linklists[section.settings.category_menu].links -%}
<a class="cr-pill {% if link.url == cr_cur_url and cr_cat_done == false %}is-active{%- assign cr_cat_done = true -%}{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
{%- endfor -%}
</div>
{%- endif -%}
</div>
<div class="cr-layout" data-filters="closed">
{%- comment -%} ===== COLLAPSIBLE FILTER SIDEBAR ===== {%- endcomment -%}
{%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
<aside class="cr-sidebar" hidden>
<form id="CrFacetForm" class="cr-facets">
<div class="cr-facets-head">
<span class="cr-facets-title">Filters</span>
<a class="cr-clear" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">Clear all</a>
</div>
{%- assign active_count = 0 -%}
{%- for f in collection.filters -%}{%- assign active_count = active_count | plus: f.active_values.size -%}{%- endfor -%}
{%- if active_count > 0 -%}
<div class="cr-chips">
{%- for f in collection.filters -%}
{%- for v in f.active_values -%}
<a class="cr-chip" href="{{ v.url_to_remove }}">
<span>{{ v.label | escape }}</span>
<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
</a>
{%- endfor -%}
{%- endfor -%}
</div>
{%- endif -%}
{%- for f in collection.filters -%}
<details class="cr-facet" open>
<summary class="cr-facet-summary">
<span>{{ f.label | escape }}</span>
<svg class="cr-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</summary>
<div class="cr-facet-body">
{%- case f.type -%}
{%- when 'list', 'boolean' -%}
<ul class="cr-options" role="list">
{%- for v in f.values -%}
<li>
<a class="cr-opt {% if v.active %}is-active{% endif %} {% if v.count == 0 and v.active == false %}is-disabled{% endif %}"
href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}">
<span class="cr-box" aria-hidden="true">
<svg viewBox="0 0 16 16" fill="none"><circle cx="5.8" cy="6.4" r="0.95" fill="#fff"/><circle cx="10.2" cy="6.4" r="0.95" fill="#fff"/><path d="M4.9 9.5c.9 1.6 2.2 2.4 3.1 2.4s2.2-.8 3.1-2.4" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></svg>
</span>
<span class="cr-opt-label">{{ v.label | escape }}</span>
{%- if v.count and v.count > 0 -%}<span class="cr-opt-count">{{ v.count }}</span>{%- endif -%}
</a>
</li>
{%- endfor -%}
</ul>
{%- when 'price_range' -%}
{%- assign pr_max = f.range_max | money_without_currency | replace: ',', '' | split: '.' | first -%}
{%- assign pr_cur_max = pr_max -%}
{%- if f.max_value.value -%}{%- assign pr_cur_max = f.max_value.value | money_without_currency | replace: ',', '' | split: '.' | first -%}{%- endif -%}
<div class="cr-price js-cr-price" data-max-param="{{ f.max_value.param_name }}" data-ceil="{{ pr_max }}">
<div class="cr-slider">
<div class="cr-slider-rail"></div>
<div class="cr-slider-fill js-cr-fill"></div>
<input type="range" class="cr-slider-h js-cr-max" min="0" max="{{ pr_max }}" step="1" value="{{ pr_cur_max }}" aria-label="Maximum price">
</div>
</div>
{%- endcase -%}
</div>
</details>
{%- endfor -%}
{%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
</form>
</aside>
{%- endif -%}
{%- comment -%} ===== PRODUCT GRID ===== {%- endcomment -%}
<div class="cr-main">
{%- paginate collection.products by ppp -%}
{%- if collection.products.size == 0 -%}
<div class="cr-empty">
<p>No products found. Try clearing a filter.</p>
<a class="cr-atc" style="max-width:220px;margin:12px auto 0;" href="{{ collection.url }}">Clear filters</a>
</div>
{%- else -%}
<ul class="cr-grid" style="--cr-cols: {{ cols }};" role="list">
{%- for product in collection.products -%}
{%- liquid
assign tint_index = forloop.index0 | modulo: tints.size
assign tint = tints[tint_index]
assign rating_num = product.metafields.reviews.rating.value.rating
assign rating_out = ''
if rating_num != blank and rating_num > 0
assign rating_out = rating_num | round: 1
endif
assign age_label = ''
for t in product.tags
assign tl = t | downcase
if tl contains 'year' or tl contains 'yrs'
assign age_label = t
break
endif
endfor
assign skill_label = ''
for t in product.tags
assign tl = t | downcase
if tl contains '&' or tl contains 'skill' or tl contains 'build' or tl contains 'paint' or tl contains 'art' or tl contains 'science' or tl contains 'craft' or tl contains 'creat'
assign skill_label = t
break
endif
endfor
assign is_top = false
if product.tags contains 'top-pick' or product.tags contains 'Top Pick' or product.tags contains 'bestseller' or product.tags contains 'Bestseller'
assign is_top = true
elsif section.settings.badge_by_rating and rating_num != blank and rating_num >= 4.5
assign is_top = true
endif
assign on_sale = false
if product.compare_at_price > product.price
assign on_sale = true
assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
endif
assign img_alt = product.featured_media.alt | default: product.title | escape
-%}
<li class="cr-card-cell">
<div class="cr-card">
<a class="cr-card-media" href="{{ product.url }}" style="--tint: {{ tint }};">
{%- if product.featured_media -%}
{{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width:990px) 300px, 45vw', widths: '200,300,400,600', class: 'cr-card-img', alt: img_alt }}
{%- else -%}
{{ 'product-apparel-1' | placeholder_svg_tag: 'cr-card-img cr-placeholder' }}
{%- endif -%}
</a>
<div class="cr-card-body">
<div class="cr-card-top">
{%- if rating_out != blank -%}
<span class="cr-rating">
<svg width="12" height="12" viewBox="0 0 24 24" fill="#f5b301"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z"/></svg>
{{ rating_out }}
</span>
{%- else -%}<span></span>{%- endif -%}
{%- if is_top -%}
<span class="cr-badge">
<svg width="11" height="11" viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z"/></svg>
TOP PICK
</span>
{%- endif -%}
</div>
<a class="cr-card-title" href="{{ product.url }}">{{ product.title | escape }}</a>
{%- if age_label != blank or skill_label != blank -%}
<p class="cr-card-meta">
{%- if age_label != blank -%}AGES {{ age_label | remove: 'years' | remove: 'year' | remove: 'yrs' | strip }}{%- endif -%}
{%- if age_label != blank and skill_label != blank -%} • {% endif -%}
{%- if skill_label != blank -%}{{ skill_label }}{%- endif -%}
</p>
{%- endif -%}
<div class="cr-price-row">
<span class="cr-price-now">{{ product.price | money }}</span>
{%- if on_sale -%}
<span class="cr-price-was">{{ product.compare_at_price | money }}</span>
<span class="cr-price-off">{{ pct }}% off</span>
{%- endif -%}
</div>
{%- if section.settings.show_add_to_cart -%}
{%- assign first_available = product.selected_or_first_available_variant -%}
{%- if product.available and first_available -%}
<product-form class="cr-atc-wrap">
{%- form 'product', product, id: null, class: 'cr-atc-form', novalidate: 'novalidate' -%}
<input type="hidden" name="id" value="{{ first_available.id }}">
<button type="submit" name="add" class="cr-atc">
<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M3 3h2l2.4 12.3a2 2 0 002 1.7h7.7a2 2 0 002-1.6L21 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor"/><circle cx="17.5" cy="20" r="1.4" fill="currentColor"/></svg>
Add To Cart
</button>
{%- endform -%}
</product-form>
{%- else -%}
<a class="cr-atc is-sold" href="{{ product.url }}">Sold out</a>
{%- endif -%}
{%- endif -%}
</div>
</div>
</li>
{%- endfor -%}
</ul>
{%- if paginate.pages > 1 -%}
<nav class="cr-pagination" aria-label="Pagination">
{%- if paginate.previous -%}<a class="cr-page cr-page-arrow" href="{{ paginate.previous.url }}" aria-label="Previous">‹</a>{%- endif -%}
{%- for part in paginate.parts -%}
{%- if part.is_link -%}<a class="cr-page" href="{{ part.url }}">{{ part.title }}</a>
{%- elsif part.title == paginate.current_page -%}<span class="cr-page is-current" aria-current="page">{{ part.title }}</span>
{%- else -%}<span class="cr-page cr-page-gap">{{ part.title }}</span>{%- endif -%}
{%- endfor -%}
{%- if paginate.next -%}<a class="cr-page cr-page-arrow" href="{{ paginate.next.url }}" aria-label="Next">›</a>{%- endif -%}
</nav>
{%- endif -%}
{%- endif -%}
{%- endpaginate -%}
</div>
</div>
</div>
{%- comment -%} ===== PROMO CTA BANNER ===== {%- endcomment -%}
{%- if section.settings.show_promo -%}
<div class="cr-promo" style="--promo-bg: {{ section.settings.promo_bg }};">
<div class="cr-promo-left">
<div class="cr-promo-ic">
{%- if section.settings.promo_image != blank -%}{{ section.settings.promo_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
{%- else -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="3.6" r="1" fill="#fff"/><path d="M12 4.6v3" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/><path d="M6.5 13v-1.2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2V13" stroke="#fff" stroke-width="1.3" stroke-linejoin="round"/><rect x="4.5" y="13" width="15" height="6.5" rx="1.5" stroke="#fff" stroke-width="1.3"/><path d="M4.5 16c1.1 0 1.1 1 2.2 1s1.1-1 2.2-1 1.1 1 2.2 1 1.1-1 2.2-1 1.1 1 2.2 1 1.1-1 2.2-1" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></svg>{%- endif -%}
</div>
<div>
<p class="cr-promo-title">{{ section.settings.promo_title | escape }}</p>
{%- if section.settings.promo_text != blank -%}<p class="cr-promo-text">{{ section.settings.promo_text | escape }}</p>{%- endif -%}
</div>
</div>
{%- if section.settings.promo_button_label != blank -%}
<a class="cr-promo-btn" href="{{ section.settings.promo_button_link | default: '#' }}">{{ section.settings.promo_button_label | escape }}</a>
{%- endif -%}
</div>
{%- endif -%}
{%- comment -%} ===== MOBILE FILTER / SORT BAR + SHEETS ===== {%- endcomment -%}
{%- if section.settings.enable_sorting or section.settings.enable_filtering -%}
{%- assign cr_base = collection.url -%}
{%- assign cr_sort_val = collection.sort_by | default: collection.default_sort_by -%}
<div class="cr-mbar">
{%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
<button type="button" class="cr-mbar-btn cr-mbar-filter js-cr-open-filters">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 5h16l-6.4 7.5v5.2l-3.2 1.6v-6.8L4 5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
Show Filters
</button>
{%- endif -%}
{%- if section.settings.enable_sorting -%}
<button type="button" class="cr-mbar-btn cr-mbar-sort js-cr-open-sort">Sort: {{ current_sort_name | default: 'Best Selling' }}</button>
{%- endif -%}
</div>
{%- if section.settings.enable_sorting -%}
<div class="cr-sheet-wrap js-cr-sort-sheet">
<div class="cr-sheet-overlay js-cr-sheet-close"></div>
<div class="cr-sheet" role="dialog" aria-modal="true" aria-label="Sort by">
<div class="cr-sheet-head">
<button type="button" class="cr-sheet-x js-cr-sheet-close" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
<span class="cr-sheet-title">Sort By</span>
</div>
<div class="cr-sheet-body">
<ul class="cr-msort">
{%- for opt in collection.sort_options -%}
<li><button type="button" class="cr-msort-opt {% if opt.value == cr_sort_val %}is-active{% endif %} js-cr-msort-opt" data-value="{{ opt.value }}"><span>{{ opt.name }}</span><span class="cr-mradio" aria-hidden="true"></span></button></li>
{%- endfor -%}
</ul>
</div>
<div class="cr-sheet-foot">
<a class="cr-sheet-clear cr-clr-green" href="{{ cr_base }}">Clear All</a>
<button type="button" class="cr-sheet-apply cr-apply-green js-cr-msort-apply">Apply</button>
</div>
</div>
</div>
{%- endif -%}
{%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
<div class="cr-sheet-wrap js-cr-filter-sheet" data-base="{{ cr_base }}" data-sort="{{ cr_sort_val }}">
<div class="cr-sheet-overlay js-cr-sheet-close"></div>
<div class="cr-sheet cr-sheet--filters" role="dialog" aria-modal="true" aria-label="Filters">
<div class="cr-sheet-head">
<button type="button" class="cr-sheet-x js-cr-sheet-close" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
<span class="cr-sheet-title">Filters</span>
</div>
<div class="cr-fsheet">
<div class="cr-ftabs" role="tablist">
{%- for f in collection.filters -%}
<button type="button" class="cr-ftab {% if forloop.first %}is-active{% endif %} js-cr-ftab" data-tab="{{ forloop.index0 }}">{{ f.label | escape }}</button>
{%- endfor -%}
</div>
<div class="cr-fpanes">
{%- for f in collection.filters -%}
<div class="cr-fpane {% if forloop.first %}is-active{% endif %} js-cr-fpane" data-pane="{{ forloop.index0 }}">
{%- case f.type -%}
{%- when 'list', 'boolean' -%}
<ul class="cr-mopts">
{%- for v in f.values -%}
<li><label class="cr-mopt {% if v.count == 0 and v.active == false %}is-disabled{% endif %}"><span class="cr-mopt-label">{{ v.label | escape }}</span><input type="checkbox" class="cr-mcheck js-cr-mcheck" data-name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %}><span class="cr-mbox"><svg viewBox="0 0 16 16" fill="none"><circle cx="5.8" cy="6.4" r="0.95" fill="#fff"/><circle cx="10.2" cy="6.4" r="0.95" fill="#fff"/><path d="M4.9 9.5c.9 1.6 2.2 2.4 3.1 2.4s2.2-.8 3.1-2.4" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></svg></span></label></li>
{%- endfor -%}
</ul>
{%- when 'price_range' -%}
{%- assign mpr_max = f.range_max | money_without_currency | replace: ',', '' | split: '.' | first -%}
{%- assign mpr_cur = mpr_max -%}
{%- if f.max_value.value -%}{%- assign mpr_cur = f.max_value.value | money_without_currency | replace: ',', '' | split: '.' | first -%}{%- endif -%}
<div class="cr-price js-cr-mprice" data-max-param="{{ f.max_value.param_name }}" data-ceil="{{ mpr_max }}">
<div class="cr-slider"><div class="cr-slider-rail"></div><div class="cr-slider-fill js-cr-mfill"></div><input type="range" class="cr-slider-h js-cr-mmax" min="0" max="{{ mpr_max }}" step="1" value="{{ mpr_cur }}" aria-label="Maximum price"></div>
</div>
{%- endcase -%}
</div>
{%- endfor -%}
</div>
</div>
<div class="cr-fchips">
{%- for f in collection.filters -%}{%- for v in f.active_values -%}
<span class="cr-fchip"><span>{{ v.label | escape }}</span><button type="button" class="js-cr-chip-x" data-name="{{ v.param_name }}" data-value="{{ v.value }}" aria-label="Remove">✕</button></span>
{%- endfor -%}{%- endfor -%}
</div>
<div class="cr-sheet-foot">
<a class="cr-sheet-clear cr-clr-orange" href="{{ cr_base }}">Clear All</a>
<button type="button" class="cr-sheet-apply cr-apply-orange js-cr-mfilter-apply">Apply</button>
</div>
</div>
</div>
{%- endif -%}
{%- endif -%}
</section>
<script>
(function () {
var root = document.querySelector('.cr-collection[data-section-id="{{ section.id }}"]');
if (!root) return;
var sortWrap = root.querySelector('.js-cr-sort-wrap');
if (sortWrap) {
var sortBtn = sortWrap.querySelector('.js-cr-sort-btn');
var sortPanel = sortWrap.querySelector('.js-cr-sort-panel');
var closeSort = function () {
sortWrap.classList.remove('is-open');
sortBtn.setAttribute('aria-expanded', 'false');
sortPanel.setAttribute('hidden', '');
};
sortBtn.addEventListener('click', function (e) {
e.stopPropagation();
var open = sortWrap.classList.contains('is-open');
if (open) { closeSort(); }
else {
sortWrap.classList.add('is-open');
sortBtn.setAttribute('aria-expanded', 'true');
sortPanel.removeAttribute('hidden');
}
});
sortPanel.querySelectorAll('.js-cr-sort-opt').forEach(function (opt) {
opt.addEventListener('click', function () {
var url = new URL(window.location.href);
url.searchParams.set('sort_by', opt.getAttribute('data-value'));
url.searchParams.delete('page');
window.location.href = url.toString();
});
});
document.addEventListener('click', function (e) {
if (!sortWrap.contains(e.target)) { closeSort(); }
});
document.addEventListener('keydown', function (e) {
if (e.key === 'Escape') { closeSort(); }
});
}
root.querySelectorAll('.js-cr-price').forEach(function (box) {
var maxI = box.querySelector('.js-cr-max');
var fill = box.querySelector('.js-cr-fill');
if (!maxI) return;
var ceil = parseFloat(box.getAttribute('data-ceil')) || 100;
function paint() {
var b = parseFloat(maxI.value);
var hi = ceil ? (b / ceil) * 100 : 100;
fill.style.left = '0%';
fill.style.width = hi + '%';
}
function apply() {
var url = new URL(window.location.href);
url.searchParams.set(box.getAttribute('data-max-param'), parseFloat(maxI.value));
url.searchParams.delete('page');
window.location.href = url.toString();
}
maxI.addEventListener('input', paint);
maxI.addEventListener('change', apply);
paint();
});
var toggle = root.querySelector('.js-cr-toggle-filters');
var layout = root.querySelector('.cr-layout');
var sidebar = root.querySelector('.cr-sidebar');
if (toggle && layout && sidebar) {
var label = toggle.querySelector('.js-cr-filter-label');
toggle.addEventListener('click', function () {
var open = layout.getAttribute('data-filters') === 'open';
layout.setAttribute('data-filters', open ? 'closed' : 'open');
toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
toggle.classList.toggle('is-active', !open);
if (label) { label.textContent = open ? 'Show Filters' : 'Hide Filters'; }
if (open) { sidebar.setAttribute('hidden', ''); } else { sidebar.removeAttribute('hidden'); }
});
}
var body = document.body;
function closeSheets() { root.querySelectorAll('.cr-sheet-wrap').forEach(function (w) { w.classList.remove('is-open'); }); body.classList.remove('cr-noscroll'); }
function openSheet(sel) { var w = root.querySelector(sel); if (!w) return; closeSheets(); w.classList.add('is-open'); body.classList.add('cr-noscroll'); }
var openF = root.querySelector('.js-cr-open-filters');
if (openF) openF.addEventListener('click', function () { openSheet('.js-cr-filter-sheet'); });
var openS = root.querySelector('.js-cr-open-sort');
if (openS) openS.addEventListener('click', function () { openSheet('.js-cr-sort-sheet'); });
root.querySelectorAll('.js-cr-sheet-close').forEach(function (b) { b.addEventListener('click', closeSheets); });
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSheets(); });
var sortSheet = root.querySelector('.js-cr-sort-sheet');
if (sortSheet) {
sortSheet.querySelectorAll('.js-cr-msort-opt').forEach(function (o) {
o.addEventListener('click', function () {
sortSheet.querySelectorAll('.js-cr-msort-opt').forEach(function (x) { x.classList.remove('is-active'); });
o.classList.add('is-active');
});
});
var msApply = sortSheet.querySelector('.js-cr-msort-apply');
if (msApply) msApply.addEventListener('click', function () {
var sel = sortSheet.querySelector('.js-cr-msort-opt.is-active');
var url = new URL(window.location.href);
if (sel) url.searchParams.set('sort_by', sel.getAttribute('data-value'));
url.searchParams.delete('page');
window.location.href = url.toString();
});
}
var fSheet = root.querySelector('.js-cr-filter-sheet');
if (fSheet) {
fSheet.querySelectorAll('.js-cr-ftab').forEach(function (t) {
t.addEventListener('click', function () {
var id = t.getAttribute('data-tab');
fSheet.querySelectorAll('.js-cr-ftab').forEach(function (x) { x.classList.toggle('is-active', x === t); });
fSheet.querySelectorAll('.js-cr-fpane').forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-pane') === id); });
});
});
fSheet.querySelectorAll('.js-cr-chip-x').forEach(function (x) {
x.addEventListener('click', function () {
var n = x.getAttribute('data-name'), v = x.getAttribute('data-value');
var cb = fSheet.querySelector('.js-cr-mcheck[data-name="' + n + '"][value="' + v + '"]');
if (cb) cb.checked = false;
var chip = x.closest('.cr-fchip');
if (chip) chip.parentNode.removeChild(chip);
});
});
var mp = fSheet.querySelector('.js-cr-mprice');
if (mp) {
var mmx = mp.querySelector('.js-cr-mmax'), mfl = mp.querySelector('.js-cr-mfill');
var mceil = parseFloat(mp.getAttribute('data-ceil')) || 100;
var mpaint = function () { var b = parseFloat(mmx.value); mfl.style.left = '0%'; mfl.style.width = (mceil ? (b / mceil) * 100 : 100) + '%'; };
mmx.addEventListener('input', mpaint);
mpaint();
}
var mfApply = fSheet.querySelector('.js-cr-mfilter-apply');
if (mfApply) mfApply.addEventListener('click', function () {
var base = fSheet.getAttribute('data-base'), sort = fSheet.getAttribute('data-sort');
var url = new URL(base, window.location.origin);
if (sort) url.searchParams.set('sort_by', sort);
fSheet.querySelectorAll('.js-cr-mcheck:checked').forEach(function (cb) { url.searchParams.append(cb.getAttribute('data-name'), cb.value); });
var mp2 = fSheet.querySelector('.js-cr-mprice');
if (mp2) { var mx = mp2.querySelector('.js-cr-mmax'); if (mx && parseFloat(mx.value) < parseFloat(mx.getAttribute('max'))) url.searchParams.set(mp2.getAttribute('data-max-param'), mx.value); }
window.location.href = url.toString();
});
}
})();
</script>
