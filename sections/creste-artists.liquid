{%- comment -%}
  Creste — "Made by Little Artists" gallery (Figma masonry).
  5 columns: cols 1,3,5 are single tall images (video, play button);
  cols 2,4 are two stacked photos. Uses blocks if added, else product media.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
-%}

<section id="CpdpArt-{{ uid }}" class="cpdpa">
  <div class="cpdpa__wrap">
    <h2 class="cpdpa__title">{{ section.settings.heading_prefix | default: 'Made by' }} <span class="cpdpa__hl">{{ section.settings.heading_highlight | default: 'Little Artists' }}</span></h2>
    {%- if section.settings.subheading != blank -%}<p class="cpdpa__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- assign layout = 'tall,pair,tall,pair,tall' | split: ',' -%}
    {%- assign idx = 0 -%}
    <div class="cpdpa__grid">
      {%- for coltype in layout -%}
        <div class="cpdpa__col">
          {% comment %} {%- if coltype == 'tall' -%}
            {%- assign vurl = section.blocks[idx].settings.video_url -%}
            <div class="cpdpa__item cpdpa__item--tall">
              {%- if section.blocks[idx].settings.image != blank -%}{{ section.blocks[idx].settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}{%- elsif request.design_mode -%}<div class="cpdpa__ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}<span class="cpdpa__ph-label">Upload photo or video — set in block settings</span></div>{%- elsif product.media[idx] -%}{{ product.media[idx] | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{%- else -%}<span class="cpdpa__img--ph"></span>{%- endif -%}
              {%- if vurl != blank -%}<a class="cpdpa__play" href="{{ vurl }}" target="_blank" rel="noopener" aria-label="Play video"><svg viewBox="0 0 24 24" width="22" height="22" fill="#F26E21"><path d="M8 5v14l11-7z"/></svg></a>{%- else -%}<span class="cpdpa__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="#F26E21"><path d="M8 5v14l11-7z"/></svg></span>{%- endif -%}
            </div>
            {%- assign idx = idx | plus: 1 -%}
          {%- else -%}
            <div class="cpdpa__item cpdpa__item--half">
              {%- if section.blocks[idx].settings.image != blank -%}{{ section.blocks[idx].settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- elsif request.design_mode -%}<div class="cpdpa__ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}<span class="cpdpa__ph-label">Upload photo — set in block settings</span></div>{%- elsif product.media[idx] -%}{{ product.media[idx] | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{%- else -%}<span class="cpdpa__img--ph"></span>{%- endif -%}
            </div>
            {%- assign idx = idx | plus: 1 -%}
            <div class="cpdpa__item cpdpa__item--half">
              {%- if section.blocks[idx].settings.image != blank -%}{{ section.blocks[idx].settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- elsif request.design_mode -%}<div class="cpdpa__ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}<span class="cpdpa__ph-label">Upload photo — set in block settings</span></div>{%- elsif product.media[idx] -%}{{ product.media[idx] | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{%- else -%}<span class="cpdpa__img--ph"></span>{%- endif -%}
            </div>
            {%- assign idx = idx | plus: 1 -%}
          {%- endif -%} {% endcomment %}
           {%- if coltype == 'tall' -%}

            {%- assign block = section.blocks[idx] -%}
            {%- assign video = block.settings.video -%}

            <div class="cpdpa__item cpdpa__item--tall">

              {%- if video != blank -%}

                <div class="cpdpa__video" data-video-container>

                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 700
                      | image_tag: loading: 'lazy', alt: ''
                    }}

                  {%- elsif video.preview_image != blank -%}
                    {{
                      video.preview_image
                      | image_url: width: 700
                      | image_tag: loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}

                  {%- assign video_source = video.sources | first -%}

                  <button
                    type="button"
                    class="cpdpa__play"
                    aria-label="Play video"
                    data-video-src="{{ video_source.url }}"
                    data-video-type="{{ video_source.mime_type }}"
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="#F26E21">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>

                </div>

              {%- elsif block.settings.image != blank -%}

                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', alt: ''
                }}

              {%- elsif request.design_mode -%}

                <div class="cpdpa__ph">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}
                  <span class="cpdpa__ph-label">
                    Upload photo or video — set in block settings
                  </span>
                </div>

              {%- elsif product.media[idx] -%}

                {{
                  product.media[idx]
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', alt: product.title
                }}

              {%- else -%}

                <span class="cpdpa__img--ph"></span>

              {%- endif -%}

            </div>

            {%- assign idx = idx | plus: 1 -%}


          {%- else -%}

            {%- assign block = section.blocks[idx] -%}
            {%- assign video = block.settings.video -%}

            <div class="cpdpa__item cpdpa__item--half">

              {%- if video != blank -%}

                <div class="cpdpa__video" data-video-container>

                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', alt: ''
                    }}

                  {%- elsif video.preview_image != blank -%}
                    {{
                      video.preview_image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}

                  {%- assign video_source = video.sources | first -%}

                  <button
                    type="button"
                    class="cpdpa__play"
                    aria-label="Play video"
                    data-video-src="{{ video_source.url }}"
                    data-video-type="{{ video_source.mime_type }}"
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="#F26E21">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>

                </div>

              {%- elsif block.settings.image != blank -%}

                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: ''
                }}

              {%- elsif request.design_mode -%}

                <div class="cpdpa__ph">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}
                  <span class="cpdpa__ph-label">
                    Upload photo or video — set in block settings
                  </span>
                </div>

              {%- elsif product.media[idx] -%}

                {{
                  product.media[idx]
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: product.title
                }}

              {%- else -%}

                <span class="cpdpa__img--ph"></span>

              {%- endif -%}

            </div>

            {%- assign idx = idx | plus: 1 -%}


            {%- assign block = section.blocks[idx] -%}
            {%- assign video = block.settings.video -%}

            <div class="cpdpa__item cpdpa__item--half">

              {%- if video != blank -%}

                <div class="cpdpa__video" data-video-container>

                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', alt: ''
                    }}

                  {%- elsif video.preview_image != blank -%}
                    {{
                      video.preview_image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}

                  {%- assign video_source = video.sources | first -%}

                  <button
                    type="button"
                    class="cpdpa__play"
                    aria-label="Play video"
                    data-video-src="{{ video_source.url }}"
                    data-video-type="{{ video_source.mime_type }}"
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="#F26E21">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>

                </div>

              {%- elsif block.settings.image != blank -%}

                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: ''
                }}

              {%- elsif request.design_mode -%}

                <div class="cpdpa__ph">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpa__ph-svg' }}
                  <span class="cpdpa__ph-label">
                    Upload photo or video — set in block settings
                  </span>
                </div>

              {%- elsif product.media[idx] -%}

                {{
                  product.media[idx]
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: product.title
                }}

              {%- else -%}

                <span class="cpdpa__img--ph"></span>

              {%- endif -%}

            </div>

            {%- assign idx = idx | plus: 1 -%}

          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  #CpdpArt-{{ uid }}{
    --cpdpa-orange:#F26E21; --cpdpa-brown:#3D2817; --cpdpa-teal:#35A9C9; --cpdpa-ink:#5b5750;
    --cpdpa-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdpa-body: var(--font-body-family, 'Poppins','Nunito',system-ui,sans-serif);
    font-family:var(--cpdpa-body);
  }
  #CpdpArt-{{ uid }} .cpdpa__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#CpdpArt-{{ uid }} .cpdpa__loaded-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.15s ease;
}

#CpdpArt-{{ uid }} .cpdpa__video.is-video-playing .cpdpa__loaded-video {
  opacity: 1;
}

#CpdpArt-{{ uid }} .cpdpa__video.is-video-playing > img,
#CpdpArt-{{ uid }} .cpdpa__video.is-video-playing .cpdpa__play {
  opacity: 0;
  pointer-events: none;
}
  #CpdpArt-{{ uid }} *{box-sizing:border-box;}
  #CpdpArt-{{ uid }} .cpdpa__wrap{max-width:1310px;margin:0 auto;padding:{{ section.settings.padding_top | default: 52 }}px 20px {{ section.settings.padding_bottom | default: 56 }}px;}
  #CpdpArt-{{ uid }} .cpdpa__title{font-family:'Nunito',sans-sarif;font-weight:900;text-align:center;font-size:clamp(30px,4vw,48px);line-height:1.1;margin:0 0 12px;color:var(--cpdpa-brown);}
  #CpdpArt-{{ uid }} .cpdpa__hl{color:var(--cpdpa-teal);font-style: italic;}
  #CpdpArt-{{ uid }} .cpdpa__sub{font-family: 'Nunito Sans',sans-sarif; text-align:center;font-size:clamp(16px,1.6vw,20px);letter-spacing:0px;max-width:790px;margin:0 auto 34px;line-height:1.5;}
  #CpdpArt-{{ uid }} .cpdpa__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;align-items:start;}
  #CpdpArt-{{ uid }} .cpdpa__col{display:flex;flex-direction:column;gap:16px;}
  #CpdpArt-{{ uid }} .cpdpa__item{position:relative;border-radius:20px;overflow:hidden;background:#EDE8F3;}
  #CpdpArt-{{ uid }} .cpdpa__item--tall{aspect-ratio:1/2.07;}
  #CpdpArt-{{ uid }} .cpdpa__item--half{aspect-ratio:1/1;}
  #CpdpArt-{{ uid }} .cpdpa__item img,#CpdpArt-{{ uid }} .cpdpa__img--ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #CpdpArt-{{ uid }} .cpdpa__img--ph{background:linear-gradient(135deg,#E7DDF3,#CFE3F5);}
  #CpdpArt-{{ uid }} .cpdpa__ph{position:absolute;inset:0;width:100%;height:100%;background:rgba(53,169,201,.1);display:flex;align-items:center;justify-content:center;}
  #CpdpArt-{{ uid }} .cpdpa__ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.35;}
  #CpdpArt-{{ uid }} .cpdpa__ph-label{position:relative;z-index:1;text-align:center;font-weight:700;font-size:12px;line-height:1.3;color:var(--cpdpa-brown);background:rgba(255,255,255,.92);padding:6px 10px;border-radius:10px;max-width:88%;}
  #CpdpArt-{{ uid }} .cpdpa__play{position:absolute;inset:0;margin:auto;width:60px;height:60px;border-radius:999px;background:rgba(255,255,255,.94);display:grid;place-items:center;box-shadow:0 6px 16px rgba(0,0,0,.2);padding-left:3px;z-index:2;}
  @media (max-width:920px){ #CpdpArt-{{ uid }} .cpdpa__grid{grid-template-columns:repeat(3,minmax(0,1fr));} }
  @media (max-width: 768px){
    #CpdpArt-{{ uid }} .cpdpa__title{
       margin:0 0 10px;
    }
    #CpdpArt-{{ uid }} .cpdpa__grid > .cpdpa__col:nth-child(3) {
      display: none;
    }
    #CpdpArt-{{ uid }}  .cpdpa__wrap{
      padding: 24px 14px 24px;
    }
    #CpdpArt-{{ uid }} .cpdpa__sub{
      margin:0 auto 15px;
    }
  }
  @media (max-width:560px){ #CpdpArt-{{ uid }} .cpdpa__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;} #CpdpArt-{{ uid }} .cpdpa__col{gap:12px;} }

</style>

<script>
(function () {
  var section = document.getElementById('CpdpArt-{{ uid }}');

  if (!section) return;

  section.querySelectorAll('[data-video-src]').forEach(function (button) {

    button.addEventListener('click', function () {

      var container = button.closest('[data-video-container]');

      if (!container || container.dataset.loaded === 'true') return;

      container.dataset.loaded = 'true';

      var video = document.createElement('video');
      var source = document.createElement('source');

      source.src = button.dataset.videoSrc;
      source.type = button.dataset.videoType || 'video/mp4';

      video.appendChild(source);

      video.controls = true;
      video.autoplay = false;
      video.playsInline = true;
      video.preload = 'auto';

      video.className = 'cpdpa__loaded-video';

      /*
       * Add video above the existing preview.
       * Do NOT remove the image immediately.
       */
      container.appendChild(video);

      /*
       * Wait until video has enough data to render.
       */
      video.addEventListener('canplay', function () {

        container.classList.add('is-video-playing');

        video.play().catch(function () {});

      }, { once: true });

      /*
       * Start loading only after click.
       */
      video.load();

    });

  });
})();
</script>

{% schema %}
{
  "name": "Creste Little Artists",
  "tag": "section",
  "class": "creste-artists-section",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Heading (dark part)", "default": "Made by" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (teal part)", "default": "Little Artists" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Real creations from happy kids around the world—every bag is wonderfully unique." },
    { "type": "paragraph", "content": "Add up to 7 photo/video blocks in masonry order: tall, pair-top, pair-bottom, tall, pair-top, pair-bottom, tall. Leave empty to auto-use the product's own photos." },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Photo / video",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / Video thumbnail" },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [ { "name": "Creste Little Artists" } ]
}
{% endschema %}
