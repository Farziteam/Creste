{%- comment -%} Creste — Six skills purple feature-card grid {%- endcomment -%}
{%- liquid
  assign uid = section.id
  assign skills = product.metafields.custom.product_section_features.value
-%}
{%- if skills != blank -%}
<section id="CpdpSk-{{ uid }}" class="cpdpsk" style="--cpdpsk-bg: {{ section.settings.bg_color | default: '#7C5CE0' }};">
  {%- if section.settings.promo_banner_desktop != blank or section.settings.promo_banner_mobile != blank or request.design_mode -%}
    <div class="cpdpsk__bg">
      {%- if section.settings.promo_banner_desktop != blank -%}
        {{ section.settings.promo_banner_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'cpdpsk__bg-img cpdpsk__bg-img--desktop', alt: section.settings.promo_banner_alt }}
      {%- elsif request.design_mode -%}
        <div class="cpdpsk__bg-img cpdpsk__bg-img--desktop cpdpsk__bg-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpsk__bg-ph-svg' }}<span class="cpdpsk__bg-ph-label">Desktop background — upload in section settings</span></div>
      {%- endif -%}
      {%- if section.settings.promo_banner_mobile != blank -%}
        {{ section.settings.promo_banner_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'cpdpsk__bg-img cpdpsk__bg-img--mobile', alt: section.settings.promo_banner_alt }}
      {%- elsif request.design_mode -%}
        <div class="cpdpsk__bg-img cpdpsk__bg-img--mobile cpdpsk__bg-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpsk__bg-ph-svg' }}<span class="cpdpsk__bg-ph-label">Mobile background — upload in section settings</span></div>
      {%- endif -%}
      <div class="cpdpsk__bg-overlay"></div>
    </div>
  {%- endif -%}
  <div class="cpdpsk__wrap">

    {% comment %} <h2 class="cpdpsk__title">{{ section.settings.heading | default: 'Six skills hiding inside one bag' }}</h2> {% endcomment %}
    <h2 class="cpdpsk__title">{{ skills.heading }}</h2>
    {% comment %} {%- if section.settings.subheading != blank -%}<p class="cpdpsk__sub">{{ section.settings.subheading }}</p>{%- endif -%} {% endcomment %}
    {% if skills.sub_heading != blank %}<p class="cpdpsk__sub">{{ skills.sub_heading }}</p>{%- endif -%}
    {% comment %} <div class="cpdpsk__grid">
      {%- for block in section.blocks -%}
        <div class="cpdpsk__card cpdpsk__card--{{ block.settings.color | default: 'green' }}" {{ block.shopify_attributes }}>
          <span class="cpdpsk__ico">{{ block.settings.icon | default: '✨' }}</span>
          <h3 class="cpdpsk__card-title">{{ block.settings.title }}</h3>
          <p class="cpdpsk__card-text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div> {% endcomment %}

    <div class="cpdpsk__grid">

      {% if skills.card_title_1 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_1 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_1 }}"
                alt="{{ skills.card_title_1 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_1 }}
          </h3>

          {% if skills.card_description_1 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_1 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}


      {% if skills.card_title_2 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_2 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_2 }}"
                alt="{{ skills.card_title_2 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_2 }}
          </h3>

          {% if skills.card_description_2 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_2 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}


      {% if skills.card_title_3 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_3 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_3 }}"
                alt="{{ skills.card_title_3 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_3 }}
          </h3>

          {% if skills.card_description_3 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_3 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}


      {% if skills.card_title_4 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_4 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_4 }}"
                alt="{{ skills.card_title_4 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_4 }}
          </h3>

          {% if skills.card_description_4 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_4 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}

      {% if skills.card_title_5 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_5 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_5 }}"
                alt="{{ skills.card_title_5 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_5 }}
          </h3>

          {% if skills.card_description_5 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_5 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}

      {% if skills.card_title_6 != blank %}
        <div class="cpdpsk__card">

          {% if skills.card_image_6 != blank %}
            <span class="cpdpsk__ico">
              <img
                src="{{ skills.card_image_6 }}"
                alt="{{ skills.card_title_6 | escape }}"
                loading="lazy"
              >
            </span>
          {% endif %}

          <h3 class="cpdpsk__card-title">
            {{ skills.card_title_6 }}
          </h3>

          {% if skills.card_description_6 != blank %}
            <p class="cpdpsk__card-text">
              {{ skills.card_description_6 | metafield_tag }}
            </p>
          {% endif %}

        </div>
      {% endif %}

    </div>
    <div class="cpdpsk__dots">
      <button type="button" class="cpdpsk__dot is-active"></button>
      <button type="button" class="cpdpsk__dot"></button>
    </div>
  </div>
</section>
{% endif %}
<style>
  #CpdpSk-{{ uid }}{
    --cpdpsk-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdpsk-body: var(--font-body-family, 'Poppins','Nunito',system-ui,sans-serif);
    background:var(--cpdpsk-bg); font-family:var(--cpdpsk-body); position:relative; overflow:hidden;
  }
  #CpdpSk-{{ uid }} *{box-sizing:border-box;}
  #CpdpSk-{{ uid }} .cpdpsk__bg{position:absolute;inset:0;z-index:0;overflow:hidden;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-img--mobile{display:none;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-ph{background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.35;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-ph-label{position:relative;z-index:1;font-weight:700;font-size:13px;color:#2b2b2b;background:rgba(255,255,255,.9);padding:6px 14px;border-radius:999px;}
  #CpdpSk-{{ uid }} .cpdpsk__bg-overlay{position:absolute;inset:0;background:rgba(38,20,74,.45);}
  #CpdpSk-{{ uid }} .cpdpsk__wrap{max-width:1250px;margin:0 auto;padding:{{ section.settings.padding_top | default: 64 }}px 10px {{ section.settings.padding_bottom | default: 72 }}px;position:relative;z-index:1;}
  #CpdpSk-{{ uid }} .cpdpsk__title{font-family: 'Nunito', sans-serif;font-weight:900;text-align:center;color:#fff;font-size:clamp(30px,4vw,48px);line-height:1.1;margin:0 0 12px;letter-spacing:0px;}
  #CpdpSk-{{ uid }} .cpdpsk__sub{text-align:center;color:rgba(255,255,255,.92);font-size:clamp(16px,1.6vw,20px);max-width:820px;margin:0 auto 40px;line-height:28px;    font-family: 'Nunito Sans', sans-serif;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: 0px;}
  #CpdpSk-{{ uid }} .cpdpsk__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;}
  #CpdpSk-{{ uid }} .cpdpsk__card{border-radius:32px;padding:21px;}
  #CpdpSk-{{ uid }} .cpdpsk__ico{display:grid;place-items:center;width:56px;height:56px;background:#fff;border-radius:16px;font-size:26px;margin-bottom:15px;box-shadow:0 3px 8px rgba(0,0,0,.06);}
  #CpdpSk-{{ uid }} .cpdpsk__ico img{width: 100%; height: 100%;}
  #CpdpSk-{{ uid }} .cpdpsk__card-title{font-family:'Nunito',sans-sarif;font-weight:700;font-size:20px;color:#2b2b2b;margin:0 0 5px;line-height: 137%;letter-spacing:0px;}
  #CpdpSk-{{ uid }} .cpdpsk__card-text{font-size:16px;line-height:1.55;color:#5a534b;margin:0;letter-spacing:0px;}
  #CpdpSk-{{ uid }} .cpdpsk__card--green{background:#E7F1DD;}
  #CpdpSk-{{ uid }} .cpdpsk__card--blue{background:#DCEBF2;}
  #CpdpSk-{{ uid }} .cpdpsk__card--cream{background:#FBF1DA;}
  #CpdpSk-{{ uid }} .cpdpsk__card--peach{background:#FBE6D9;}
  #CpdpSk-{{ uid }} .cpdpsk__card--pink{background:#FBE1E7;}
  #CpdpSk-{{ uid }} .cpdpsk__card--lavender{background:#ECE6F6;}
  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(1) {
    /* First child */
    background: #E9F5EC;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(2) {
    /* Second child */
    background: #E9F5EC;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(3) {
    /* Third child */
     background: #E9F5EC;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(4) {
    /* Fourth child */
    background: #FDEDE4;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(5) {
    /* Fifth child */
    background: #FCEDF3;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid > .cpdpsk__card:nth-child(6) {
    /* Sixth child */
    background: #F0ECFE;
  }
  @media (max-width:960px){ #CpdpSk-{{ uid }} .cpdpsk__grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media (max-width:749px){
    #CpdpSk-{{ uid }} .cpdpsk__bg-img--desktop{display:none;}
    #CpdpSk-{{ uid }} .cpdpsk__bg-img--mobile{display:block;}
    #CpdpSk-{{ uid }} .cpdpsk__wrap{
      padding: 24px 10px;
    }
    #CpdpSk-{{ uid }} .cpdpsk__sub{
      margin-bottom: 20px;
      line-height: 1.5;
    }
    #CpdpSk-{{ uid }} .cpdpsk__ico{
      height: 36px;
      width: 36px;
      border-radius: 10px;
    }
    #CpdpSk-{{ uid }} .cpdpsk__card-title{
      font-size: 13px;
      line-height: 120%;
    }
    #CpdpSk-{{ uid }} .cpdpsk__card-text{font-size: 11px;line-height:130%;}
    #CpdpSk-{{ uid }} .cpdpsk__card{
      border-radius: 14px;
      padding: 10px;
    }
     #CpdpSk-{{ uid }} .cpdpsk__grid {
    display: grid;

    /* 2 rows */
    grid-template-rows: repeat(2, auto);

    /* Fill vertically: 1,2 then 3,4 then 5,6 */
    grid-auto-flow: column;

    /* Each column takes roughly half the visible width */
    grid-auto-columns: calc((100% - 10px) / 2);

    grid-template-columns: unset;
    gap: 10px;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #CpdpSk-{{ uid }} .cpdpsk__grid::-webkit-scrollbar {
    display: none;
  }

  #CpdpSk-{{ uid }} .cpdpsk__card {
    scroll-snap-align: start;
  }
    {% comment %} #CpdpSk-{{ uid }} .cpdpsk__grid{
      {% comment %} display: grid; {% endcomment %}
      grid-template-columns: repeat(3, calc((100% - 10px) / 2));
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: row;
      gap: 10px;
      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;

      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    } 
    #CpdpSk-{{ uid }} .cpdpsk__grid::-webkit-scrollbar {
      display: none;
    }

    #CpdpSk-{{ uid }} .cpdpsk__card {
      scroll-snap-align: start;
    } {% endcomment %}
    #CpdpSk-{{ uid }} .cpdpsk__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
    } 

    #CpdpSk-{{ uid }} .cpdpsk__dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    #CpdpSk-{{ uid }} .cpdpsk__dot.is-active {
      width: 24px;
      border-radius: 10px;
      background: #ffffff;
    } 
      
  }
  
</style>
<script>
  (function () {
    const section = document.querySelector('#CpdpSk-{{ uid }}');

    if (!section) return;

    const slider = section.querySelector('.cpdpsk__grid');
    const dots = section.querySelectorAll('.cpdpsk__dot');

    if (!slider || !dots.length) return;

    function updateDots() {
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      const activeIndex =
        slider.scrollLeft >= maxScroll / 2 ? 1 : 0;

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    }

    slider.addEventListener('scroll', updateDots);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const maxScroll = slider.scrollWidth - slider.clientWidth;

        slider.scrollTo({
          left: index === 0 ? 0 : maxScroll,
          behavior: 'smooth'
        });
      });
    });

    updateDots();
  })();
</script>
{% schema %}
{
  "name": "Creste Six Skills",
  "tag": "section",
  "class": "creste-skills-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background (fallback colour)", "default": "#7C5CE0" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "default": 72 },
    { "type": "header", "content": "Background banner (optional)" },
    { "type": "paragraph", "content": "Upload an image to use as the section background, with the heading and skill cards displayed on top of it." },
    { "type": "image_picker", "id": "promo_banner_desktop", "label": "Background image — Desktop", "info": "Recommended 2000×700px" },
    { "type": "image_picker", "id": "promo_banner_mobile", "label": "Background image — Mobile", "info": "Recommended 1000×1400px" },
    { "type": "text", "id": "promo_banner_alt", "label": "Background image alt text" }
  ],
  "presets": [ { "name": "Creste Six Skills" } ]
}
{% endschema %}
