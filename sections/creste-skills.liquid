{%- comment -%} Creste — Six skills purple feature-card grid {%- endcomment -%}
{%- liquid
  assign uid = section.id
-%}
<section id="CpdpSk-{{ uid }}" class="cpdpsk" style="--cpdpsk-bg: {{ section.settings.bg_color | default: '#7C5CE0' }};">
  <div class="cpdpsk__wrap">
    {%- if section.settings.promo_banner_desktop != blank or section.settings.promo_banner_mobile != blank or request.design_mode -%}
      <div class="cpdpsk__promo-banner">
        {%- if section.settings.promo_banner_link != blank -%}<a href="{{ section.settings.promo_banner_link }}" class="cpdpsk__promo-link">{%- endif -%}
          {%- if section.settings.promo_banner_desktop != blank -%}
            {{ section.settings.promo_banner_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'cpdpsk__promo-img cpdpsk__promo-img--desktop', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdpsk__promo-img cpdpsk__promo-img--desktop cpdpsk__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpsk__promo-ph-svg' }}<span class="cpdpsk__promo-ph-label">Desktop banner — upload in section settings</span></div>
          {%- endif -%}
          {%- if section.settings.promo_banner_mobile != blank -%}
            {{ section.settings.promo_banner_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'cpdpsk__promo-img cpdpsk__promo-img--mobile', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdpsk__promo-img cpdpsk__promo-img--mobile cpdpsk__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdpsk__promo-ph-svg' }}<span class="cpdpsk__promo-ph-label">Mobile banner — upload in section settings</span></div>
          {%- endif -%}
        {%- if section.settings.promo_banner_link != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <h2 class="cpdpsk__title">{{ section.settings.heading | default: 'Six skills hiding inside one bag' }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="cpdpsk__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="cpdpsk__grid">
      {%- for block in section.blocks -%}
        <div class="cpdpsk__card cpdpsk__card--{{ block.settings.color | default: 'green' }}" {{ block.shopify_attributes }}>
          <span class="cpdpsk__ico">{{ block.settings.icon | default: '✨' }}</span>
          <h3 class="cpdpsk__card-title">{{ block.settings.title }}</h3>
          <p class="cpdpsk__card-text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  #CpdpSk-{{ uid }}{
    --cpdpsk-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdpsk-body: var(--font-body-family, 'Poppins','Nunito',system-ui,sans-serif);
    background:var(--cpdpsk-bg); font-family:var(--cpdpsk-body); position:relative; overflow:hidden;
  }
  #CpdpSk-{{ uid }} *{box-sizing:border-box;}
  #CpdpSk-{{ uid }} .cpdpsk__wrap{max-width:1240px;margin:0 auto;padding:{{ section.settings.padding_top | default: 64 }}px 20px {{ section.settings.padding_bottom | default: 72 }}px;position:relative;z-index:1;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-banner{width:100%;margin:0 0 32px;border-radius:22px;overflow:hidden;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-link{display:block;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-img{display:block;width:100%;height:auto;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-img--mobile{display:none;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-ph{position:relative;aspect-ratio:4/1;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-img--mobile.cpdpsk__promo-ph{aspect-ratio:3/4;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.5;}
  #CpdpSk-{{ uid }} .cpdpsk__promo-ph-label{position:relative;z-index:1;font-weight:700;font-size:13px;color:#2b2b2b;background:rgba(255,255,255,.9);padding:6px 14px;border-radius:999px;}
  @media (max-width:749px){
    #CpdpSk-{{ uid }} .cpdpsk__promo-img--desktop{display:none;}
    #CpdpSk-{{ uid }} .cpdpsk__promo-img--mobile{display:block;}
  }
  #CpdpSk-{{ uid }} .cpdpsk__title{font-family:var(--cpdpsk-head);font-weight:800;text-align:center;color:#fff;font-size:clamp(30px,4vw,52px);line-height:1.1;margin:0 0 12px;}
  #CpdpSk-{{ uid }} .cpdpsk__sub{text-align:center;color:rgba(255,255,255,.92);font-size:clamp(16px,1.6vw,20px);max-width:820px;margin:0 auto 40px;line-height:1.5;}
  #CpdpSk-{{ uid }} .cpdpsk__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;}
  #CpdpSk-{{ uid }} .cpdpsk__card{border-radius:22px;padding:26px;}
  #CpdpSk-{{ uid }} .cpdpsk__ico{display:grid;place-items:center;width:56px;height:56px;background:#fff;border-radius:16px;font-size:26px;margin-bottom:20px;box-shadow:0 3px 8px rgba(0,0,0,.06);}
  #CpdpSk-{{ uid }} .cpdpsk__card-title{font-family:var(--cpdpsk-head);font-weight:800;font-size:22px;color:#2b2b2b;margin:0 0 10px;}
  #CpdpSk-{{ uid }} .cpdpsk__card-text{font-size:16px;line-height:1.55;color:#5a534b;margin:0;}
  #CpdpSk-{{ uid }} .cpdpsk__card--green{background:#E7F1DD;}
  #CpdpSk-{{ uid }} .cpdpsk__card--blue{background:#DCEBF2;}
  #CpdpSk-{{ uid }} .cpdpsk__card--cream{background:#FBF1DA;}
  #CpdpSk-{{ uid }} .cpdpsk__card--peach{background:#FBE6D9;}
  #CpdpSk-{{ uid }} .cpdpsk__card--pink{background:#FBE1E7;}
  #CpdpSk-{{ uid }} .cpdpsk__card--lavender{background:#ECE6F6;}
  @media (max-width:960px){ #CpdpSk-{{ uid }} .cpdpsk__grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media (max-width:600px){ #CpdpSk-{{ uid }} .cpdpsk__grid{grid-template-columns:minmax(0,1fr);} }
</style>
{% schema %}
{
  "name": "Creste Six Skills",
  "tag": "section",
  "class": "creste-skills-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six skills hiding inside one bag" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every bag they colour quietly builds a real skill — here are six hiding in the fun." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#7C5CE0" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "default": 72 },
    { "type": "header", "content": "Promo Banner (optional)" },
    { "type": "image_picker", "id": "promo_banner_desktop", "label": "Banner image — Desktop", "info": "Recommended 2000×500px" },
    { "type": "image_picker", "id": "promo_banner_mobile", "label": "Banner image — Mobile", "info": "Recommended 1000×1300px" },
    { "type": "url", "id": "promo_banner_link", "label": "Banner link (optional)" },
    { "type": "text", "id": "promo_banner_alt", "label": "Banner alt text" }
  ],
  "blocks": [
    { "type": "skill", "name": "Skill card", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✨" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Description" },
      { "type": "select", "id": "color", "label": "Card colour", "default": "green", "options": [ { "value": "green", "label": "Green" }, { "value": "blue", "label": "Blue" }, { "value": "cream", "label": "Cream" }, { "value": "peach", "label": "Peach" }, { "value": "pink", "label": "Pink" }, { "value": "lavender", "label": "Lavender" } ] }
    ] }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Creste Six Skills" } ]
}
{% endschema %}
