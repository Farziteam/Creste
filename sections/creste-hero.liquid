{%- assign slides = section.blocks | where: 'type', 'slide' -%}
<style>
#creste-hb-{{ section.id }}{position:relative;overflow:hidden;background:{{ section.settings.bg }};line-height:0;}
#creste-hb-{{ section.id }} .hb-slide{display:none;}
#creste-hb-{{ section.id }} .hb-slide.active{display:block;}
#creste-hb-{{ section.id }} .hb-slide a{display:block;}
#creste-hb-{{ section.id }} .hb-slide picture{display:block;}
#creste-hb-{{ section.id }} .hb-slide img,#creste-hb-{{ section.id }} .hb-ph svg{display:block;width:100%;height:auto;}
#creste-hb-{{ section.id }} .hb-dots{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:3;line-height:1;}
#creste-hb-{{ section.id }} .hb-dot{width:12px;height:12px;border-radius:50%;background:#fff;opacity:.55;border:none;cursor:pointer;padding:0;}
#creste-hb-{{ section.id }} .hb-dot.on{opacity:1;box-shadow:0 0 0 4px rgba(244,121,58,.35);}
#creste-hb-{{ section.id }} .hb-arrow{position:absolute;top:50%;transform:translateY(-50%);width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,.9);border:none;color:var(--creste-orange,#F4793A);font-size:24px;line-height:1;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(0,0,0,.15);}
#creste-hb-{{ section.id }} .hb-arrow.prev{left:12px;}
#creste-hb-{{ section.id }} .hb-arrow.next{right:12px;}
@media(max-width: 749px){
  #creste-hb-{{ section.id }} .hb-arrow{display:none;}
}
</style>
<div id='creste-hb-{{ section.id }}' class='creste-section'>
<div class='hb-slides'>
{% if slides.size > 0 %}{% for block in slides %}<div class='hb-slide{% if forloop.first %} active{% endif %}' {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href='{{ block.settings.link }}'>{% endif %}<picture>{% if block.settings.image_mobile != blank %}<source media='(max-width: 749px)' srcset='{{ block.settings.image_mobile | image_url: width: 1200 }}'>{% endif %}{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 2400 }}' alt='{{ block.settings.alt | escape }}'{% if forloop.first %} loading='eager'{% else %} loading='lazy'{% endif %}>{% elsif block.settings.image_mobile != blank %}<img src='{{ block.settings.image_mobile | image_url: width: 1200 }}' alt='{{ block.settings.alt | escape }}'>{% endif %}</picture>{% if block.settings.link != blank %}</a>{% endif %}</div>{% endfor %}{% else %}{% for i in (1..2) %}<div class='hb-slide{% if forloop.first %} active{% endif %}'><div class='hb-ph'>{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>{% endfor %}{% endif %}
</div>
{% assign cnt = slides.size %}{% if cnt == 0 %}{% assign cnt = 2 %}{% endif %}
{% if section.settings.show_arrows and cnt > 1 %}<button type='button' class='hb-arrow prev' aria-label='Previous'>&#8249;</button><button type='button' class='hb-arrow next' aria-label='Next'>&#8250;</button>{% endif %}
{% if section.settings.show_dots and cnt > 1 %}<div class='hb-dots'>{% for i in (1..cnt) %}<button type='button' class='hb-dot{% if forloop.first %} on{% endif %}'></button>{% endfor %}</div>{% endif %}
</div>
{% comment %} <script>
(function(){var r=document.getElementById('creste-hb-{{ section.id }}');if(!r)return;var s=r.querySelectorAll('.hb-slide'),d=r.querySelectorAll('.hb-dot');if(s.length<2)return;var i=0,t;function go(n){s[i].classList.remove('active');if(d[i])d[i].classList.remove('on');i=(n+s.length)%s.length;s[i].classList.add('active');if(d[i])d[i].classList.add('on');}function rs(){clearInterval(t);t=setInterval(function(){go(i+1);},{{ section.settings.speed | times: 1000 }});}d.forEach(function(x,k){x.addEventListener('click',function(){go(k);rs();});});var p=r.querySelector('.hb-arrow.prev'),n=r.querySelector('.hb-arrow.next');if(p)p.addEventListener('click',function(){go(i-1);rs();});if(n)n.addEventListener('click',function(){go(i+1);rs();});rs();})();
</script> {% endcomment %}
<script>
(function(){

    var r = document.getElementById('creste-hb-{{ section.id }}');

    if (!r) return;

    var s = r.querySelectorAll('.hb-slide');
    var d = r.querySelectorAll('.hb-dot');

    if (s.length < 2) return;

    var i = 0;
    var t;

    /* -------------------------
       CHANGE SLIDE
    ------------------------- */

    function go(n){

        s[i].classList.remove('active');

        if(d[i]){
            d[i].classList.remove('on');
        }

        i = (n + s.length) % s.length;

        s[i].classList.add('active');

        if(d[i]){
            d[i].classList.add('on');
        }
    }


    /* -------------------------
       AUTO SLIDE
    ------------------------- */

    function rs(){

        clearInterval(t);

        t = setInterval(function(){

            go(i + 1);

        }, {{ section.settings.speed | times: 1000 }});

    }


    /* -------------------------
       DOTS
    ------------------------- */

    d.forEach(function(x,k){

        x.addEventListener('click',function(){

            go(k);

            rs();

        });

    });


    /* -------------------------
       ARROWS
    ------------------------- */

    var p = r.querySelector('.hb-arrow.prev');
    var n = r.querySelector('.hb-arrow.next');


    if(p){

        p.addEventListener('click',function(){

            go(i - 1);

            rs();

        });

    }


    if(n){

        n.addEventListener('click',function(){

            go(i + 1);

            rs();

        });

    }


    /* -------------------------
       MOBILE SWIPE
    ------------------------- */

    var startX = 0;
    var startY = 0;
    var endX = 0;
    var endY = 0;


    r.addEventListener('touchstart', function(e){

        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;

    }, { passive: true });


    r.addEventListener('touchend', function(e){

        endX = e.changedTouches[0].clientX;
        endY = e.changedTouches[0].clientY;


        var diffX = endX - startX;
        var diffY = endY - startY;


        /*
         * Ignore vertical scrolling.
         *
         * Only treat the gesture as a swipe
         * when horizontal movement is greater.
         */
        if(Math.abs(diffX) <= Math.abs(diffY)){
            return;
        }


        /*
         * Minimum swipe distance
         */
        if(Math.abs(diffX) < 50){
            return;
        }


        /*
         * Swipe LEFT
         * → Next slide
         */
        if(diffX < 0){

            go(i + 1);

        }


        /*
         * Swipe RIGHT
         * → Previous slide
         */
        else{

            go(i - 1);

        }


        /*
         * Restart auto rotation
         */
        rs();

    }, { passive: true });


    /* -------------------------
       START AUTO ROTATION
    ------------------------- */

    rs();


})();
</script>
{% schema %}
{
  "name": "Creste Banner Slideshow",
  "tag": "section",
  "settings": [ {"type":"color","id":"bg","label":"Background","default":"#F4793A"}, {"type":"checkbox","id":"show_dots","label":"Show dots","default":true}, {"type":"checkbox","id":"show_arrows","label":"Show arrows","default":true}, {"type":"range","id":"speed","min":2,"max":10,"step":1,"unit":"s","label":"Auto-rotate speed","default":5} ],
  "blocks": [ {"type":"slide","name":"Banner","settings":[ {"type":"image_picker","id":"image","label":"Desktop banner"}, {"type":"image_picker","id":"image_mobile","label":"Mobile banner"}, {"type":"url","id":"link","label":"Link (optional)"}, {"type":"text","id":"alt","label":"Alt text","default":"Creste banner"} ]} ],
  "max_blocks": 12,
  "presets": [ {"name":"Creste Banner Slideshow","blocks":[ {"type":"slide"}, {"type":"slide"} ]} ]
}
{% endschema %}