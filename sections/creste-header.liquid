<div class='hd-mega'>
<div class='hd-mega-in'>
<div class='hd-mcol'><h4 class='hd-mtitle'>{{ section.settings.age_heading }}</h4><div class='hd-agelist'>{% for block in ages %}<a class='hd-agepill' href='{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}' style='background:{{ block.settings.tint }};' {{ block.shopify_attributes }}><b style='color:{{ block.settings.text-color }};'>{{ block.settings.label }}</b><span style='color:{{ block.settings.text-color }};'>{{ block.settings.suffix }}</span></a>{% endfor %}</div></div>
<div class='hd-mcol'><h4 class='hd-mtitle'>{{ section.settings.cat_heading }}</h4><div class='hd-catgrid'>{% for block in cats %}<a class='hd-catitem' href='{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}' {{ block.shopify_attributes }}><span class='hd-catthumb'>{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 100 }}' alt=''>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</span><span><span class='hd-catname'>{{ block.settings.name }}</span><span class='hd-catsub'>{{ block.settings.subtitle }}</span></span></a>{% endfor %}</div></div>
<div class='hd-na'><h4>{{ section.settings.na_heading }}</h4> {% assign p = all_products[section.settings.na_product] %}<div class='hd-nacard'>{% if p != blank %}<a class='hd-naimg' href='{{ p.url }}'>{% if p.featured_image %}<img src='{{ p.featured_image | image_url: width: 300 }}' alt='{{ p.title | escape }}'>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a><div class='hd-nabody'><div class="hd-card-header"><span class='hd-narate'>&#9733; {{ p.metafields.reviews.rating.value | default: '4.9' }}</span>{% if p.metafields.custom.product_category != blank %}<span class='hd-product-tag'><em>&#9733;</em> {{ p.metafields.custom.product_category }}</span>{% endif %}</div><p class='hd-nat'>{{ p.title }}</p>
<div class="product-sub-heading">{% if p.metafields.custom.age_group != blank %}<p>{{ p.metafields.custom.age_group }}</p>{% endif %}{% if p.metafields.custom.product_category != blank %}<p>•&nbsp;&nbsp;{{ p.metafields.custom.product_category }}</p>{% endif %}</div>
<div class='hd-nap'><b>{{ p.price | money_without_trailing_zeros }}</b>{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money_without_currency | replace: '.00', '' }}</s>{% assign disc = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price %}<i>{{ disc }}% off</i>{% endif %}</div><div class='cp-cart'><form method='post' action='/cart/add'><input type='hidden' name='id' value='{{ product.selected_or_first_available_variant.id }}'><button type='submit'>{{ 'icon-add-to-cart.svg' | inline_asset_content }} Add To Cart</button></form></div>
{% comment %} <a class='hd-nacart' href='{{ p.url }}'>&#128722; View</a> {% endcomment %}
</div>{% else %}<span class='hd-naimg'>{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span><div class='hd-nabody'><span class='hd-narate'>&#9733; 4.9</span><p class='hd-nat'>Bouquet Candle Kit</p><div class='hd-nap'><b>Rs. 1,299</b></div><a class='hd-nacart' href='#'>&#128722; View</a></div>{% endif %}</div></div>
</div>
</div>

{%- comment -%} ===== Mobile drawer (redesigned to match Figma 782:1559) ===== {%- endcomment -%}
<div class='hd-drawer' id='hdm-{{ section.id }}' aria-hidden='true'>
<div class='hd-drawer__backdrop js-hd-close'></div>
<aside class='hd-drawer__panel' role='dialog' aria-label='Menu'>
<div class='hd-d-top'>
<a href='{{ routes.root_url }}' class='hd-logo'>{% if section.settings.logo != blank %}<img src='{{ section.settings.logo | image_url: width: 240 }}' alt='{{ shop.name | escape }}'>{% else %}<span class='hd-name'>Creste</span>{% endif %}</a>
<button type='button' class='hd-d-close js-hd-close' aria-label='Close menu'><svg width='16' height='16' viewBox='0 0 24 24' fill='none'><path d='M6 6l12 12M18 6L6 18' stroke='currentColor' stroke-width='2' stroke-linecap='round'/></svg></button>
</div>
{% if section.settings.quiz_label != blank %}
  <a href='{{ section.settings.quiz_link | default: '#' }}' class='hd-d-gift'>
    <span class='ic'><img src='{{ section.settings.quiz_logo | image_url: width: 50  }}'></span>
    <span class='tx'>
      <span class='t1'>Not sure what to pick?</span>
      <span class='t2'>1-min Gift Finder, perfect kit</span>
    </span>
    <span class='qb'>{{ section.settings.quiz_label }}</span>
  </a>
{% endif %}
<details class='hd-d-acc' open>
<summary class='hd-d-row'><span>{{ section.settings.shop_label | default: 'Shop' }}</span><svg class='cv' width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M6 9l6 6 6-6' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg></summary>
<div class='hd-d-body'>
<div>
<p class='hd-d-label'>{{ section.settings.age_heading | default: 'By Age' }}</p>
<div class='hd-d-ages'>{% for block in ages %}<a class='hd-d-age' href='{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}' style='background:{{ block.settings.tint | default: '#f2ede4' }};'>{{ block.settings.label }}</a>{% endfor %}</div>
</div>
<div>
<p class='hd-d-label'>{{ section.settings.cat_heading | default: 'By Activity' }}</p>
<div class='hd-d-acts'>{% assign tints = 'e3f0fb,fdece0,ece7fb,e3f5e9,fde4ee,fbf3df' | split: ',' %}{% for block in cats %}{% assign ci = forloop.index0 | modulo: 6 %}<a class='hd-d-act' href='{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}' style='background:#{{ tints[ci] }};'>{{ block.settings.name }}</a>{% endfor %}</div>
</div>
</div>
</details>
<nav>{% for block in navs %}<a class='hd-d-row' href='{{ block.settings.link | default: '#' }}'>{{ block.settings.label }}</a>{% endfor %}</nav>
{% assign dp = all_products[section.settings.na_product] %}
<div class='hd-mob-bottom'>
<h4>{{ section.settings.na_heading | default: 'New Arrivals' }}</h4>
<div class='hd-d-na'>

<div class='hd-mob-product-card'>
<div class='mob-product-card-details'>
<div class='hd-d-nacard'>
{% if dp != blank %}

<a href='{{ dp.url }}' class='hd-d-namedia'>{% if dp.featured_image %}<img src='{{ dp.featured_image | image_url: width: 180 }}' alt='{{ dp.title | escape }}'>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a>
<div class='hd-d-nainfo'>
<a href='{{ dp.url }}' class='hd-d-naname'>{{ dp.title }}</a>
<div class="product-sub-heading">{% if dp.metafields.custom.age_group != blank %}<p>{{ dp.metafields.custom.age_group }}</p>{% endif %}{% if dp.metafields.custom.product_category != blank %}<p>•&nbsp;&nbsp;{{ dp.metafields.custom.product_category }}</p>{% endif %}</div>


{% if dp.type != blank %}<span class='hd-d-nasub'>{{ dp.type }}</span>{% endif %}
<div class='hd-d-naprice'><b>{{ dp.price | money_without_trailing_zeros }}</b>{% if dp.compare_at_price > dp.price %}<s>{{ dp.compare_at_price | money | remove: '.00' }}</s>{% assign pct = dp.compare_at_price | minus: dp.price | times: 100 | divided_by: dp.compare_at_price %}<span class='hd-d-nadisc'>{{ pct }}% off</span>{% endif %}</div>

</div>

</div>
<div class='cp-cart'><form method='post' action='/cart/add'><input type='hidden' name='id' value='{{ dp.selected_or_first_available_variant.id }}'><button type='submit'>{{ 'icon-add-to-cart.svg' | inline_asset_content }} Add To Cart</button></form></div>

{% endif %}
</div>
</div>
</div>
</div>
</div>
</aside>
{% comment %} {% else %}
<span class='hd-d-namedia'>{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
<div class='hd-d-nainfo'>
<span class='hd-d-naname'>DIY Hand Casting Kit</span>
<span class='hd-d-nasub'>AGES 7+ &bull; STEAM KIT</span>
<div class='hd-d-naprice'><b>Rs.&nbsp;1,299</b><s>Rs.&nbsp;2,299</s><span class='hd-d-nadisc'>20% off</span></div>
</div>
{% endif %}
</div>
<a class='hd-d-nabtn' href='{% if dp != blank %}{{ dp.url }}{% else %}#{% endif %}'>&#128722; Add to Cart</a>
</div> {% endcomment %}

</div>
</div>
<script>
(function(){var r=document.getElementById('creste-hd-{{ section.id }}');if(!r)return;
var trig=r.querySelector('.hd-shoptrigger'),mega=r.querySelector('.hd-mega');if(trig&&mega){var t;function sh(){clearTimeout(t);mega.classList.add('open');}function hd(){t=setTimeout(function(){mega.classList.remove('open');},160);}[trig,mega].forEach(function(el){el.addEventListener('mouseenter',sh);el.addEventListener('mouseleave',hd);});}
var drawer=document.getElementById('hdm-{{ section.id }}');if(drawer){drawer.querySelectorAll('.js-hd-close').forEach(function(el){el.addEventListener('click',function(){drawer.classList.remove('open');document.body.style.overflow='';});});}
})();
</script>
{% schema %}
