  "label": "Select Product"
} ],
  "blocks": [ {"type":"nav","name":"Nav link","settings":[ {"type":"text","id":"label","label":"Label","default":"Our Tribe"}, {"type":"url","id":"link","label":"Link"} ]}, {"type":"age","name":"Age link","settings":[ {"type":"text","id":"label","label":"Age","default":"0-3"}, {"type":"text","id":"suffix","label":"Suffix","default":"years"}, {"type":"color","id":"tint","label":"Pill color","default":"#FDE7D6"},{"type":"color","id":"text-color","label":"Text color","default":"#040404"}, {"type":"url","id":"link","label":"Link"} ]}, {"type":"category","name":"Category link","settings":[ {"type":"image_picker","id":"image","label":"Thumbnail"}, {"type":"text","id":"name","label":"Name","default":"Arts & Crafts"}, {"type":"text","id":"subtitle","label":"Subtitle","default":"Paint, create & imagine"}, {"type":"url","id":"link","label":"Link"} ]} ],
  "max_blocks": 30,
  "presets": [ {"name":"Creste Header"} ]
}
{% endschema %}