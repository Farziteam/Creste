#creste-hd-{{ section.id }} .hd-na{position:relative;overflow:hidden;background:url('{{ section.settings.bg_image | image_url: width: 1200 }}') no-repeat,{{ section.settings.na_bg }};padding:12%;color:#fff;display:flex;flex-direction:column;justify-content:center;background-size:cover;}
{% comment %} #creste-hd-{{ section.id }} .hd-na::before{content:'';position:absolute;top:-70px;right:-60px;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.12);pointer-events:none;} {% endcomment %}
