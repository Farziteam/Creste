{% render 'creste-tokens' %}
<style>
#creste-ft-{{ section.id }}{background:{{ section.settings.bg }};border-top:6px solid {{ section.settings.top_border }};color:#2B1702;padding:36px 18px 20px;}
#creste-ft-{{ section.id }} .ft-inner{max-width:1200px;margin:0 auto;}
#creste-ft-{{ section.id }} .ft-top{display:block;}
#creste-ft-{{ section.id }} .ft-brand{margin-bottom:8px;}
#creste-ft-{{ section.id }} .ft-logo img{max-height:56px;width:auto;display:block;margin-bottom:10px;}
#creste-ft-{{ section.id }} .ft-name{font-family:'Fredoka One',cursive;font-size:30px;margin:0 0 6px;}
#creste-ft-{{ section.id }} .ft-tag{margin:2px 0 0;font-family:'Poppins',sans-serif;font-size:13px;color:#574239;}
#creste-ft-{{ section.id }} .ft-about{margin:14px 0 0;font-family:'Poppins',sans-serif;font-size:15px;line-height:1.6;color:#2B1702;max-width:340px;}
#creste-ft-{{ section.id }} .ft-social{display:flex;gap:12px;margin:16px 0 6px;}
#creste-ft-{{ section.id }} .ft-soc{width:48px;height:48px;border-radius:50%;background:#fff;box-shadow:0 6px 14px rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;color:var(--creste-orange);font-size:20px;text-decoration:none;overflow:hidden;}
#creste-ft-{{ section.id }} .ft-soc img{width:24px;height:24px;object-fit:contain;}
#creste-ft-{{ section.id }} .ft-acchead{display:flex;align-items:center;justify-content:space-between;width:100%;background:none;border:none;border-bottom:2px solid var(--ul,#FFD400);padding:15px 0;cursor:pointer;color:inherit;text-align:left;}
#creste-ft-{{ section.id }} .ft-acchead h4{margin:0;font-family:'Nunito',sans-serif;font-weight:800;font-size:16px;letter-spacing:1px;text-transform:uppercase;padding:0;border:none;}
#creste-ft-{{ section.id }} .ft-chev{flex:0 0 auto;transition:transform .25s;}
#creste-ft-{{ section.id }} .ft-acc.open .ft-chev{transform:rotate(180deg);}
#creste-ft-{{ section.id }} .ft-acc-body{display:none;padding:12px 0 8px;}
#creste-ft-{{ section.id }} .ft-acc.open .ft-acc-body{display:block;}
#creste-ft-{{ section.id }} .ft-acc-body ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;}
#creste-ft-{{ section.id }} .ft-acc-body a{color:#2B1702;opacity:.9;text-decoration:none;font-family:'Poppins',sans-serif;font-size:15px;}
#creste-ft-{{ section.id }} .ft-pill{background:#fff;border-radius:9999px;display:flex;align-items:center;gap:12px;padding:8px 18px 8px 8px;margin-bottom:14px;box-shadow:0 4px 12px rgba(0,0,0,.06);font-family:'Poppins',sans-serif;font-weight:500;font-size:15px;color:#2B1702;text-decoration:none;}
#creste-ft-{{ section.id }} .ft-pill .ic{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto;}
#creste-ft-{{ section.id }} .ft-addr{display:flex;gap:10px;align-items:flex-start;font-family:'Poppins',sans-serif;font-size:14px;color:#2B1702;line-height:1.5;}
#creste-ft-{{ section.id }} .ft-addr .pin{width:38px;height:38px;border-radius:50%;background:#FDECC0;display:flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto;}
#creste-ft-{{ section.id }} .ft-store{background:{{ section.settings.banner_bg }};border-radius:24px;padding:24px 22px;margin-top:24px;display:flex;flex-direction:column;gap:14px;color:#fff;}
#creste-ft-{{ section.id }} .ft-store h3{font-family:'Nunito',sans-serif;font-weight:900;font-size:24px;margin:0 0 8px;}
#creste-ft-{{ section.id }} .ft-store p{font-family:'Poppins',sans-serif;font-size:15px;line-height:1.5;opacity:.95;margin:0;max-width:640px;}
#creste-ft-{{ section.id }} .ft-store a.btn{background:#fff;color:#2B1702;border-radius:9999px;padding:16px 34px;font-family:'Nunito',sans-serif;font-weight:800;font-size:16px;text-decoration:none;text-align:center;}
#creste-ft-{{ section.id }} .ft-bottom{text-align:center;margin-top:22px;padding-top:14px;font-family:'Poppins',sans-serif;font-size:13px;color:#2B1702;opacity:.75;}
@media(min-width:900px){#creste-ft-{{ section.id }}{padding:44px 24px 22px;}#creste-ft-{{ section.id }} .ft-top{display:flex;flex-wrap:wrap;gap:32px;align-items:flex-start;}#creste-ft-{{ section.id }} .ft-brand{flex:1.5 1 280px;margin-bottom:0;}#creste-ft-{{ section.id }} .ft-acc{flex:1 1 160px;}#creste-ft-{{ section.id }} .ft-acchead{border-bottom:none;padding:0 0 12px;pointer-events:none;cursor:default;}#creste-ft-{{ section.id }} .ft-acchead h4{display:inline-block;border-bottom:3px solid var(--ul,#FFD400);padding-bottom:6px;}#creste-ft-{{ section.id }} .ft-chev{display:none;}#creste-ft-{{ section.id }} .ft-acc-body{display:block;padding:0;}#creste-ft-{{ section.id }} .ft-store{flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:space-between;padding:26px 24px;}#creste-ft-{{ section.id }} .ft-store a.btn{white-space:nowrap;}}
</style>
<div id='creste-ft-{{ section.id }}' class='creste-section'>
<div class='ft-inner'>
<div class='ft-top'>
<div class='ft-brand'>
{% if section.settings.logo != blank %}<div class='ft-logo'><img src='{{ section.settings.logo | image_url: width: 320 }}' alt='{{ shop.name | escape }}'></div>{% else %}<p class='ft-name'>Creste</p>{% endif %}
{% if section.settings.tagline != blank %}<p class='ft-tag'>{{ section.settings.tagline }}</p>{% endif %}
<p class='ft-about'>{{ section.settings.about }}</p>
<div class='ft-social'>{% for block in section.blocks %}{% if block.type == 'social' %}<a class='ft-soc' href='{{ block.settings.url | default: '#' }}' {{ block.shopify_attributes }}>{% if block.settings.icon != blank %}<img src='{{ block.settings.icon | image_url: width: 60 }}' alt=''>{% else %}{{ block.settings.emoji }}{% endif %}</a>{% endif %}{% endfor %}</div>
</div>
{% for block in section.blocks %}{% if block.type == 'menu' %}<div class='ft-acc' style='--ul:{{ block.settings.underline }};' {{ block.shopify_attributes }}><button type='button' class='ft-acchead'><h4>{{ block.settings.heading }}</h4><svg class='ft-chev' viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg></button><div class='ft-acc-body'><ul>{% assign rows = block.settings.links | newline_to_br | split: '<br />' %}{% for row in rows %}{% assign parts = row | strip | split: '|' %}{% if parts.size > 0 and parts[0] != blank %}<li><a href='{{ parts[1] | default: '#' | strip }}'>{{ parts[0] | strip }}</a></li>{% endif %}{% endfor %}</ul></div></div>{% endif %}{% endfor %}
<div class='ft-acc' style='--ul:{{ section.settings.contact_underline }};'><button type='button' class='ft-acchead'><h4>{{ section.settings.contact_heading }}</h4><svg class='ft-chev' viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg></button><div class='ft-acc-body'>
{% if section.settings.phone != blank %}<a class='ft-pill' href='tel:{{ section.settings.phone | remove: ' ' }}'><span class='ic' style='background:#FDE7D6;'>&#128222;</span>{{ section.settings.phone }}</a>{% endif %}
{% if section.settings.email != blank %}<a class='ft-pill' href='mailto:{{ section.settings.email }}'><span class='ic' style='background:#DCEBF5;'>&#9993;</span>{{ section.settings.email }}</a>{% endif %}
{% if section.settings.address != blank %}<div class='ft-addr'><span class='pin'>&#128205;</span><span>{{ section.settings.address }}</span></div>{% endif %}
</div></div>
</div>
<div class='ft-store'>
<div><h3>{{ section.settings.banner_title }}</h3><p>{{ section.settings.banner_text }}</p></div>
<a class='btn' href='{{ section.settings.banner_link | default: '#' }}'>{{ section.settings.banner_btn }}</a>
</div>
<div class='ft-bottom'>{{ section.settings.copyright }}</div>
</div>
</div>
<script>
(function(){var r=document.getElementById('creste-ft-{{ section.id }}');if(!r)return;r.querySelectorAll('.ft-acchead').forEach(function(h){h.addEventListener('click',function(){if(window.innerWidth>=900)return;h.parentNode.classList.toggle('open');});});})();
</script>
{% schema %}
{
  "name": "Creste Footer",
  "tag": "footer",
  "settings": [ {"type":"color","id":"bg","label":"Background","default":"#FCEBB6"}, {"type":"color","id":"top_border","label":"Top border","default":"#FFD400"}, {"type":"image_picker","id":"logo","label":"Logo"}, {"type":"text","id":"tagline","label":"Logo tagline","default":"Gifts, Giggle, Gang"}, {"type":"textarea","id":"about","label":"About text","default":"Made for messy hands and big, wild imaginations. Crafting future innovators one kit at a time."}, {"type":"header","content":"Contact column"}, {"type":"text","id":"contact_heading","label":"Heading","default":"Say Hello!"}, {"type":"color","id":"contact_underline","label":"Underline color","default":"#F4793A"}, {"type":"text","id":"phone","label":"Phone","default":"+91 8081026320"}, {"type":"text","id":"email","label":"Email","default":"contact@crestekids.com"}, {"type":"textarea","id":"address","label":"Address","default":"3 Gokhle Marg, Near Red Hill School, Lucknow-226001"}, {"type":"header","content":"Store banner"}, {"type":"color","id":"banner_bg","label":"Banner background","default":"#F4793A"}, {"type":"text","id":"banner_title","label":"Banner title","default":"Find a Creste Store near you"}, {"type":"textarea","id":"banner_text","label":"Banner text","default":"Discover a world of play and learning. Visit our physical spaces to experience our DIY kits and toy collections firsthand."}, {"type":"text","id":"banner_btn","label":"Button label","default":"SEARCH NOW"}, {"type":"url","id":"banner_link","label":"Button link"}, {"type":"header","content":"Bottom"}, {"type":"text","id":"copyright","label":"Copyright","default":"© 2024 Creste DIY. Made By Farziengineer ."} ],
  "blocks": [ {"type":"menu","name":"Link column","settings":[ {"type":"text","id":"heading","label":"Heading","default":"Explore"}, {"type":"color","id":"underline","label":"Underline color","default":"#FFD400"}, {"type":"textarea","id":"links","label":"Links (one per line: Label|/url)","default":"Our Story|/pages/our-story"} ]}, {"type":"social","name":"Social icon","settings":[ {"type":"image_picker","id":"icon","label":"Icon"}, {"type":"text","id":"emoji","label":"Emoji fallback","default":"📷"}, {"type":"url","id":"url","label":"URL"} ]} ],
  "max_blocks": 12,
  "presets": [ {"name":"Creste Footer"} ]
}
{% endschema %}