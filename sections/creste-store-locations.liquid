<section id="store-locations-{{ section.id }}" class="store-locations">
  <div class="store-locations__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="store-locations__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="store-locations__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'location' -%}
            <div class="store-locations__card" {{ block.shopify_attributes }}>
              <div class="store-locations__photo store-locations__photo--{{ block.settings.color }}">
                <span class="store-locations__photo-circle" aria-hidden="true"></span>
                {%- if block.settings.status_label != blank -%}
                  <span class="store-locations__badge store-locations__badge--{{ block.settings.color }}">{{ block.settings.status_label }}</span>
                {%- endif -%}
              </div>
              <div class="store-locations__body">
                {%- if block.settings.name != blank -%}
                  <p class="store-locations__name">{{ block.settings.name }}</p>
                {%- endif -%}
                {%- if block.settings.body_text != blank -%}
                  <p class="store-locations__text">{{ block.settings.body_text }}</p>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a href="{{ block.settings.link_url | default: '#' }}" class="store-locations__link">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #store-locations-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #store-locations-{{ section.id }} .store-locations__inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  #store-locations-{{ section.id }} .store-locations__heading { margin: 0 0 32px; color: #2c2a27; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.5px; }
  #store-locations-{{ section.id }} .store-locations__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  #store-locations-{{ section.id }} .store-locations__card { background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 8px 24px rgba(44, 42, 39, 0.05); }
  #store-locations-{{ section.id }} .store-locations__photo { position: relative; height: 96px; overflow: hidden; }
  #store-locations-{{ section.id }} .store-locations__photo-circle { position: absolute; right: -18px; bottom: -30px; width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.35); }
  #store-locations-{{ section.id }} .store-locations__photo--teal { background: #e3f4f8; }
  #store-locations-{{ section.id }} .store-locations__photo--purple { background: #ece6f8; }
  #store-locations-{{ section.id }} .store-locations__photo--pink { background: #fbe8f0; }
  #store-locations-{{ section.id }} .store-locations__badge { position: absolute; top: 12px; left: 12px; padding: 4px 12px; border-radius: 999px; font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 600; }
  #store-locations-{{ section.id }} .store-locations__badge--teal { background: #ffffff; color: #3aaccc; }
  #store-locations-{{ section.id }} .store-locations__badge--purple { background: #ffffff; color: #9b7fd4; }
  #store-locations-{{ section.id }} .store-locations__badge--pink { background: #ffffff; color: #e87bac; }
  #store-locations-{{ section.id }} .store-locations__body { padding: 20px; }
  #store-locations-{{ section.id }} .store-locations__name { margin: 0 0 4px; color: #2c2a27; font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 20px; }
  #store-locations-{{ section.id }} .store-locations__text { margin: 0 0 10px; color: #9c968d; font-family: 'Poppins', sans-serif; font-size: 13.5px; }
  #store-locations-{{ section.id }} .store-locations__link { color: #f4793a; font-family: 'Poppins', sans-serif; font-size: 13.5px; font-weight: 600; text-decoration: none; }
  #store-locations-{{ section.id }} .store-locations__link:hover { text-decoration: underline; }
  @media screen and (max-width: 749px) {
    #store-locations-{{ section.id }} .store-locations__inner { padding: 0 20px; }
    #store-locations-{{ section.id }} .store-locations__grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>

{% schema %}
{
  "name": "Store Locations",
  "tag": "section",
  "class": "section-store-locations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Creste stores" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 64 }
  ],
  "blocks": [
    { "type": "location", "name": "Location", "settings": [
        { "type": "text", "id": "name", "label": "Store name", "default": "City name" },
        { "type": "select", "id": "color", "label": "Accent color", "options": [
            { "value": "teal", "label": "Teal" }, { "value": "purple", "label": "Purple" }, { "value": "pink", "label": "Pink" }
          ], "default": "teal" },
        { "type": "text", "id": "status_label", "label": "Status badge", "default": "Opening soon" },
        { "type": "text", "id": "body_text", "label": "Body text", "default": "[ Add store address ]" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Notify me" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ] }
  ],
  "presets": [
    { "name": "Store Locations", "blocks": [
        { "type": "location", "settings": { "name": "Kanpur", "color": "teal", "status_label": "Opening soon", "body_text": "[ Add store address ]", "link_label": "Notify me" } },
        { "type": "location", "settings": { "name": "Varanasi", "color": "purple", "status_label": "Opening soon", "body_text": "[ Add store address ]", "link_label": "Notify me" } },
        { "type": "location", "settings": { "name": "Your city?", "color": "pink", "status_label": "Suggest a city", "body_text": "Tell us where to open next", "link_label": "Notify me" } }
      ] }
  ]
}
{% endschema %}
