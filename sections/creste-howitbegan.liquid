{% render 'creste-tokens' %}
{%- assign _bgid = 'creste-hib-' | append: section.id -%}
{%- assign tiles = section.blocks | where: 'type', 'tile' -%}
{%- assign dogm = section.settings.dog_w | times: 0.5 | round -%}
<style>
{% comment %} #creste-hib-{{ section.id }}{position:relative;padding:24px 16px 44px;background:{{ section.settings.section_bg }};background-size:cover;background-position:center;} {% endcomment %}
#creste-hib-{{ section.id }}{
    position:relative;
    padding:24px 16px 44px;
    background:{{ section.settings.section_bg }};
    background-size:cover;
    background-position:center;
    transition: background-color 0.6s ease;
}

#creste-hib-{{ section.id }}.dynamic-bg{
    background-color: color-mix(
        in srgb,
        var(--active-tile-color) 18%,
        white
    );
}
#creste-hib-{{ section.id }} .hib-dog{position:absolute;top:{{ section.settings.dog_top }}px;z-index:5;width:{{ dogm }}px;pointer-events:none;}
#creste-hib-{{ section.id }} .hib-dog.l{left:{{ section.settings.dog_side }}px;z-index: 0;}
#creste-hib-{{ section.id }} .hib-dog.r{right:{{ section.settings.dog_side }}px;z-index: 0;}
#creste-hib-{{ section.id }} .hib-dog img{display:block;width:100%;height:auto;}
#creste-hib-{{ section.id }} .hib-in{position:relative;max-width:1280px;margin:0 auto;}
#creste-hib-{{ section.id }} .hib-h{text-align:center;margin:0 0 20px;font-family:'Fredoka One',cursive;font-weight:400;font-size:34px;line-height:1.1;color:#2B1702;}
#creste-hib-{{ section.id }} .hib-stack{display:flex;flex-direction:column;gap:{{ section.settings.gap }}px;}
#creste-hib-{{ section.id }} .hib-card {
    position: sticky;
    top: var(--card-top-desktop);
    background: var(--tile, #F4793A);
    border-radius: 24px;
    padding: 14px;
    box-shadow: 0 14px 30px rgba(0,0,0,.15);
}
{% comment %} #creste-hib-{{ section.id }} .hib-card{position:sticky;background:var(--tile,#F4793A);border-radius:24px;padding:14px;box-shadow:0 14px 30px rgba(0,0,0,.15);} {% endcomment %}
#creste-hib-{{ section.id }} .hib-inner{display:flex;flex-direction:column;gap:14px;}
#creste-hib-{{ section.id }} .hib-photo img,#creste-hib-{{ section.id }} .hib-photo .ph svg{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:16px;background:#eadfce;}
#creste-hib-{{ section.id }} .hib-content{padding:2px 6px 6px;}
#creste-hib-{{ section.id }} .hib-ct{margin:0 0 8px;font-family:'Fredoka One',cursive;font-weight:400;font-size:21px;line-height:1.2;color:#fff;}
#creste-hib-{{ section.id }} .hib-cb{margin:0;font-family:'Poppins',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:rgba(255,255,255,.95);}
#creste-hib-{{ section.id }} .hib-btns{display:flex;gap:8px;margin-top:14px; justify-content: center;}
#creste-hib-{{ section.id }} .hib-btn{background:#fff;color:#2B1702;border-radius:9999px;padding:10px 18px;font-family:'Nunito',sans-serif;font-weight:700;font-size:12px;text-decoration:none; width: 48%; text-align:center;}
#creste-hib-{{ section.id }} .hib-btn.alt{background:rgba(255,255,255,.15);color:#fff;border:1.5px solid rgba(255,255,255,.7);}
@media(min-width:750px){#creste-hib-{{ section.id }}{padding:40px 24px 90px;}#creste-hib-{{ section.id }} .hib-dog{width:{{ section.settings.dog_w }}px;}#creste-hib-{{ section.id }} .hib-h{font-size:48px;margin:0;}#creste-hib-{{ section.id }} .hib-card{padding:32px 64px;border-radius:32px;}#creste-hib-{{ section.id }} .hib-inner{flex-direction:row;align-items:center;gap:60px;}#creste-hib-{{ section.id }} .hib-photo{flex:0 0 33  %;}#creste-hib-{{ section.id }} .hib-photo img,#creste-hib-{{ section.id }} .hib-photo .ph svg{aspect-ratio:1/1;border-radius:20px;}#creste-hib-{{ section.id }} .hib-content{flex:1;padding:0;display: flex; flex-direction: column; gap: 24px;}#creste-hib-{{ section.id }} .hib-ct{font-size:40px;margin-bottom:16px;}#creste-hib-{{ section.id }} .hib-cb{font-size:20px;}
#creste-hib-{{ section.id }} .hib-dog.r{width: 130px;top: -4rem; right: 5%;}
#creste-hib-{{ section.id }} .hib-dog.l{width: 180px;top: -7rem; left: 0;z-index:1;}
#creste-hib-{{ section.id }} .hib-btns{flex-wrap: nowrap;}
#creste-hib-{{ section.id }} .hib-btn{width: 50%; text-align:center;font-size: 20px; font-weight: 800; letter-spacing: 0px;padding: 20px 48px;}

}
@media(max-width:750px){
 #creste-hib-{{ section.id }} .hib-dog{
  top: -2.5rem !important;
  
 }
 #creste-hib-{{ section.id }} .hib-dog.r{
  right: -10px;
  width: 50px !important;
} 
#creste-hib-{{ section.id }} .hib-dog.l{
  transform: rotate(90deg);
  left: -2rem;
  top: 3rem !important;
  width: 70px !important;
}
#creste-hib-{{ section.id }} .hib-content{
  padding: 0px !important;
}
#creste-hib-{{ section.id }} .hib-btn {
  padding: 5px 10px;
}
#creste-hib-{{ section.id }} .hib-top{top: 105px !important;}
#creste-hib-{{ section.id }} .hib-card {
        top: var(--card-top-mobile);
}
}
#creste-hib-{{ section.id }} .hib-top{
    position: sticky;
    top: 165px;
    {% comment %} z-index: 20; {% endcomment %}
    {% comment %} background: {{ section.settings.section_bg }}; {% endcomment %}
    padding: 22px 0;
    {% comment %} position: sticky; {% endcomment %}
}

#creste-hib-{{ section.id }} .hib-btn-a{
  color: #62A66B !important;
}
#creste-hib-{{ section.id }} .hib-btn-b{
  color: #fff !important;
  background: #F4793A !important;
}
</style>
{% comment %} {% render 'creste-bg', id: _bgid, d: section.settings.bg_desktop, m: section.settings.bg_mobile %} {% endcomment %}
<div id='creste-hib-{{ section.id }}' class='creste-section'>
{% comment %} {% if section.settings.dog_left != blank %}<div class='hib-dog l'><img src='{{ section.settings.dog_left | image_url: width: 400 }}' alt='' loading='lazy'></div>{% endif %}
{% if section.settings.dog_right != blank %}<div class='hib-dog r'><img src='{{ section.settings.dog_right | image_url: width: 400 }}' alt='' loading='lazy'></div>{% endif %} {% endcomment %}
<div class='hib-in'>
<div class="hib-top">
  {% if section.settings.dog_left != blank %}<div class='hib-dog l'><img src='{{ section.settings.dog_left | image_url: width: 400 }}' alt='' loading='lazy'></div>{% endif %}
{% if section.settings.heading != blank %}<h2 class='hib-h'>{{ section.settings.heading }}</h2>{% endif %}
{% if section.settings.dog_right != blank %}<div class='hib-dog r'><img src='{{ section.settings.dog_right | image_url: width: 400 }}' alt='' loading='lazy'></div>{% endif %}
</div>
<div class='hib-stack'>
{% comment %} {% for block in tiles %}{% assign toff = forloop.index0 | times: 16 | plus: section.settings.offset %}<div class='hib-card' style='top:{{ toff }}px;--tile:{{ block.settings.color }};' {{ block.shopify_attributes }}> {% endcomment %}
{% for block in tiles %}
  {% assign toff_desktop = forloop.index0 | times: 16 | plus: section.settings.offset_desktop %}
  {% assign toff_mobile = forloop.index0 | times: 16 | plus: section.settings.offset_mobile %}
   <div
    class='hib-card'
    style="
      --tile: {{ block.settings.color }};
      --card-top-desktop: {{ toff_desktop }}px;
      --card-top-mobile: {{ toff_mobile }}px;
    "
    {{ block.shopify_attributes }}
  >
<div class='hib-inner'>
<div class='hib-photo'>{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 900 }}' alt='{{ block.settings.heading | escape }}'>{% else %}<span class='ph'>{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>{% endif %}</div>
<div class='hib-content'><h3 class='hib-ct'>{{ block.settings.heading }}</h3><p class='hib-cb'>{{ block.settings.body | newline_to_br }}</p>{% if block.settings.btn1_label != blank or block.settings.btn2_label != blank %}<div class='hib-btns'>{% if block.settings.btn1_label != blank %}<a class='hib-btn hib-btn-a' href='{{ block.settings.btn1_link | default: '#' }}'>{{ block.settings.btn1_label }}</a>{% endif %}{% if block.settings.btn2_label != blank %}<a class='hib-btn hib-btn-b alt' href='{{ block.settings.btn2_link | default: '#' }}'>{{ block.settings.btn2_label }}</a>{% endif %}</div>{% endif %}</div>
</div>
</div>{% endfor %}
</div>
</div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const section = document.querySelector('#creste-hib-{{ section.id }}');

    if (!section) return;

    const cards = Array.from(
        section.querySelectorAll('.hib-card')
    );

    if (!cards.length) return;


    function lightenColor(hex, amount = 0.78) {

        hex = hex.replace('#', '').trim();

        if (hex.length === 3) {
            hex = hex.split('').map(c => c + c).join('');
        }

        const r = parseInt(hex.substring(0, 2), 16);
        const g = parseInt(hex.substring(2, 4), 16);
        const b = parseInt(hex.substring(4, 6), 16);

        const newR = Math.round(r + (255 - r) * amount);
        const newG = Math.round(g + (255 - g) * amount);
        const newB = Math.round(b + (255 - b) * amount);

        return `rgb(${newR}, ${newG}, ${newB})`;
    }


    function updateBackground() {

        /*
         * Exact vertical center of the viewport
         */
        const screenCenter = window.innerHeight / 2;

        let activeCard = null;

        cards.forEach(function (card) {

            const rect = card.getBoundingClientRect();

            /*
             * Is the CENTER of the screen
             * currently inside this card?
             */
            if (
                rect.top <= screenCenter &&
                rect.bottom >= screenCenter
            ) {
                activeCard = card;
            }

        });


        if (!activeCard) return;


        /*
         * Get card color from:
         *
         * --tile:{{ block.settings.color }}
         */
        const cardColor = getComputedStyle(activeCard)
            .getPropertyValue('--tile')
            .trim();


        if (!cardColor) return;


        /*
         * Make card color lighter
         */
        const lightColor = lightenColor(cardColor, 0.86);


        /*
         * Change main section background
         */
        section.style.backgroundColor = lightColor;

    }


    let ticking = false;

    window.addEventListener('scroll', function () {

        if (ticking) return;

        ticking = true;

        requestAnimationFrame(function () {

            updateBackground();

            ticking = false;

        });

    }, {
        passive: true
    });


    window.addEventListener('resize', updateBackground);


    /*
     * Initial check
     */
    updateBackground();

});
</script>
