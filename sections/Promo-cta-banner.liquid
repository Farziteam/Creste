{%- comment -%}
  ===== PROMO CTA BANNER =====
{%- endcomment -%}

{%- if section.settings.show_promo -%}

<section
  id="CrPromo-{{ section.id }}"
  class="cr-promo-section"
  style="
    --promo-bg: {{ section.settings.promo_bg }};
    --promo-bg-desktop: {% if section.settings.bg_desktop != blank %}url('{{ section.settings.bg_desktop | image_url: width: 1800 }}'){% else %}none{% endif %};
    --promo-bg-mobile: {% if section.settings.bg_mobile != blank %}url('{{ section.settings.bg_mobile | image_url: width: 1000 }}'){% else %}var(--promo-bg-desktop){% endif %};
    --promo-button-bg: {{ section.settings.button_bg }};
    --promo-button-color: {{ section.settings.button_text_color }};
  "
>
  <div class="cr-promo">

    <div class="cr-promo-left">

      <div class="cr-promo-ic">
        {%- if section.settings.promo_image != blank -%}

          {{
            section.settings.promo_image
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: section.settings.promo_title
          }}

        {%- else -%}

          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
          >
            <circle cx="12" cy="3.6" r="1" fill="#fff"/>
            <path
              d="M12 4.6v3"
              stroke="#fff"
              stroke-width="1.3"
              stroke-linecap="round"
            />
            <path
              d="M6.5 13v-1.2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2V13"
              stroke="#fff"
              stroke-width="1.3"
              stroke-linejoin="round"
            />
            <rect
              x="4.5"
              y="13"
              width="15"
              height="6.5"
              rx="1.5"
              stroke="#fff"
              stroke-width="1.3"
            />
            <path
              d="M4.5 16c1.1 0 1.1 1 2.2 1s1.1-1 2.2-1 1.1 1 2.2 1 1.1-1 2.2-1 1.1 1 2.2 1 1.1-1 2.2-1"
              stroke="#fff"
              stroke-width="1.3"
              stroke-linecap="round"
            />
          </svg>

        {%- endif -%}
      </div>

      <div class="cr-promo-content">

        {%- if section.settings.promo_title != blank -%}
          <p class="cr-promo-title">
            {{ section.settings.promo_title | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.promo_text != blank -%}
          <p class="cr-promo-text">
            {{ section.settings.promo_text | escape }}
          </p>
        {%- endif -%}

      </div>

    </div>

    {%- if section.settings.promo_button_label != blank -%}

      <a
        class="cr-promo-btn"
        href="{{ section.settings.promo_button_link | default: '#' }}"
      >
        {{ section.settings.promo_button_label | escape }}
      </a>

    {%- endif -%}

  </div>
</section>

{%- endif -%}


<style>

  #CrPromo-{{ section.id }} {
    background: var(--promo-bg);
    background-image: var(--promo-bg-desktop);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    width: 100%;
  }

  #CrPromo-{{ section.id }} .cr-promo {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 28px clamp(16px, 5vw, 80px);

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;
    flex-wrap: wrap;
  }

  #CrPromo-{{ section.id }} .cr-promo-left {
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 18px;
  }

  #CrPromo-{{ section.id }} .cr-promo-ic {
    width: 80px;
    height: 80px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.18);

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
    flex: 0 0 auto;
  }

  #CrPromo-{{ section.id }} .cr-promo-ic img {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  #CrPromo-{{ section.id }} .cr-promo-title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #fff;
    margin: 0;
  }

  #CrPromo-{{ section.id }} .cr-promo-text {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    margin: 4px 0 0;
  }

  #CrPromo-{{ section.id }} .cr-promo-btn {
    position: relative;
    z-index: 1;

    text-transform: uppercase;

    background: var(--promo-button-bg);
    color: var(--promo-button-color);

    border-radius: 14px;
    padding: 20px 55px;

    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 18px;

    letter-spacing: .04em;
    text-decoration: none;
    white-space: nowrap;

    transition: opacity .2s ease;
  }

  #CrPromo-{{ section.id }} .cr-promo-btn:hover {
    opacity: .9;
  }


  @media (max-width: 749px) {

    #CrPromo-{{ section.id }} {
      background-image: var(--promo-bg-mobile);
    }

    #CrPromo-{{ section.id }} .cr-promo {
      flex-direction: column;
      align-items: flex-start;

      gap: 16px;

      padding: 22px clamp(16px, 5vw, 40px);
    }

    #CrPromo-{{ section.id }} .cr-promo-left {
      flex-direction: row-reverse;
    }

    #CrPromo-{{ section.id }} .cr-promo-title {
      font-size: 18px;
    }

    #CrPromo-{{ section.id }} .cr-promo-text {
      font-size: 12px;
      line-height: 1.5;
    }

    #CrPromo-{{ section.id }} .cr-promo-btn {
      width: 100%;
      text-align: center;
      padding: 12px 15px;
      font-size: 15px;
    }

  }

</style>


{% schema %}
{
  "name": "Promo CTA Banner",
  "tag": "section",
  "class": "cr-promo-wrapper",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo banner",
      "default": true
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "default": "Creative fun delivered to your door"
    },

    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Description",
      "default": "Everything you need for hours of creative fun."
    },

    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Icon / Image"
    },

    {
      "type": "header",
      "content": "Button"
    },

    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Button label",
      "default": "Shop now"
    },

    {
      "type": "url",
      "id": "promo_button_link",
      "label": "Button link"
    },

    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#3D2817"
    },

    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "color",
      "id": "promo_bg",
      "label": "Background color",
      "default": "#35A9C9"
    },

    {
      "type": "image_picker",
      "id": "bg_desktop",
      "label": "Desktop background image"
    },

    {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Mobile background image"
    }

  ],

  "presets": [
    {
      "name": "Promo CTA Banner"
    }
  ]
}
{% endschema %}