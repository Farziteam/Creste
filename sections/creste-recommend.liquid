{%- comment -%} Creste — You may Also Like product carousel {%- endcomment -%}
{%- liquid
  assign uid = section.id
  assign coll = section.settings.collection
  if coll == blank and product.collections.size > 0
    assign coll = product.collections.first
  endif
-%}
<section id="CpdpRec-{{ uid }}" class="cpdprec" style="--cpdprec-bg: {{ section.settings.bg_color | default: '#F6B41D' }};">
  <div class="cpdprec__wrap">
    {%- if section.settings.promo_banner_desktop != blank or section.settings.promo_banner_mobile != blank or request.design_mode -%}
      <div class="cpdprec__promo-banner">
        {%- if section.settings.promo_banner_link != blank -%}<a href="{{ section.settings.promo_banner_link }}" class="cpdprec__promo-link">{%- endif -%}
          {%- if section.settings.promo_banner_desktop != blank -%}
            {{ section.settings.promo_banner_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'cpdprec__promo-img cpdprec__promo-img--desktop', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdprec__promo-img cpdprec__promo-img--desktop cpdprec__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdprec__promo-ph-svg' }}<span class="cpdprec__promo-ph-label">Desktop banner — upload in section settings</span></div>
          {%- endif -%}
          {%- if section.settings.promo_banner_mobile != blank -%}
            {{ section.settings.promo_banner_mobile | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'cpdprec__promo-img cpdprec__promo-img--mobile', alt: section.settings.promo_banner_alt }}
          {%- elsif request.design_mode -%}
            <div class="cpdprec__promo-img cpdprec__promo-img--mobile cpdprec__promo-ph">{{ 'lifestyle-1' | placeholder_svg_tag: 'cpdprec__promo-ph-svg' }}<span class="cpdprec__promo-ph-label">Mobile banner — upload in section settings</span></div>
          {%- endif -%}
        {%- if section.settings.promo_banner_link != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="cpdprec__head">
      <h2 class="cpdprec__title">{{ section.settings.heading_prefix | default: 'You may Also' }} <span class="cpdprec__hl">{{ section.settings.heading_highlight | default: 'Like' }}</span></h2>
      {%- if section.settings.subheading != blank -%}<p class="cpdprec__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="cpdprec__scroller">
      <button type="button" class="cpdprec__nav cpdprec__nav--prev" aria-label="Previous"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="cpdprec__track">
        {%- if coll != blank -%}
          {%- for card in coll.products limit: 12 -%}
            {%- assign cv = card.selected_or_first_available_variant -%}
            <div class="cpdprec__card">
              <a href="{{ card.url }}" class="cpdprec__media">
                {%- if card.featured_media -%}{{ card.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', class: 'cpdprec__img', alt: card.title }}{%- else -%}<div class="cpdprec__img cpdprec__img--ph"></div>{%- endif -%}
                <span class="cpdprec__rating">★ 4.9</span>
                {%- if card.tags contains 'top-pick' or forloop.first -%}<span class="cpdprec__pick">★ TOP PICK</span>{%- endif -%}
              </a>
              <div class="cpdprec__body">
                <a href="{{ card.url }}" class="cpdprec__name">{{ card.title }}</a>
                <p class="cpdprec__meta">{{ card.type | default: 'Creative kit' }}</p>
                <div class="cpdprec__price">
                  <span class="cpdprec__price-now">{{ cv.price | money }}</span>
                  {%- if cv.compare_at_price > cv.price -%}<span class="cpdprec__price-was">{{ cv.compare_at_price | money }}</span><span class="cpdprec__price-off">{{ cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price | round }}% off</span>{%- endif -%}
                </div>
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ cv.id }}">
                  <button type="submit" class="cpdprec__atc"{% unless cv.available %} disabled{% endunless %}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> {% if cv.available %}Add To Cart{% else %}Sold out{% endif %}</button>
                </form>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <p style="color:#fff;padding:20px;">Assign this product to a collection (or pick one in the section settings) to show recommendations.</p>
        {%- endif -%}
      </div>
      <button type="button" class="cpdprec__nav cpdprec__nav--next" aria-label="Next"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div>
</section>
<style>
  #CpdpRec-{{ uid }}{--cpdprec-orange:#F26E21;--cpdprec-brown:#3D2817;
    --cpdprec-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdprec-body: var(--font-body-family, 'Poppins',system-ui,sans-serif);
    background:var(--cpdprec-bg);font-family:var(--cpdprec-body);}
  #CpdpRec-{{ uid }} *{box-sizing:border-box;}
  #CpdpRec-{{ uid }} .cpdprec__wrap{max-width:1240px;margin:0 auto;padding:{{ section.settings.padding_top | default: 56 }}px 20px {{ section.settings.padding_bottom | default: 60 }}px;}
  #CpdpRec-{{ uid }} .cpdprec__promo-banner{width:100%;margin:0 0 28px;border-radius:20px;overflow:hidden;}
  #CpdpRec-{{ uid }} .cpdprec__promo-link{display:block;}
  #CpdpRec-{{ uid }} .cpdprec__promo-img{display:block;width:100%;height:auto;}
  #CpdpRec-{{ uid }} .cpdprec__promo-img--mobile{display:none;}
  #CpdpRec-{{ uid }} .cpdprec__promo-ph{position:relative;aspect-ratio:4/1;background:rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;}
  #CpdpRec-{{ uid }} .cpdprec__promo-img--mobile.cpdprec__promo-ph{aspect-ratio:3/4;}
  #CpdpRec-{{ uid }} .cpdprec__promo-ph-svg{position:absolute;inset:0;width:100%;height:100%;opacity:.5;}
  #CpdpRec-{{ uid }} .cpdprec__promo-ph-label{position:relative;z-index:1;font-weight:700;font-size:13px;color:var(--cpdprec-brown);background:rgba(255,255,255,.9);padding:6px 14px;border-radius:999px;}
  @media (max-width:749px){
    #CpdpRec-{{ uid }} .cpdprec__promo-img--desktop{display:none;}
    #CpdpRec-{{ uid }} .cpdprec__promo-img--mobile{display:block;}
  }
  #CpdpRec-{{ uid }} .cpdprec__title{font-family:var(--cpdprec-head);font-weight:800;font-size:clamp(30px,4vw,50px);color:var(--cpdprec-brown);margin:0 0 8px;}
  #CpdpRec-{{ uid }} .cpdprec__hl{color:#fff;}
  #CpdpRec-{{ uid }} .cpdprec__sub{font-size:clamp(16px,1.6vw,20px);color:var(--cpdprec-brown);margin:0 0 26px;}
  #CpdpRec-{{ uid }} .cpdprec__scroller{position:relative;}
  #CpdpRec-{{ uid }} .cpdprec__track{display:flex;gap:20px;overflow-x:auto;scroll-behavior:smooth;padding:6px 2px 10px;scrollbar-width:none;}
  #CpdpRec-{{ uid }} .cpdprec__track::-webkit-scrollbar{display:none;}
  #CpdpRec-{{ uid }} .cpdprec__card{flex:0 0 300px;background:#fff;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 6px 16px rgba(0,0,0,.08);}
  #CpdpRec-{{ uid }} .cpdprec__media{position:relative;display:block;aspect-ratio:1/1;background:#F3EEE6;}
  #CpdpRec-{{ uid }} .cpdprec__img{width:100%;height:100%;object-fit:cover;}
  #CpdpRec-{{ uid }} .cpdprec__img--ph{width:100%;height:100%;background:linear-gradient(135deg,#F0E7DA,#E6D7C2);}
  #CpdpRec-{{ uid }} .cpdprec__rating{position:absolute;left:14px;bottom:-14px;background:#FBF3D9;color:#7a5b00;font-weight:700;font-size:13px;padding:6px 12px;border-radius:999px;box-shadow:0 2px 6px rgba(0,0,0,.1);}
  #CpdpRec-{{ uid }} .cpdprec__pick{position:absolute;right:14px;bottom:-14px;background:#FBD9DE;color:#C0392B;font-weight:700;font-size:12px;padding:6px 12px;border-radius:999px;box-shadow:0 2px 6px rgba(0,0,0,.1);}
  #CpdpRec-{{ uid }} .cpdprec__body{padding:24px 18px 18px;display:flex;flex-direction:column;gap:6px;}
  #CpdpRec-{{ uid }} .cpdprec__name{font-family:var(--cpdprec-head);font-weight:800;font-size:20px;color:var(--cpdprec-brown);text-decoration:none;}
  #CpdpRec-{{ uid }} .cpdprec__meta{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#8a8f98;margin:0;}
  #CpdpRec-{{ uid }} .cpdprec__price{display:flex;align-items:baseline;gap:8px;margin:6px 0 12px;}
  #CpdpRec-{{ uid }} .cpdprec__price-now{font-weight:800;font-size:20px;color:var(--cpdprec-orange);}
  #CpdpRec-{{ uid }} .cpdprec__price-was{font-size:14px;color:#9aa0a6;text-decoration:line-through;}
  #CpdpRec-{{ uid }} .cpdprec__price-off{font-size:13px;font-weight:700;color:#16A34A;}
  #CpdpRec-{{ uid }} .cpdprec__atc{width:100%;border:none;border-radius:12px;background:var(--cpdprec-orange);color:#fff;font-family:var(--cpdprec-head);font-weight:700;font-size:16px;padding:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;}
  #CpdpRec-{{ uid }} .cpdprec__atc[disabled]{background:#c7c2ba;cursor:not-allowed;}
  #CpdpRec-{{ uid }} .cpdprec__nav{position:absolute;top:38%;transform:translateY(-50%);z-index:2;width:44px;height:44px;border:none;border-radius:999px;background:#fff;color:var(--cpdprec-orange);cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.15);display:grid;place-items:center;}
  #CpdpRec-{{ uid }} .cpdprec__nav--prev{left:-10px;}
  #CpdpRec-{{ uid }} .cpdprec__nav--next{right:-10px;}
  @media (max-width:600px){ #CpdpRec-{{ uid }} .cpdprec__card{flex:0 0 76vw;} #CpdpRec-{{ uid }} .cpdprec__nav{display:none;} }
</style>
<script>
  (function(){
    var root=document.getElementById('CpdpRec-{{ uid }}'); if(!root) return;
    var track=root.querySelector('.cpdprec__track');
    var prev=root.querySelector('.cpdprec__nav--prev'), next=root.querySelector('.cpdprec__nav--next');
    function step(dir){ track.scrollBy({left:dir*320,behavior:'smooth'}); }
    if(prev)prev.addEventListener('click',function(){step(-1);});
    if(next)next.addEventListener('click',function(){step(1);});
  })();
</script>
{% schema %}
{
  "name": "Creste You May Also Like",
  "tag": "section",
  "class": "creste-recommend-section",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Heading (dark)", "default": "You may Also" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (white)", "default": "Like" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Grab 'em before they disappear!" },
    { "type": "collection", "id": "collection", "label": "Products from collection (blank = product's collection)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6B41D" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "header", "content": "Promo Banner (optional)" },
    { "type": "image_picker", "id": "promo_banner_desktop", "label": "Banner image — Desktop", "info": "Recommended 2000×500px" },
    { "type": "image_picker", "id": "promo_banner_mobile", "label": "Banner image — Mobile", "info": "Recommended 1000×1300px" },
    { "type": "url", "id": "promo_banner_link", "label": "Banner link (optional)" },
    { "type": "text", "id": "promo_banner_alt", "label": "Banner alt text" }
  ],
  "presets": [ { "name": "Creste You May Also Like" } ]
}
{% endschema %}
