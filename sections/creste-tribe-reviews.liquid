{{ 'https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600&family=Fredoka+One&family=Quicksand:wght@500;600;700&display=swap' | stylesheet_tag }}

<section class="tribe-reviews" id="tribe-reviews-{{ section.id }}">
  <div class="tribe-reviews__wrap">
    <p class="tribe-reviews__eyebrow">{{ section.settings.eyebrow | default: 'Verified buyers' }}</p>
    <h2 class="tribe-reviews__h2">{{ section.settings.heading | default: 'What the #CresteTribe says' }}</h2>
    <p class="tribe-reviews__sub">{{ section.settings.subheading | default: 'Every review below comes from a confirmed order. Scroll for more.' }}</p>
    <div class="tribe-reviews__scroll" tabindex="0" aria-label="Customer reviews, scrollable">
      {% assign colors = 'F4793A,3AACCC,5BAD6F,9B7FD4,E87BAC,F7CB45' | split: ',' %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          {% assign c_idx = forloop.index0 | modulo: 6 %}
          {% assign c = colors[c_idx] %}
          <article class="tribe-reviews__card" style="--accent-c:#{{ c }}" {{ block.shopify_attributes }}>
            <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <div class="tribe-reviews__foot">
              <span class="tribe-reviews__name">{{ block.settings.author }}</span>
              <span class="tribe-reviews__stars" aria-label="{{ block.settings.rating }} out of 5">
                {% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}
              </span>
              <span class="tribe-reviews__badge">{{ block.settings.badge }}</span>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
#tribe-reviews-{{ section.id }}{
  --cream:#F5F1EB; --white:#FFFFFF; --ink:#3B2D22; --body:#7A5C3E; --body-soft:#96826C; --line:#E6DDD1;
  --orange:#F4793A; --orange-dk:#DC6329; --yellow:#F7CB45;
  --f-display:'Nunito','Trebuchet MS',sans-serif; --f-body:'Poppins','Helvetica Neue',sans-serif; --f-ui:'Quicksand','Nunito',sans-serif;
  --maxw:1280px; --pad:clamp(1.1rem,4vw,3.5rem); --sec:clamp(3.5rem,7vw,6.5rem); --r-md:22px;
  --shadow:0 10px 30px rgba(122,92,62,.10);
  background:var(--cream);padding-block:var(--sec);font-family:var(--f-body);
}
#tribe-reviews-{{ section.id }} *{box-sizing:border-box}
#tribe-reviews-{{ section.id }} .tribe-reviews__wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:var(--pad)}
#tribe-reviews-{{ section.id }} .tribe-reviews__eyebrow{
  font-family:var(--f-ui);font-weight:700;font-size:.74rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--orange);margin:0 0 .7rem
}
#tribe-reviews-{{ section.id }} .tribe-reviews__h2{
  font-family:var(--f-display);font-weight:800;line-height:1.12;margin:0;color:var(--ink);
  font-size:clamp(1.85rem,3.7vw,3.1rem)
}
#tribe-reviews-{{ section.id }} .tribe-reviews__h2 span{color:#3AACCC}
#tribe-reviews-{{ section.id }} .tribe-reviews__sub{color:var(--body-soft);margin:.7rem 0 0;max-width:58ch}
#tribe-reviews-{{ section.id }} .tribe-reviews__scroll{
  margin-top:2.2rem;max-height:clamp(420px,58vh,600px);overflow-y:auto;
  padding:.35rem 1rem .35rem .1rem;
  scrollbar-width:thin;scrollbar-color:var(--orange) transparent;
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%);
          mask-image:linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%);
}
#tribe-reviews-{{ section.id }} .tribe-reviews__scroll::-webkit-scrollbar{width:9px}
#tribe-reviews-{{ section.id }} .tribe-reviews__scroll::-webkit-scrollbar-track{background:rgba(255,255,255,.7);border-radius:99px}
#tribe-reviews-{{ section.id }} .tribe-reviews__scroll::-webkit-scrollbar-thumb{background:var(--orange);border-radius:99px}
#tribe-reviews-{{ section.id }} .tribe-reviews__card{
  background:var(--white);border-radius:var(--r-md);
  padding:clamp(1.3rem,2.4vw,2rem);margin-bottom:1.15rem;box-shadow:var(--shadow);
  border-top:5px solid var(--accent-c,var(--orange))
}
#tribe-reviews-{{ section.id }} .tribe-reviews__card p{margin:0 0 1.05rem;font-size:1rem;color:var(--body)}
#tribe-reviews-{{ section.id }} .tribe-reviews__foot{display:flex;align-items:center;gap:.9rem;flex-wrap:wrap;
  border-top:1px solid var(--line);padding-top:.85rem}
#tribe-reviews-{{ section.id }} .tribe-reviews__name{font-family:var(--f-display);font-weight:800;color:var(--ink)}
#tribe-reviews-{{ section.id }} .tribe-reviews__stars{color:var(--yellow);letter-spacing:3px;font-size:1.05rem}
#tribe-reviews-{{ section.id }} .tribe-reviews__badge{
  margin-left:auto;font-family:var(--f-ui);font-weight:600;font-size:.75rem;
  padding:.28rem .7rem;border-radius:999px;background:var(--cream);color:var(--body)
}
@media(max-width:640px){#tribe-reviews-{{ section.id }} .tribe-reviews__badge{margin-left:0;width:100%}}
</style>

{% schema %}
{
  "name": "Tribe Reviews",
  "tag": "section",
  "class": "section-tribe-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Verified buyers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What the #CresteTribe says"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every review below comes from a confirmed order. Scroll for more."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Verified purchase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tribe Reviews"
    }
  ]
}
{% endschema %}
