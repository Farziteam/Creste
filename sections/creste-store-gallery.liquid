<section id="store-gallery-{{ section.id }}" class="store-gallery">
  <div class="store-gallery__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="store-gallery__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="store-gallery__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="store-gallery__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="store-gallery__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            <div class="store-gallery__tile store-gallery__tile--{{ forloop.index }} store-gallery__tile--{{ block.settings.color }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'store-gallery__tile-img', sizes: '(min-width: 750px) 33vw, 100vw' }}
              {%- else -%}
                <span class="store-gallery__tile-circle" aria-hidden="true"></span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="store-gallery__tile-label">
                  <span class="store-gallery__tile-dot" aria-hidden="true"></span>{{ block.settings.label }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #store-gallery-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #store-gallery-{{ section.id }} .store-gallery__inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; text-align: center; }
  #store-gallery-{{ section.id }} .store-gallery__eyebrow { margin: 0; font-family: 'Quicksand', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #f4793a; }
  #store-gallery-{{ section.id }} .store-gallery__heading { margin: 8px 0 0; color: #2c2a27; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.5px; }
  #store-gallery-{{ section.id }} .store-gallery__subheading { margin: 12px auto 0; max-width: 560px; color: #6e6a64; font-family: 'Poppins', sans-serif; font-size: 15.5px; line-height: 1.6; }
  #store-gallery-{{ section.id }} .store-gallery__grid { margin-top: 36px; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 140px) 140px; gap: 8px; text-align: left; }
  #store-gallery-{{ section.id }} .store-gallery__tile { position: relative; border-radius: 4px; overflow: hidden; }
  #store-gallery-{{ section.id }} .store-gallery__tile-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #store-gallery-{{ section.id }} .store-gallery__tile--1 { grid-column: 1 / 3; grid-row: 1 / 3; }
  #store-gallery-{{ section.id }} .store-gallery__tile--2 { grid-column: 3; grid-row: 1; }
  #store-gallery-{{ section.id }} .store-gallery__tile--3 { grid-column: 3; grid-row: 2; }
  #store-gallery-{{ section.id }} .store-gallery__tile--4,
  #store-gallery-{{ section.id }} .store-gallery__tile--5,
  #store-gallery-{{ section.id }} .store-gallery__tile--6 { grid-row: 3; }
  #store-gallery-{{ section.id }} .store-gallery__tile--peach { background: #f7ded0; }
  #store-gallery-{{ section.id }} .store-gallery__tile--blue { background: #d9edf3; }
  #store-gallery-{{ section.id }} .store-gallery__tile--green { background: #dcecdf; }
  #store-gallery-{{ section.id }} .store-gallery__tile--purple { background: #e5dcf5; }
  #store-gallery-{{ section.id }} .store-gallery__tile--yellow { background: #f7ecc7; }
  #store-gallery-{{ section.id }} .store-gallery__tile--pink { background: #f8dce8; }
  #store-gallery-{{ section.id }} .store-gallery__tile-circle { position: absolute; left: 50%; top: 50%; width: 62%; aspect-ratio: 1; border-radius: 50%; background: rgba(44, 42, 39, 0.08); transform: translate(-50%, -50%); }
  #store-gallery-{{ section.id }} .store-gallery__tile--1 .store-gallery__tile-circle { width: 46%; }
  #store-gallery-{{ section.id }} .store-gallery__tile-label { position: absolute; left: 14px; bottom: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.85); color: #2c2a27; font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 500; }
  #store-gallery-{{ section.id }} .store-gallery__tile-dot { width: 6px; height: 6px; border-radius: 50%; background: #f4793a; }
  @media screen and (max-width: 749px) {
    #store-gallery-{{ section.id }} { display: none; }
  }
</style>

{% schema %}
{
  "name": "Store Gallery",
  "tag": "section",
  "class": "section-store-gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Step inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A peek inside our studio" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Bright craft tables, shelves of kits, and a workshop corner where the magic happens." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F7F4EF" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "paragraph", "content": "This section is hidden on mobile to match the mobile layout, which shows Workshops & Events instead." }
  ],
  "blocks": [
    { "type": "tile", "name": "Photo tile", "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "label", "label": "Caption", "default": "Caption" },
        { "type": "select", "id": "color", "label": "Placeholder color", "options": [
            { "value": "peach", "label": "Peach" }, { "value": "blue", "label": "Blue" }, { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }, { "value": "yellow", "label": "Yellow" }, { "value": "pink", "label": "Pink" }
          ], "default": "peach" }
      ] }
  ],
  "presets": [
    { "name": "Store Gallery", "blocks": [
        { "type": "tile", "settings": { "label": "the craft table", "color": "peach" } },
        { "type": "tile", "settings": { "label": "kit shelves", "color": "blue" } },
        { "type": "tile", "settings": { "label": "workshop corner", "color": "green" } },
        { "type": "tile", "settings": { "label": "story-time nook", "color": "purple" } },
        { "type": "tile", "settings": { "label": "the paint bar", "color": "yellow" } },
        { "type": "tile", "settings": { "label": "gifting counter", "color": "pink" } }
      ] }
  ]
}
{% endschema %}
