{%- assign fw = section.settings.full_width -%}
<style>
#creste-bb-{{ section.id }}{padding:{{ section.settings.padding_top }}px {% if fw %}0{% else %}16px{% endif %} {{ section.settings.padding_bottom }}px;background:{{ section.settings.section_bg }};}
#creste-bb-{{ section.id }} .bb-inner{max-width:{% if fw %}100%{% else %}{{ section.settings.max_width }}px{% endif %};margin:0 auto;}
#creste-bb-{{ section.id }} a{display:block;}
#creste-bb-{{ section.id }} img,#creste-bb-{{ section.id }} .bb-ph svg{display:block;width:100%;height:auto;border-radius:{% if fw %}0{% else %}{{ section.settings.radius }}px{% endif %};}
#creste-bb-{{ section.id }} .bb-m{display:none;}
@media(max-width:749px){#creste-bb-{{ section.id }}.has-m .bb-d{display:none;}#creste-bb-{{ section.id }}.has-m .bb-m{display:block;}}
</style>
<div id='creste-bb-{{ section.id }}' class='creste-section{% if section.settings.image_mobile != blank %} has-m{% endif %}'>
<div class='bb-inner'>
{% if section.settings.link != blank %}<a href='{{ section.settings.link }}'>{% endif %}
{% if section.settings.image != blank %}<img class='bb-d' src='{{ section.settings.image | image_url: width: 2400 }}' alt='{{ section.settings.alt | escape }}' loading='lazy'>{% else %}<div class='bb-ph'>{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endif %}
{% if section.settings.image_mobile != blank %}<img class='bb-m' src='{{ section.settings.image_mobile | image_url: width: 1200 }}' alt='{{ section.settings.alt | escape }}' loading='lazy'>{% endif %}
{% if section.settings.link != blank %}</a>{% endif %}
</div>
</div>
{% schema %}
{
  "name": "Build Your Own Box",
  "tag": "section",
  "settings": [ {"type":"image_picker","id":"image","label":"Banner image"}, {"type":"image_picker","id":"image_mobile","label":"Mobile banner (optional)"}, {"type":"url","id":"link","label":"Link (optional)"}, {"type":"text","id":"alt","label":"Alt text","default":"Build your own box"}, {"type":"checkbox","id":"full_width","label":"Full width (edge to edge)","default":true}, {"type":"color","id":"section_bg","label":"Section background","default":"#FFFFFF"}, {"type":"range","id":"max_width","min":600,"max":1600,"step":20,"unit":"px","label":"Max width (when not full width)","default":1200}, {"type":"range","id":"radius","min":0,"max":48,"step":2,"unit":"px","label":"Corner radius (when not full width)","default":24}, {"type":"range","id":"padding_top","min":0,"max":80,"step":2,"unit":"px","label":"Padding top","default":16}, {"type":"range","id":"padding_bottom","min":0,"max":80,"step":2,"unit":"px","label":"Padding bottom","default":16} ],
  "presets": [ {"name":"Build Your Own Box"} ]
}
{% endschema %}