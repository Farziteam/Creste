{{ 'https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600&family=Fredoka+One&family=Quicksand:wght@500;600;700&display=swap' | stylesheet_tag }}

<section class="tribe-journey" id="tribe-journey-{{ section.id }}">
  <div class="tribe-journey__wrap">
    <p class="tribe-journey__eyebrow">{{ section.settings.eyebrow | default: 'Milestones' }}</p>
    <h2 class="tribe-journey__h2">{{ section.settings.heading | default: 'Our Journey' }}</h2>
    <div class="tribe-journey__grid">
      {% assign colors = 'F4793A,3AACCC,5BAD6F,9B7FD4,E87BAC,F7CB45' | split: ',' %}
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          {% assign c_idx = forloop.index0 | modulo: 6 %}
          {% assign c = colors[c_idx] %}
          <div class="tribe-journey__stat" style="--accent-c:#{{ c }}" {{ block.shopify_attributes }}>
            <div class="tribe-journey__num" data-n="{{ block.settings.number }}" data-suf="{{ block.settings.suffix }}" data-dec="{{ block.settings.decimals }}">0</div>
            <p class="tribe-journey__label">{{ block.settings.label }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
#tribe-journey-{{ section.id }}{
  --cream:#F5F1EB; --white:#FFFFFF; --ink:#3B2D22; --brown:#7A5C3E; --line:#E6DDD1; --orange:#F4793A;
  --f-display:'Nunito','Trebuchet MS',sans-serif; --f-ui:'Quicksand','Nunito',sans-serif; --f-body:'Poppins','Helvetica Neue',sans-serif;
  --maxw:1280px; --pad:clamp(1.1rem,4vw,3.5rem); --sec:clamp(3.5rem,7vw,6.5rem); --r-lg:30px;
  --shadow:0 10px 30px rgba(122,92,62,.10);
  background:var(--cream);padding-block:var(--sec);font-family:var(--f-body);
}
#tribe-journey-{{ section.id }} *{box-sizing:border-box}
#tribe-journey-{{ section.id }} .tribe-journey__wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:var(--pad)}
#tribe-journey-{{ section.id }} .tribe-journey__eyebrow{
  font-family:var(--f-ui);font-weight:700;font-size:.74rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--orange);margin:0 0 .7rem
}
#tribe-journey-{{ section.id }} .tribe-journey__h2{
  font-family:var(--f-display);font-weight:800;line-height:1.12;margin:0;color:var(--ink);
  font-size:clamp(1.85rem,3.7vw,3.1rem)
}
#tribe-journey-{{ section.id }} .tribe-journey__grid{display:grid;gap:1.1rem;margin-top:2.5rem;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
#tribe-journey-{{ section.id }} .tribe-journey__stat{
  background:var(--white);border-radius:var(--r-lg);
  padding:clamp(1.8rem,3vw,2.8rem) 1.2rem;text-align:center;
  border:2px solid var(--line);border-bottom:6px solid var(--accent-c,var(--orange));
  transition:.25s ease
}
#tribe-journey-{{ section.id }} .tribe-journey__stat:hover{transform:translateY(-5px) rotate(-1deg);box-shadow:var(--shadow)}
#tribe-journey-{{ section.id }} .tribe-journey__num{font-family:var(--f-display);font-weight:900;color:var(--accent-c,var(--orange));
  font-size:clamp(1.9rem,3.6vw,3rem);line-height:1}
#tribe-journey-{{ section.id }} .tribe-journey__label{margin:.6rem 0 0;font-family:var(--f-ui);font-weight:700;color:var(--brown)}
</style>

<script>
(function(){
  var root = document.getElementById('tribe-journey-{{ section.id }}');
  if(!root) return;
  var nodes = root.querySelectorAll('.tribe-journey__num');
  function run(node){
    var end = parseFloat(node.dataset.n) || 0;
    var dec = parseInt(node.dataset.dec, 10) || 0;
    var suf = node.dataset.suf || '';
    var dur = 1500, t0 = null;
    function fmt(v){ return dec ? v.toFixed(dec) : Math.floor(v).toLocaleString('en-IN'); }
    function tick(ts){
      if(!t0) t0 = ts;
      var p = Math.min((ts - t0) / dur, 1);
      node.textContent = fmt(end * (1 - Math.pow(1 - p, 3))) + suf;
      if(p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ run(e.target); io.unobserve(e.target); } });
    }, {threshold: .5});
    nodes.forEach(function(n){ io.observe(n); });
  } else {
    nodes.forEach(run);
  }
})();
</script>

{% schema %}
{
  "name": "Tribe Journey",
  "tag": "section",
  "class": "section-tribe-journey",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Milestones"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Number",
          "default": 0
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "decimals",
          "label": "Decimal places (0 or 1)",
          "default": "0"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tribe Journey"
    }
  ]
}
{% endschema %}
