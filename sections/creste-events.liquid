{% render 'creste-tokens' %}
{%- assign _bgid = 'creste-ev-' | append: section.id -%}
<style>
#creste-ev-{{ section.id }}{padding:28px 0;background:{{ section.settings.section_bg }};background-size:cover;background-position:center;}
#creste-ev-{{ section.id }} .ev-wrap{background:#fff;border-radius:28px;width:94%;max-width:1560px;margin:0 auto;padding:22px 16px;display:flex;flex-direction:column;gap:20px;}
#creste-ev-{{ section.id }} .ev-h{margin:0;text-align:center;font-family:'Nunito',sans-serif;font-weight:900;font-size:26px;line-height:1;letter-spacing:0px; color:#2B1702;}
#creste-ev-{{ section.id }} .ev-h em{font-style:normal;color:#E87BAC;}
#creste-ev-{{ section.id }} .ev-sub{margin:-4px 0 0;text-align:center;font-family:'Poppins',sans-serif;font-weight:500;font-size:15px;line-height:1.5;color:var(--creste-brown);}
#creste-ev-{{ section.id }} .ev-do{overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity;}
#creste-ev-{{ section.id }} .ev-do::-webkit-scrollbar{display:none;}
#creste-ev-{{ section.id }} .ev-do-track{display:flex;gap:18px;width:max-content;padding:10px 2px;}
#creste-ev-{{ section.id }} .flip{width:170px;height:200px;flex:0 0 auto;perspective:1000px;background:transparent;border:0;padding:0;cursor:pointer;scroll-snap-align:start;}
#creste-ev-{{ section.id }} .flip-in{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d;}
#creste-ev-{{ section.id }} .flip:hover .flip-in,#creste-ev-{{ section.id }} .flip:focus-within .flip-in{transform:rotateY(180deg);}
#creste-ev-{{ section.id }} .flip-f,#creste-ev-{{ section.id }} .flip-b{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:20px;overflow:hidden;}
#creste-ev-{{ section.id }} .flip-f{background:#fff;border:1px solid #EEE7DA;box-shadow:0 4px 10px rgba(38,32,25,.06);display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;padding:18px 14px;text-align:center;}
#creste-ev-{{ section.id }} .flip-ic{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;}
#creste-ev-{{ section.id }} .flip-ic img{width:32px;height:32px;object-fit:contain;}
#creste-ev-{{ section.id }} .flip-t{font-family:'Poppins',sans-serif;font-weight:600;font-size:15px;line-height:1.2;color:#262019;margin:0;}
#creste-ev-{{ section.id }} .flip-d{font-family:'Poppins',sans-serif;font-weight:500;font-size:12px;line-height:1.5;color:#6B6258;margin:0;}
#creste-ev-{{ section.id }} .flip-b{transform:rotateY(180deg);background:#8a6d54;}
#creste-ev-{{ section.id }} .flip-b img{width:100%;height:100%;object-fit:cover;}
#creste-ev-{{ section.id }} .flip-b .cap{position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Poppins',sans-serif;font-weight:600;font-size:15px;text-align:center;padding:12px;}
#creste-ev-{{ section.id }} .ev-hint{text-align:center;font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;color:#6B6258;margin:-4px 0 0; display: flex; justify-content: center; align-items:center; gap: 10px;}
#creste-ev-{{ section.id }} .act-box{display:flex;flex-direction:column;gap:0;}
#creste-ev-{{ section.id }} .act-label{width:100%;background:#B94A75;border-radius:16px 16px 0 0;color:#FEE900;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:8px;text-align:center;padding:12px 10px;}
#creste-ev-{{ section.id }} .act-label .big{font-family:'Poppins',sans-serif;font-weight:800;font-size:22px;line-height:1.1;}
#creste-ev-{{ section.id }} .act-label .sm{font-family:'Poppins',sans-serif;font-weight:500;font-size:16px;line-height:1.2;}
#creste-ev-{{ section.id }} .act-right{width:100%;overflow:hidden;display:flex;align-items:center;border:1.33px solid #E9DCC7;border-top:0;border-radius:0 0 16px 16px;background:#fff;padding:12px 0;/*-webkit-mask:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent);mask:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent);*/}
#creste-ev-{{ section.id }} .act-track{display:flex;gap:14px;width:max-content;animation:ev-mq var(--aspd,26s) linear infinite;}
#creste-ev-{{ section.id }} .act-right:hover .act-track{animation-play-state:paused;}
#creste-ev-{{ section.id }} .act-item{width:108px;flex:0 0 auto;text-align:center;}
#creste-ev-{{ section.id }} .act-c{width:58px;height:58px;margin:0 auto;border-radius:50%;border:1.33px solid #E9DCC7;background:#F4E7D3;overflow:hidden;}
#creste-ev-{{ section.id }} .act-c img{width:100%;height:100%;object-fit:cover;}
#creste-ev-{{ section.id }} .act-l{margin:6px 0 0;font-family:'Poppins',sans-serif;font-weight:600;font-size:11px;color:#262019;}
#creste-ev-{{ section.id }} .form-box{background:#D8EEF5;border:1.33px solid #E9DCC7;border-radius:24px;box-shadow:0 10px 26px rgba(38,32,25,.05);padding:20px 16px;width:100%;}
#creste-ev-{{ section.id }} .form-h{margin:0 0 16px;text-align:center;font-family:'Nunito',sans-serif;font-weight:900;font-size:22px;line-height:1.2;color:#2B1702;}
#creste-ev-{{ section.id }} .form-h em{font-style:normal;color:var(--creste-teal);}
#creste-ev-{{ section.id }} form .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
#creste-ev-{{ section.id }} form .m-full{grid-column:1 / -1;}
#creste-ev-{{ section.id }} form label{display:block;margin:0 0 6px;font-family:'Poppins',sans-serif;font-weight:600;font-size:12px;color:#1c1c16;}
#creste-ev-{{ section.id }} form input,#creste-ev-{{ section.id }} form textarea{width:100%;border:1px solid #d8d8d8;border-radius:8px;padding:10px 12px;font-family:'Poppins',sans-serif;font-size:14px;background:#fff;color:#000;}
#creste-ev-{{ section.id }} form input{height:49px;}
#creste-ev-{{ section.id }} .form-btn{margin:16px auto 0;display:block;width:100%;max-width:380px;height:48px;border:none;border-radius:9999px;background:var(--creste-orange);color:#fff;font-family:'Nunito',sans-serif;font-weight:700;font-size:16px;cursor:pointer;}
#creste-ev-{{ section.id }} .form-note{margin:8px 0 0;text-align:center;font-family:'Nunito',sans-serif;font-weight:500;font-size:11px;color: #000000D9; letter-spacing: 0px;}
#creste-ev-{{ section.id }} .form-ok{background:#e3f6e8;border:1px solid #57b26f;color:#256b39;border-radius:10px;padding:10px 12px;margin-bottom:12px;font-family:'Poppins',sans-serif;font-size:13px;}
@keyframes ev-mq{to{transform:translateX(-50%);}}
@media(min-width:750px){#creste-ev-{{ section.id }}{padding:44px 0;}#creste-ev-{{ section.id }} .ev-wrap{width:90%;padding:32px 32px;}#creste-ev-{{ section.id }} .ev-h{font-size:80px;line-height:0.9;}#creste-ev-{{ section.id }} .flip{width:230px;height:290px;}#creste-ev-{{ section.id }} .act-box{flex-direction:row;align-items:center;margin:0px 20px 20px 20px;}#creste-ev-{{ section.id }} .act-label{width:20%;flex-direction:column;border-top-left-radius:18px;border-bottom-left-radius:18px;border-top-right-radius:0px;padding:21px 15px;gap:0px;}#creste-ev-{{ section.id }} .act-label .sm{margin-top:2px;}#creste-ev-{{ section.id }} .act-right{border-top:1.33px solid #E9DCC7;border-top-right-radius: 18px;border-bottom-right-radius: 18px; border-bottom-left-radius: 0px;border-left: 0;padding: 6px 0px;}#creste-ev-{{ section.id }} .form-h{font-size:40px;margin-bottom:24px;}#creste-ev-{{ section.id }} form .grid{grid-template-columns:1fr 1fr 1fr;gap: 27px;}#creste-ev-{{ section.id }} form .m-full{grid-column:auto;}#creste-ev-{{ section.id }} form .span2{grid-column:span 2;}
#creste-ev-{{ section.id }} .ev-sub{font-size: 20px;}
#creste-ev-{{ section.id }} .flip-ic{width: 80px; height: 80px;}
#creste-ev-{{ section.id }} .flip-f{gap: 12px;}
#creste-ev-{{ section.id }} .flip-t{font-size: 18px;}
#creste-ev-{{ section.id }} .flip-d{ font-size: 14px;}
#creste-ev-{{ section.id }} .act-label .big{font-size: 48px;line-height:1;}
#creste-ev-{{ section.id }} form label{font-size:16px;}
#creste-ev-{{ section.id }} .act-c{width:72px; height: 72px;}
#creste-ev-{{ section.id }} .form-btn{max-width: 488px;padding: 20px 48px;font-size: 24px;line-height: 28px;height: auto;}
#creste-ev-{{ section.id }} .form-note{font-size:18px;font-weight:500;}
}
#creste-ev-{{ section.id }} .ev-hint svg path{stroke: #E87BAC;}
</style>
{% render 'creste-bg', id: _bgid, d: section.settings.bg_desktop, m: section.settings.bg_mobile %}
<div id='creste-ev-{{ section.id }}' class='creste-section' style='--aspd:{{ section.settings.act_speed }}s;'>
<div class='ev-wrap'>
<h2 class='ev-h'>{{ section.settings.heading_a }}<em> {{ section.settings.heading_accent }}</em><br>{{ section.settings.heading_b }}</h2>
<p class='ev-sub'>{{ section.settings.subtitle }}</p>
<div class='ev-do'><div class='ev-do-track'>{% for block in section.blocks %}{% if block.type == 'service' %}<div class='flip' tabindex='0' {{ block.shopify_attributes }}><div class='flip-in'><div class='flip-f'><div class='flip-ic' style='background:{{ block.settings.icon_bg }};'>{% if block.settings.icon != blank %}<img src='{{ block.settings.icon | image_url: width: 80 }}' alt=''>{% endif %}</div><p class='flip-t'>{{ block.settings.title }}</p><p class='flip-d'>{{ block.settings.desc }}</p></div><div class='flip-b'>{% if block.settings.back_image != blank %}<img src='{{ block.settings.back_image | image_url: width: 360 }}' alt='{{ block.settings.title | escape }}'>{% endif %}<div class='cap'>{{ block.settings.title }}</div></div></div></div>{% endif %}{% endfor %}</div></div>
{% if section.settings.hint != blank %}<p class='ev-hint'>{{ section.settings.hint }} {{ 'icon-arrow-right-long.svg' | inline_asset_content }}</p>{% endif %}
<div class='act-box'>
<div class='act-label'><span class='big'>{{ section.settings.act_count }}</span><span class='sm'>{{ section.settings.act_suffix }}</span></div>
<div class='act-right'><div class='act-track'>{% for n in (1..2) %}{% for block in section.blocks %}{% if block.type == 'activity' %}<div class='act-item' {{ block.shopify_attributes }}><div class='act-c'>{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 160 }}' alt='{{ block.settings.label | escape }}'>{% endif %}</div><p class='act-l'>{{ block.settings.label }}</p></div>{% endif %}{% endfor %}{% endfor %}</div></div>
</div>
<div class='form-box'>
<h3 class='form-h'>{{ section.settings.form_a }}<br>{{ section.settings.form_pre }}<em> {{ section.settings.form_accent1 }} </em>{{ section.settings.form_mid }}<em> {{ section.settings.form_accent2 }}</em></h3>
{% form 'contact' %}
{% if form.posted_successfully? %}<div class='form-ok'>Thanks! Our team will respond within 24 hours.</div>{% endif %}
<div class='grid'>
<div><label>Full Name</label><input type='text' name='contact[Full name]' placeholder='Enter'></div>
<div><label>Phone Number</label><input type='tel' name='contact[Phone]' placeholder='Enter'></div>
<div class='m-full'><label>Email</label><input type='email' name='contact[email]' placeholder='Enter' required></div>
<div class='m-full'><label>Number Of Participants</label><input type='number' name='contact[Participants]' placeholder='Enter'></div>
<div class='m-full'><label>Age Group Of The Participant</label><input type='text' name='contact[Age group]' placeholder='Enter'></div>
<div><label>Preferred Date</label><input type='date' name='contact[Preferred date]' placeholder='Enter'></div>
<div><label>City / Venue</label><input type='text' name='contact[City or venue]' placeholder='Enter'></div>
<div class='m-full span2'><label>Anything Else We Should Know?</label><input type='text' name='contact[Notes]' placeholder='Enter'></div>
</div>
<button type='submit' class='form-btn'>{{ section.settings.button_label }}</button>
<p class='form-note'>{{ section.settings.note }}</p>
{% endform %}
</div>
</div>
</div>
{% schema %}
{
  "name": "Creste Events + Form",
  "tag": "section",
  "settings": [ {"type":"image_picker","id":"bg_desktop","label":"Background banner (desktop)"}, {"type":"image_picker","id":"bg_mobile","label":"Background banner (mobile)"}, {"type":"color","id":"section_bg","label":"Section background","default":"#F9D8E8"}, {"type":"text","id":"heading_a","label":"Heading start","default":"We create "}, {"type":"text","id":"heading_accent","label":"Heading accent (pink)","default":"meaningful"}, {"type":"text","id":"heading_b","label":"Heading line 2","default":"learning experiences together"}, {"type":"textarea","id":"subtitle","label":"Subtitle","default":"We host engaging DIY & STEM based events for every occasion."}, {"type":"text","id":"hint","label":"Cards hint","default":"Swipe to see more"}, {"type":"text","id":"act_count","label":"Activities count","default":"170+"}, {"type":"text","id":"act_suffix","label":"Activities suffix","default":"Activities We Offer"}, {"type":"range","id":"act_speed","min":10,"max":60,"step":2,"unit":"s","label":"Activity scroll speed","default":26}, {"type":"text","id":"form_a","label":"Form heading line 1","default":"Our activities are designed for all age groups —"}, {"type":"text","id":"form_pre","label":"Line 2 start","default":"because "}, {"type":"text","id":"form_accent1","label":"Form accent 1","default":"creativity"}, {"type":"text","id":"form_mid","label":"Form heading mid","default":" has "}, {"type":"text","id":"form_accent2","label":"Form accent 2","default":"no age!"}, {"type":"text","id":"button_label","label":"Button","default":"Get In touch"}, {"type":"text","id":"note","label":"Note","default":"Drop us a message - our team responds within 24 hours."} ],
  "blocks": [ {"type":"service","name":"Service card (flip)","settings":[ {"type":"image_picker","id":"icon","label":"Icon"}, {"type":"color","id":"icon_bg","label":"Icon background","default":"#E1F1F6"}, {"type":"text","id":"title","label":"Title","default":"Corporate Events"}, {"type":"textarea","id":"desc","label":"Description","default":"Engage your teams with creative, hands-on experiences."}, {"type":"image_picker","id":"back_image","label":"Flip image (back)"} ]}, {"type":"activity","name":"Activity (circle)","settings":[ {"type":"image_picker","id":"image","label":"Image"}, {"type":"text","id":"label","label":"Label","default":"Slime Making"} ]} ],
  "max_blocks": 40,
  "presets": [ {"name":"Creste Events + Form"} ]
}
{% endschema %}