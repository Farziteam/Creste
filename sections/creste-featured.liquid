{% render 'creste-tokens' %}
{%- assign _bgid = 'creste-fi-' | append: section.id -%}
<style>
#creste-fi-{{ section.id }}{padding:36px 0;background:{{ section.settings.bg }};background-size:cover;background-position:center;/*width:100vw; */max-width:100vw;/*margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);*/overflow:hidden;}
#creste-fi-{{ section.id }} .fi-h{text-align:center;margin:0 0 24px;font-family:'Nunito',sans-serif;font-weight:900;font-size:30px;line-height:1.1;color:var(--creste-ink2);}
#creste-fi-{{ section.id }} .fi-h em{font-style:normal;color:var(--creste-orange);}
#creste-fi-{{ section.id }} .fi-row{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
#creste-fi-{{ section.id }} .fi-row+.fi-row{margin-top:20px;}
#creste-fi-{{ section.id }} .fi-track{display:flex;gap:22px;width:max-content;align-items:center;padding: 1rem;}
#creste-fi-{{ section.id }} .fi-row.r1 .fi-track{animation:fi-left var(--sp,32s) linear infinite;}
#creste-fi-{{ section.id }} .fi-row.r2 .fi-track{animation:fi-right var(--sp,32s) linear infinite;}
#creste-fi-{{ section.id }} .fi-track:hover{animation-play-state:paused;}
#creste-fi-{{ section.id }} .fi-logo{flex:0 0 auto;height:96px;min-width:180px;display:flex;align-items:center;justify-content:center;background:#F4F4F4;border-radius:20px;padding:0 34px;}
#creste-fi-{{ section.id }} .fi-logo img{max-height:50px;width:auto;display:block;}
#creste-fi-{{ section.id }} .fi-logo .fi-ph{font-family:'Nunito',sans-serif;font-weight:900;font-size:22px;color:#9aa;letter-spacing:1.5px;}
@keyframes fi-left{to{transform:translateX(-50%);}}
@keyframes fi-right{from{transform:translateX(-50%);}to{transform:translateX(0);}}
@media(min-width:750px){#creste-fi-{{ section.id }}{padding:30px 0;}#creste-fi-{{ section.id }} .fi-h{font-size:40px;}#creste-fi-{{ section.id }} .fi-track{gap:28px;}#creste-fi-{{ section.id }} .fi-logo{height:130px;min-width:268px;padding:0 44px;border-radius:24px;}#creste-fi-{{ section.id }} .fi-logo img{max-height:84px;}#creste-fi-{{ section.id }} .fi-logo .fi-ph{font-size:30px;}}
@media(max-width:749px){
  #creste-fi-{{ section.id }} .fi-track{ gap: 12px; padding: 0.5rem; }
  #creste-fi-{{ section.id }} .fi-logo img{height: 50px; width: 64px; object-fit: contain;}
  #creste-fi-{{ section.id }} .fi-logo {height: 54px; width: 100px;min-width: unset;}
  #creste-fi-{{ section.id }} .fi-row+.fi-row{margin-top: unset;}
  #creste-fi-{{ section.id }} .fi-h { margin: 0 0 15px;}
}
</style>
{% render 'creste-bg', id: _bgid, d: section.settings.bg_desktop, m: section.settings.bg_mobile %}
<div id='creste-fi-{{ section.id }}' class='creste-section' style='--sp:{{ section.settings.speed }}s;'>
{% if section.settings.heading != blank %}<h2 class='fi-h'>{{ section.settings.heading }}</h2>{% endif %}
<div class='fi-row r1'><div class='fi-track'>{% for n in (1..2) %}{% for block in section.blocks %}{% if block.type == 'logo' and block.settings.row == 'top' %}<div class='fi-logo' {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 400 }}' alt='{{ block.settings.name | escape }}'>{% else %}<span class='fi-ph'>{{ block.settings.name | default: 'LOGO' }}</span>{% endif %}</div>{% endif %}{% endfor %}{% endfor %}</div></div>
<div class='fi-row r2'><div class='fi-track'>{% for n in (1..2) %}{% for block in section.blocks %}{% if block.type == 'logo' and block.settings.row == 'bottom' %}<div class='fi-logo' {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<img src='{{ block.settings.image | image_url: width: 400 }}' alt='{{ block.settings.name | escape }}'>{% else %}<span class='fi-ph'>{{ block.settings.name | default: 'LOGO' }}</span>{% endif %}</div>{% endif %}{% endfor %}{% endfor %}</div></div>
</div>
{% schema %}
{
  "name": "Creste Featured In",
  "tag": "section",
  "settings": [ {"type":"image_picker","id":"bg_desktop","label":"Background banner (desktop)"}, {"type":"image_picker","id":"bg_mobile","label":"Background banner (mobile)"}, {"type":"text","id":"heading","label":"Heading","default":"Featured In"}, {"type":"color","id":"bg","label":"Background color","default":"#FFFFFF"}, {"type":"range","id":"speed","min":10,"max":80,"step":2,"unit":"s","label":"Scroll speed (lower = faster)","default":32} ],
  "blocks": [ {"type":"logo","name":"Logo","settings":[ {"type":"image_picker","id":"image","label":"Logo"}, {"type":"text","id":"name","label":"Name / fallback","default":"LOGO"}, {"type":"select","id":"row","label":"Row","default":"top","options":[{"value":"top","label":"Top (moves left)"},{"value":"bottom","label":"Bottom (moves right)"}]} ]} ],
  "max_blocks": 24,
  "presets": [ {"name":"Creste Featured In","blocks":[ {"type":"logo","settings":{"name":"BRAND","row":"top"}}, {"type":"logo","settings":{"name":"MEDIA","row":"top"}}, {"type":"logo","settings":{"name":"PRESS","row":"top"}}, {"type":"logo","settings":{"name":"NEWS","row":"top"}}, {"type":"logo","settings":{"name":"TIMES","row":"bottom"}}, {"type":"logo","settings":{"name":"DAILY","row":"bottom"}}, {"type":"logo","settings":{"name":"WEEKLY","row":"bottom"}}, {"type":"logo","settings":{"name":"POST","row":"bottom"}} ]} ]
}
{% endschema %}