</svg>

              </span>

              <span class="cpdplove__point-t">
                {{ point }}
              </span>
            </div>
          {% endif %}
        {% endfor %}

        <div class="cpdplove__stats cpdplove__stats_desktop">
          {% for card in love_it.card_details.value %}
            {% assign card_parts = card | split: '<br/>' %}

            <div class="cpdplove__stat cpdplove__stat--white">
              
              <span class="cpdplove__stat-n">
                {{ card_parts[0] | remove: '<b>' | remove: '</b>' | strip }}
              </span>

              {% if card_parts[1] != blank %}
                <span class="cpdplove__stat-l">
                  {{ card_parts[1] | strip }}
                </span>
              {% endif %}

            </div>
          {% endfor %}
        </div>
      </div>

       <!-- Card Details -->
    

    </div>


   

  </div>

</section>

{% endif %}
<style>
  #CpdpLove-{{ uid }}{--cpdplove-teal:#35A9C9;--cpdplove-brown:#3D2817;--cpdplove-ink:#5b5750;
    --cpdplove-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdplove-body: var(--font-body-family, 'Poppins',system-ui,sans-serif);
    background:var(--cpdplove-bg);font-family:var(--cpdplove-body);}
  #CpdpLove-{{ uid }} *{box-sizing:border-box;}
  #CpdpLove-{{ uid }} .cpdplove__wrap{max-width:1240px;margin:0 auto;padding:{{ section.settings.padding_top | default: 60 }}px 20px {{ section.settings.padding_bottom | default: 64 }}px;}
  #CpdpLove-{{ uid }} .cpdplove__title{font-family:'Nunito',sans-serif;text-align:center;font-weight:900;font-size:clamp(30px,4vw,48px);color:var(--cpdplove-brown);margin:0 0 10px;letter-spacing:0px;}
  #CpdpLove-{{ uid }} .cpdplove__hl{color:var(--cpdplove-teal);font-style:italic;}
  #CpdpLove-{{ uid }} .cpdplove__sub{text-align:center;font-size:clamp(16px,1.6vw,20px);color:var(--cpdplove-ink);max-width:820px;margin:0 auto 30px;font-family: 'Nunito Sans', sans-serif;letter-spacing:0px;}
  #CpdpLove-{{ uid }} .cpdplove__grid{display:flex;gap:34px;align-items:center;margin-bottom:20px;}
  #CpdpLove-{{ uid }} .cpdplove__media{position:relative;border-radius:22px;overflow:hidden;background:#CFE3F5;width: 55%;}
  #CpdpLove-{{ uid }} .cpdplove__photo,#CpdpLove-{{ uid }} .cpdplove__photo--ph{inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #CpdpLove-{{ uid }} .cpdplove__photo--ph{background:linear-gradient(135deg,#CFE3F5,#AFCBE8);}
  #CpdpLove-{{ uid }} .cpdplove__points{display:flex;flex-direction:column;gap:14px;width: 45%;}
  #CpdpLove-{{ uid }} .cpdplove__point{display:flex;align-items:center;gap:14px;background:#FFFFFF80;border-radius:16px;padding:10px;box-shadow:0 3px 10px rgba(0,0,0,.05);}
  #CpdpLove-{{ uid }} .cpdplove__check{flex:0 0 auto;width:26px;height:26px;border-radius:999px;background:#fff;display:grid;place-items:center;}
  #CpdpLove-{{ uid }} .cpdplove__point-t{
    font-family: 'Poppins', sans-serif;
    font-size: 11.6px;
    letter-spacing: 0px;
    font-weight: 400;
    line-height: 19px;
  }
  #CpdpLove-{{ uid }} .cpdplove__stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:20px;}
  #CpdpLove-{{ uid }} .cpdplove__stat{
    border-radius:19px;padding:20px 10px;display:flex;flex-direction:column;gap:6px;
  }
  #CpdpLove-{{ uid }} .cpdplove__stat--white{background:#fff;}
  #CpdpLove-{{ uid }} .cpdplove__stat--teal{background:var(--cpdplove-teal);}
  #CpdpLove-{{ uid }} .cpdplove__stat--teal .cpdplove__stat-n,#CpdpLove-{{ uid }} .cpdplove__stat--teal .cpdplove__stat-l{color:#fff;}
  #CpdpLove-{{ uid }} .cpdplove__stat-n{
    font-family: 'Fredoka One', sans-serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 120%;
  }
  #CpdpLove-{{ uid }} .cpdplove__stat-l{
    font-family: 'Quicksand', sans-serif;
    font-size: 10.4px;
    line-height: 14px;
    font-weight: 700;
    letter-spacing: 0px;
  }
  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(2),
  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(4) {
    background: var(--cpdplove-teal);
  }

  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(2) .cpdplove__stat-n,
  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(2) .cpdplove__stat-l,
  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(4) .cpdplove__stat-n,
  #CpdpLove-{{ uid }} .cpdplove__stat:nth-child(4) .cpdplove__stat-l {
    color: #fff;
  }
  #CpdpLove-{{ uid }} .cpdplove__stats_desktop{display: grid;}
  #CpdpLove-{{ uid }} .cpdplove__stats_mobile{display: none;}
  @media (max-width:820px){
    #CpdpLove-{{ uid }} .cpdplove__grid{flex-direction: column-reverse;gap:20px;}
    #CpdpLove-{{ uid }} .cpdplove__stats{gap: 8px;}
    #CpdpLove-{{ uid }} .cpdplove__stats_desktop{display: none;}
    #CpdpLove-{{ uid }} .cpdplove__stats_mobile{display: grid;margin-top: 0px;}
  }
  @media (max-width: 768px){
    #CpdpLove-{{ uid }} .cpdplove__media{
      width: 100%;
    }
    #CpdpLove-{{ uid }} .cpdplove__points{
      width: 100%;
    }
    #CpdpLove-{{ uid }} .cpdplove__point{
      gap: 10px;
    } 
    #CpdpLove-{{ uid }} .cpdplove__stat{padding: 8px;gap: 3px;border-radius:10px;}
    #CpdpLove-{{ uid }} .cpdplove__stat-n{
      font-size: 18px;
    }
    #CpdpLove-{{ uid }} .cpdplove__stat-l{
      font-size: 10px;
    }
    #CpdpLove-{{ uid }} .cpdplove__wrap{padding: 20px 20px 30px;}
    #CpdpLove-{{ uid }} .cpdplove__point-t{line-height: 150%;}
    #CpdpLove-{{ uid }} .cpdplove__sub{
      margin: 0px auto 15px;
      line-height: 127%;
    }
    #CpdpLove-{{ uid }} .cpdplove__grid{
      margin-bottom: 5px;
    }
  }
</style>
{% schema %}
{
  "name": "Creste Why Parents Love",
  "tag": "section",
  "class": "creste-love-section",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Heading (dark)", "default": "Why Parents" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (teal)", "default": "Love it" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "See why thousands of families choose this creative activity again and again." },
    { "type": "image_picker", "id": "image", "label": "Lifestyle photo (blank = product lifestyle image)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#DCEBF3" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "default": 64 }
  ],
  "blocks": [
    { "type": "point", "name": "Benefit point", "settings": [ { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "stat", "name": "Stat card", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "6" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "select", "id": "color", "label": "Colour", "default": "white", "options": [ { "value": "white", "label": "White" }, { "value": "teal", "label": "Teal" } ] }
    ] }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Creste Why Parents Love" } ]
}
{% endschema %}
