{{ 'https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600&family=Fredoka+One&family=Quicksand:wght@500;600;700&display=swap' | stylesheet_tag }}

<section class="tribe-gram" id="tribe-gram-{{ section.id }}">
  <div class="tribe-gram__wrap tribe-gram__center">
    <p class="tribe-gram__eyebrow">{{ section.settings.eyebrow | default: 'DMs & stories' }}</p>
    <h2 class="tribe-gram__h2">{{ section.settings.heading | default: 'Straight From The Gram' }}</h2>
    <p class="tribe-gram__sub">{{ section.settings.subheading | default: 'Unedited, unpaid, straight out of our inbox.' }}</p>
  </div>
  <div class="tribe-gram__rail">
    <button class="tribe-gram__nav tribe-gram__nav--prev" aria-label="Scroll left" type="button">←</button>
    <div class="tribe-gram__track">
      {% for block in section.blocks %}
        {% if block.type == 'story' %}
          <div class="tribe-gram__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,360,480' }}
            {% else %}
              <div class="tribe-gram__ph"></div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <button class="tribe-gram__nav tribe-gram__nav--next" aria-label="Scroll right" type="button">→</button>
  </div>
</section>

<style>
#tribe-gram-{{ section.id }}{
  --ink:#3B2D22; --orange:#F4793A; --body-soft:#96826C; --white:#FFFFFF;
  --teal:#3AACCC; --pink:#E87BAC; --yellow:#F7CB45; --purple:#9B7FD4;
  --f-display:'Nunito','Trebuchet MS',sans-serif; --f-ui:'Quicksand','Nunito',sans-serif; --f-body:'Poppins','Helvetica Neue',sans-serif;
  --maxw:1280px; --pad:clamp(1.1rem,4vw,3.5rem); --sec:clamp(3.5rem,7vw,6.5rem);
  --shadow:0 10px 30px rgba(122,92,62,.10); --shadow-lg:0 20px 52px rgba(122,92,62,.18);
  padding-block:var(--sec);font-family:var(--f-body);
}
#tribe-gram-{{ section.id }} *{box-sizing:border-box}
#tribe-gram-{{ section.id }} .tribe-gram__wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:var(--pad)}
#tribe-gram-{{ section.id }} .tribe-gram__center{text-align:center}
#tribe-gram-{{ section.id }} .tribe-gram__center .tribe-gram__sub{margin-inline:auto}
#tribe-gram-{{ section.id }} .tribe-gram__eyebrow{
  font-family:var(--f-ui);font-weight:700;font-size:.74rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--orange);margin:0 0 .7rem
}
#tribe-gram-{{ section.id }} .tribe-gram__h2{
  font-family:var(--f-display);font-weight:800;line-height:1.12;margin:0;color:var(--ink);
  font-size:clamp(1.85rem,3.7vw,3.1rem)
}
#tribe-gram-{{ section.id }} .tribe-gram__sub{color:var(--body-soft);margin:.7rem 0 0;max-width:58ch}
#tribe-gram-{{ section.id }} .tribe-gram__rail{position:relative;margin-top:2.4rem}
#tribe-gram-{{ section.id }} .tribe-gram__track{
  display:flex;gap:clamp(.8rem,1.6vw,1.5rem);overflow-x:auto;
  scroll-snap-type:x mandatory;scroll-behavior:smooth;
  padding:.4rem var(--pad) 1.4rem;scrollbar-width:none
}
#tribe-gram-{{ section.id }} .tribe-gram__track::-webkit-scrollbar{display:none}
#tribe-gram-{{ section.id }} .tribe-gram__card{
  flex:0 0 auto;width:clamp(180px,20vw,242px);aspect-ratio:9/19;
  border-radius:22px;scroll-snap-align:center;
  border:5px solid var(--white);background:#2A2119;
  box-shadow:var(--shadow);overflow:hidden
}
#tribe-gram-{{ section.id }} .tribe-gram__card img{width:100%;height:100%;object-fit:cover;display:block}
#tribe-gram-{{ section.id }} .tribe-gram__ph{width:100%;height:100%;background:linear-gradient(150deg,var(--teal),var(--pink))}
#tribe-gram-{{ section.id }} .tribe-gram__card:nth-child(4n+1){border-color:var(--teal)}
#tribe-gram-{{ section.id }} .tribe-gram__card:nth-child(4n+2){border-color:var(--pink)}
#tribe-gram-{{ section.id }} .tribe-gram__card:nth-child(4n+3){border-color:var(--yellow)}
#tribe-gram-{{ section.id }} .tribe-gram__card:nth-child(4n){border-color:var(--purple)}
#tribe-gram-{{ section.id }} .tribe-gram__nav{
  position:absolute;top:50%;translate:0 -50%;z-index:5;
  width:52px;height:52px;border-radius:50%;background:var(--ink);color:#fff;
  display:grid;place-items:center;font-size:1.25rem;border:0;cursor:pointer;
  box-shadow:var(--shadow-lg);transition:.2s ease
}
#tribe-gram-{{ section.id }} .tribe-gram__nav:hover{background:var(--orange)}
#tribe-gram-{{ section.id }} .tribe-gram__nav--prev{left:max(.5rem,calc(var(--pad) - 26px))}
#tribe-gram-{{ section.id }} .tribe-gram__nav--next{right:max(.5rem,calc(var(--pad) - 26px))}
@media(max-width:640px){#tribe-gram-{{ section.id }} .tribe-gram__nav{width:44px;height:44px}}
</style>

<script>
(function(){
  var root = document.getElementById('tribe-gram-{{ section.id }}');
  if(!root) return;
  var track = root.querySelector('.tribe-gram__track');
  var prev = root.querySelector('.tribe-gram__nav--prev');
  var next = root.querySelector('.tribe-gram__nav--next');
  function step(){
    var card = track.querySelector('.tribe-gram__card');
    return card ? card.getBoundingClientRect().width + 16 : 260;
  }
  if(prev) prev.addEventListener('click', function(){ track.scrollBy({left: -step()*2, behavior:'smooth'}); });
  if(next) next.addEventListener('click', function(){ track.scrollBy({left: step()*2, behavior:'smooth'}); });
})();
</script>

{% schema %}
{
  "name": "Tribe Gram",
  "tag": "section",
  "class": "section-tribe-gram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DMs & stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight From The Gram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Unedited, unpaid, straight out of our inbox."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tribe Gram"
    }
  ]
}
{% endschema %}
