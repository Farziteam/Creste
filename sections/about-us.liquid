    font-size: 12.5px;
    font-weight: 500;
  }


  /* =========================================
     VIDEO MODAL
     ========================================== */

  #about-us-{{ section.id }} .about-us__modal {
    position: fixed;

    inset: 0;

    z-index: 9999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 30px;
  }

  #about-us-{{ section.id }} .about-us__modal.is-open {
    display: flex;
  }

  #about-us-{{ section.id }} .about-us__modal-backdrop {
    position: absolute;

    inset: 0;

    background: rgba(0, 0, 0, 0.85);

    cursor: pointer;
  }

  #about-us-{{ section.id }} .about-us__modal-content {
    position: relative;

    z-index: 2;

    width: min(1100px, 100%);

    background: #000;

    border-radius: 8px;

    overflow: visible;
  }

  #about-us-{{ section.id }} .about-us__modal-video {
    position: relative;

    width: 100%;

