{% liquid
  assign youtube_url = section.settings.youtube_url
  assign youtube_id = ''

  if youtube_url contains 'youtu.be/'
    assign youtube_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
  elsif youtube_url contains 'youtube.com/watch'
    assign youtube_id = youtube_url | split: 'v=' | last | split: '&' | first
  elsif youtube_url contains 'youtube.com/embed/'
    assign youtube_id = youtube_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first
  elsif youtube_url contains 'youtube.com/shorts/'
    assign youtube_id = youtube_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first
  endif
%}

<section
  id="about-us-{{ section.id }}"
  class="about-us-section"
>

  <!-- =========================================
       MAIN BANNER
  ========================================== -->

  <div
    class="about-us__banner"
    {% if section.settings.banner_image != blank %}
      style="background-image: url('{{ section.settings.banner_image | image_url: width: 2400 }}');"
    {% endif %}
  >
    <div class="about-us__banner-overlay"></div>

    <div class="about-us__banner-content">
      {% if section.settings.banner_heading != blank %}
        <h1 class="about-us__banner-heading">
          {{ section.settings.banner_heading }}
        </h1>
      {% endif %}
    </div>
  </div>


  <!-- =========================================
       INTRO CONTENT
  ========================================== -->

  <div class="about-us__container">

    <div class="about-us__intro">

      {% if section.settings.intro_heading != blank %}
        <h2 class="about-us__heading">
          {{ section.settings.intro_heading }}
        </h2>
      {% endif %}

      {% if section.settings.intro_text != blank %}
        <div class="about-us__text">
          {{ section.settings.intro_text }}
        </div>
      {% endif %}

      {% if section.settings.intro_link_text != blank %}
        <a
          href="{{ section.settings.intro_link_url }}"
          class="about-us__link"
        >
          {{ section.settings.intro_link_text }}
        </a>
      {% endif %}

    </div>


    <!-- =========================================
         YOUTUBE VIDEO
    ========================================== -->

    {% if youtube_id != blank %}

      <div class="about-us__video-wrapper">

        <button
          type="button"
          class="about-us__video"
          data-video-id="{{ youtube_id }}"
          aria-label="Play video"
        >

          <img
            src="https://img.youtube.com/vi/{{ youtube_id }}/maxresdefault.jpg"
            alt="{{ section.settings.video_alt_text | escape }}"
            loading="lazy"
            class="about-us__video-thumbnail"
            width="1280"
            height="720"
          >

          <span class="about-us__video-play">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M8 5.5V18.5L18 12L8 5.5Z"
                fill="currentColor"
              />
            </svg>
          </span>

        </button>

      </div>

    {% endif %}


    <!-- =========================================
         OUR BRAND
    ========================================== -->

    <div class="about-us__brand">

      {% if section.settings.brand_heading != blank %}
        <h2 class="about-us__heading">
          {{ section.settings.brand_heading }}
        </h2>
      {% endif %}

      {% if section.settings.brand_text != blank %}
        <div class="about-us__text">
          {{ section.settings.brand_text }}
        </div>
      {% endif %}

    </div>


    <!-- =========================================
         FOUNDER
    ========================================== -->

    <div class="about-us__founder">

      {% if section.settings.founder_image != blank %}
        <div class="about-us__founder-image-wrapper">

          {{
            section.settings.founder_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              class: 'about-us__founder-image'
          }}

        </div>
      {% endif %}


      <div class="about-us__founder-info">

        {% if section.settings.founder_name != blank %}
          <h2 class="about-us__founder-name">
            {{ section.settings.founder_name }}
          </h2>
        {% endif %}

        {% if section.settings.founder_designation != blank %}
          <p class="about-us__founder-designation">
            {{ section.settings.founder_designation }}
          </p>
        {% endif %}

      </div>

    </div>

  </div>


  <!-- =========================================
       YOUTUBE MODAL
  ========================================== -->

  {% if youtube_id != blank %}

    <div
      class="about-us__modal"
      data-video-modal
      aria-hidden="true"
    >

      <div class="about-us__modal-backdrop" data-video-close></div>

      <div
        class="about-us__modal-content"
        role="dialog"
        aria-modal="true"
        aria-label="Video"
      >

        <button
          type="button"
          class="about-us__modal-close"
          data-video-close
          aria-label="Close video"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 5L19 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M19 5L5 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <div class="about-us__modal-video">
          <iframe
            data-video-iframe
            src=""
            title="YouTube video"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>

      </div>

    </div>

  {% endif %}

</section>


<style>

  #about-us-{{ section.id }} {
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-heading: {{ section.settings.heading_color }};
    --about-link: {{ section.settings.link_color }};
    --about-overlay: {{ section.settings.banner_overlay_opacity | divided_by: 100.0 }};
  }

  #about-us-{{ section.id }} {
    background: var(--about-bg);
    color: var(--about-text);
  }


  /* =========================================
     CONTAINER
  ========================================== */

  #about-us-{{ section.id }} .about-us__container {
    width: min(
      calc(100% - 40px),
      {{ section.settings.content_width }}px
    );

    margin: 0 auto;
  }


  /* =========================================
     BANNER
  ========================================== */

  #about-us-{{ section.id }} .about-us__banner {
    position: relative;
    min-height: {{ section.settings.banner_height }}px;

    background-color: #eeeeee;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
  }

  #about-us-{{ section.id }} .about-us__banner-overlay {
    position: absolute;
    inset: 0;

    background: #000;
    opacity: var(--about-overlay);
  }

  #about-us-{{ section.id }} .about-us__banner-content {
    position: relative;
    z-index: 2;

    width: min(
      calc(100% - 40px),
      {{ section.settings.content_width }}px
    );

    text-align: {{ section.settings.banner_text_alignment }};
  }

  #about-us-{{ section.id }} .about-us__banner-heading {
    margin: 0;

    color: {{ section.settings.banner_heading_color }};

    font-size: clamp(
      36px,
      5vw,
      {{ section.settings.banner_heading_size }}px
    );

    line-height: 1.1;
    font-weight: 600;
  }


  /* =========================================
     INTRO
  ========================================== */

  #about-us-{{ section.id }} .about-us__intro {
    max-width: {{ section.settings.text_max_width }}px;
    margin: {{ section.settings.section_spacing }}px auto 0;
    text-align: {{ section.settings.content_alignment }};
  }


  /* =========================================
     COMMON HEADING
  ========================================== */

  #about-us-{{ section.id }} .about-us__heading {
    margin: 0 0 20px;

    color: var(--about-heading);

    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
  }


  /* =========================================
     COMMON TEXT
  ========================================== */

  #about-us-{{ section.id }} .about-us__text {
    color: var(--about-text);

    font-size: {{ section.settings.body_size }}px;
    line-height: 1.7;
  }

  #about-us-{{ section.id }} .about-us__text p {
    margin: 0 0 16px;
  }

  #about-us-{{ section.id }} .about-us__text p:last-child {
    margin-bottom: 0;
  }


  /* =========================================
     LINK
  ========================================== */

  #about-us-{{ section.id }} .about-us__link {
    display: inline-block;

    margin-top: 24px;

    color: var(--about-link);

    font-size: 16px;
    font-weight: 600;

    text-decoration: underline;
    text-underline-offset: 4px;

    transition: opacity 0.2s ease;
  }

  #about-us-{{ section.id }} .about-us__link:hover {
    opacity: 0.7;
  }


  /* =========================================
     VIDEO
  ========================================== */

  #about-us-{{ section.id }} .about-us__video-wrapper {
    margin-top: {{ section.settings.section_spacing }}px;
  }

  #about-us-{{ section.id }} .about-us__video {
    position: relative;

    display: block;

    width: 100%;
    padding: 0;

    border: 0;
    background: transparent;

    cursor: pointer;

    overflow: hidden;

    border-radius: {{ section.settings.video_radius }}px;
  }

  #about-us-{{ section.id }} .about-us__video-thumbnail {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 16 / 9;

    object-fit: cover;

    transition: transform 0.4s ease;
  }

  #about-us-{{ section.id }} .about-us__video:hover
  .about-us__video-thumbnail {
    transform: scale(1.03);
  }

  #about-us-{{ section.id }} .about-us__video-play {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 76px;
    height: 76px;

    transform: translate(-50%, -50%);

    display: flex;
    align-items: center;
    justify-content: center;

    color: #fff;

    background: rgba(0, 0, 0, 0.75);

    border-radius: 50%;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  #about-us-{{ section.id }} .about-us__video:hover
  .about-us__video-play {
    transform: translate(-50%, -50%) scale(1.08);
    background: rgba(0, 0, 0, 0.9);
  }


  /* =========================================
     BRAND
  ========================================== */

  #about-us-{{ section.id }} .about-us__brand {
    max-width: {{ section.settings.text_max_width }}px;

    margin:
      {{ section.settings.section_spacing }}px
      auto 0;

    text-align: {{ section.settings.content_alignment }};
  }


  /* =========================================
     FOUNDER
  ========================================== */

  #about-us-{{ section.id }} .about-us__founder {
    margin:
      {{ section.settings.section_spacing }}px
      auto
      {{ section.settings.section_spacing }}px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 50px;

    max-width: {{ section.settings.founder_max_width }}px;
  }

  #about-us-{{ section.id }} .about-us__founder-image-wrapper {
    flex: 0 0 {{ section.settings.founder_image_width }}px;

    overflow: hidden;

    border-radius: {{ section.settings.founder_image_radius }}px;
  }

  #about-us-{{ section.id }} .about-us__founder-image {
    display: block;

    width: 100%;
    height: auto;
  }

  #about-us-{{ section.id }} .about-us__founder-info {
    {% comment %} flex: 1; {% endcomment %}
  }

  #about-us-{{ section.id }} .about-us__founder-name {
    margin: 0 0 8px;

    color: var(--about-heading);

    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
  }

  #about-us-{{ section.id }} .about-us__founder-designation {
    margin: 0;

    color: var(--about-text);

    font-size: 17px;
    line-height: 1.5;
  }


  /* =========================================
     VIDEO MODAL
  ========================================== */

  #about-us-{{ section.id }} .about-us__modal {
    position: fixed;

    inset: 0;

    z-index: 9999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 30px;
  }

  #about-us-{{ section.id }} .about-us__modal.is-open {
    display: flex;
  }

  #about-us-{{ section.id }} .about-us__modal-backdrop {
    position: absolute;

    inset: 0;

    background: rgba(0, 0, 0, 0.85);

    cursor: pointer;
  }

  #about-us-{{ section.id }} .about-us__modal-content {
    position: relative;

    z-index: 2;

    width: min(1100px, 100%);

    background: #000;

    border-radius: 8px;

    overflow: visible;
  }

  #about-us-{{ section.id }} .about-us__modal-video {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    overflow: hidden;

    border-radius: 8px;
  }

  #about-us-{{ section.id }} .about-us__modal-video iframe {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    border: 0;
  }

  #about-us-{{ section.id }} .about-us__modal-close {
    position: absolute;

    top: -45px;
    right: 0;

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;

    color: #fff;
    background: transparent;

    cursor: pointer;
  }


  /* =========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 749px) {

    #about-us-{{ section.id }} .about-us__container {
      width: calc(100% - 30px);
    }

    #about-us-{{ section.id }} .about-us__banner {
      min-height: {{ section.settings.mobile_banner_height }}px;
    }

    #about-us-{{ section.id }} .about-us__banner-heading {
      font-size: {{ section.settings.mobile_banner_heading_size }}px;
    }

    #about-us-{{ section.id }} .about-us__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #about-us-{{ section.id }} .about-us__text {
      font-size: {{ section.settings.mobile_body_size }}px;
    }

    #about-us-{{ section.id }} .about-us__video-play {
      width: 60px;
      height: 60px;
    }

    #about-us-{{ section.id }} .about-us__founder {
      flex-direction: column;

      gap: 25px;

      text-align: center;
    }

    #about-us-{{ section.id }} .about-us__founder-image-wrapper {
      flex: none;

      width: min(
        {{ section.settings.founder_image_width }}px,
        100%
      );
    }

    #about-us-{{ section.id }} .about-us__founder-name {
      font-size: 26px;
    }

    #about-us-{{ section.id }} .about-us__modal {
      padding: 15px;
    }

    #about-us-{{ section.id }} .about-us__modal-close {
      top: -42px;
    }

  }

</style>


<script>
  (function() {

    const section = document.querySelector(
      '#about-us-{{ section.id }}'
    );

    if (!section) return;

    const videoButton = section.querySelector(
      '[data-video-id]'
    );

    const modal = section.querySelector(
      '[data-video-modal]'
    );

    const iframe = section.querySelector(
      '[data-video-iframe]'
    );

    const closeButtons = section.querySelectorAll(
      '[data-video-close]'
    );

    if (!videoButton || !modal || !iframe) return;


    function openVideo() {

      const videoId =
        videoButton.getAttribute('data-video-id');

      if (!videoId) return;

      iframe.src =
        'https://www.youtube.com/embed/' +
        videoId +
        '?autoplay=1&rel=0';

      modal.classList.add('is-open');

      modal.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.style.overflow = 'hidden';
    }


    function closeVideo() {

      iframe.src = '';

      modal.classList.remove('is-open');

      modal.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.style.overflow = '';
    }


    videoButton.addEventListener(
      'click',
      openVideo
    );


    closeButtons.forEach(function(button) {

      button.addEventListener(
        'click',
        closeVideo
      );

    });


    document.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Escape' &&
          modal.classList.contains('is-open')
        ) {
          closeVideo();
        }

      }
    );

  })();
</script>


{% schema %}

