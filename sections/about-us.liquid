{% liquid
  assign youtube_url = section.settings.youtube_url
  assign youtube_id = ''

  if youtube_url contains 'youtu.be/'
    assign youtube_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
  elsif youtube_url contains 'youtube.com/watch'
    assign youtube_id = youtube_url | split: 'v=' | last | split: '&' | first
  elsif youtube_url contains 'youtube.com/embed/'
    assign youtube_id = youtube_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first
  elsif youtube_url contains 'youtube.com/shorts/'
    assign youtube_id = youtube_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first
  endif
%}

<section
  id="about-us-{{ section.id }}"
  class="about-us-section"
>

  <!-- =========================================
       HERO
       ========================================== -->

  <div class="about-us__hero">

    {% if section.settings.hero_eyebrow != blank %}
      <p class="about-us__eyebrow about-us__eyebrow--orange">
        {{ section.settings.hero_eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.hero_heading != blank %}
      <h1 class="about-us__hero-heading">
        {{ section.settings.hero_heading }}
      </h1>
    {% endif %}

    {% if section.settings.hero_subheading != blank %}
      <p class="about-us__hero-subheading">
        {{ section.settings.hero_subheading }}
      </p>
    {% endif %}

  </div>


  <!-- =========================================
       HERO PHOTO
       ========================================== -->

  {% if section.settings.photo_image != blank or section.settings.photo_badge_text != blank %}

    <div class="about-us__container">

      <div class="about-us__photo">

        <span class="about-us__photo-blob about-us__photo-blob--1" aria-hidden="true"></span>
        <span class="about-us__photo-blob about-us__photo-blob--2" aria-hidden="true"></span>
        <span class="about-us__photo-blob about-us__photo-blob--3" aria-hidden="true"></span>

        {% if section.settings.photo_image != blank %}
          {{
            section.settings.photo_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1400',
              class: 'about-us__photo-image'
          }}
        {% endif %}

        {% if section.settings.photo_badge_text != blank %}
          <div class="about-us__photo-badge">
            <span class="about-us__photo-badge-dot" aria-hidden="true"></span>
            <span class="about-us__photo-badge-text">
              {{ section.settings.photo_badge_text }}
            </span>
          </div>
        {% endif %}

      </div>

    </div>

  {% endif %}


  <!-- =========================================
       INTRO CONTENT
       ========================================== -->

  <div class="about-us__container">

    <div class="about-us__intro">

      {% if section.settings.intro_heading != blank %}
        <h2 class="about-us__heading">
          {{ section.settings.intro_heading }}
        </h2>
      {% endif %}

      {% if section.settings.intro_text != blank %}
        <div class="about-us__intro-text">
          {{ section.settings.intro_text }}
        </div>
      {% endif %}

      {% if section.settings.intro_link_text != blank %}
        <a
          href="{{ section.settings.intro_link_url }}"
          class="about-us__link"
        >
          {{ section.settings.intro_link_text }}
        </a>
      {% endif %}

    </div>

  </div>


  <!-- =========================================
       YOUTUBE VIDEO
       ========================================== -->

  {% if youtube_id != blank %}

    <div class="about-us__container">

      <div class="about-us__video-wrapper">

        <button
          type="button"
          class="about-us__video"
          data-video-id="{{ youtube_id }}"
          aria-label="Play video"
        >

          <img
            src="https://img.youtube.com/vi/{{ youtube_id }}/maxresdefault.jpg"
            alt="{{ section.settings.video_alt_text | escape }}"
            loading="lazy"
            class="about-us__video-thumbnail"
            width="1280"
            height="720"
          >

          <span class="about-us__video-play">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M8 5.5V18.5L18 12L8 5.5Z"
                fill="currentColor"
              />
            </svg>
          </span>

        </button>

      </div>

    </div>

  {% endif %}


  <!-- =========================================
       WHAT WE MAKE
       ========================================== -->

  {% if section.settings.categories_eyebrow != blank or section.settings.categories_list != blank %}

    <div class="about-us__categories">

      {% if section.settings.categories_eyebrow != blank %}
        <p class="about-us__eyebrow about-us__eyebrow--teal">
          {{ section.settings.categories_eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.categories_list != blank %}
        <div class="about-us__pills">
          {% assign category_list = section.settings.categories_list | newline_to_br | split: '<br />' %}
          {% assign pill_classes = 'about-us__pill--peach,about-us__pill--blue,about-us__pill--green,about-us__pill--purple' | split: ',' %}
          {% assign pill_counter = 0 %}
          {% for category in category_list %}
            {% assign category_trimmed = category | strip %}
            {% if category_trimmed != blank %}
              {% assign pill_mod = pill_counter | modulo: 4 %}
              {% assign pill_class = pill_classes[pill_mod] %}
              <span class="about-us__pill {{ pill_class }}">
                {{ category_trimmed }}
              </span>
              {% assign pill_counter = pill_counter | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>

  {% endif %}


  <!-- =========================================
       THE CRESTE PROMISE
       ========================================== -->

  {% if section.settings.promise_eyebrow != blank or section.blocks.size > 0 %}

    <div class="about-us__promise">

      <div class="about-us__promise-header">

        {% if section.settings.promise_eyebrow != blank %}
          <p class="about-us__eyebrow about-us__eyebrow--orange">
            {{ section.settings.promise_eyebrow }}
          </p>
        {% endif %}

        <h2 class="about-us__promise-heading">
          What every box stands for
        </h2>

      </div>

      {% if section.blocks.size > 0 %}
        <div class="about-us__promise-grid">
          {% assign icon_classes = 'about-us__promise-icon--peach,about-us__promise-icon--blue,about-us__promise-icon--green,about-us__promise-icon--purple' | split: ',' %}
          {% assign icon_counter = 0 %}
          {% for block in section.blocks %}
        {% if block.type == 'promise_item' %}
  {% assign icon_mod = icon_counter | modulo: 4 %}
  {% assign icon_class = icon_classes[icon_mod] %}
  <div class="about-us__promise-card" {{ block.shopify_attributes }}>
    <div class="about-us__promise-icon {{ icon_class }}">
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 100 | image_tag: class: 'about-us__promise-icon-image', alt: block.settings.title }}
      {% else %}
        <span class="about-us__promise-icon-glyph"></span>
      {% endif %}
    </div>
    <div class="mobile-wrap">
    {% if block.settings.title != blank %}
      <p class="about-us__promise-title">
        {{ block.settings.title }}
      </p>

                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="about-us__promise-text">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>
              </div>
              {% assign icon_counter = icon_counter | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>

  {% endif %}


  <!-- =========================================
       OUR STORY
       ========================================== -->

  <div class="about-us__story-wrapper">

    <div class="about-us__story">

      {% if section.settings.brand_eyebrow != blank %}
        <p class="about-us__eyebrow about-us__eyebrow--purple">
          {{ section.settings.brand_eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.brand_heading != blank %}
        <h2 class="about-us__story-heading">
          {{ section.settings.brand_heading }}
        </h2>
      {% endif %}

      {% if section.settings.brand_text != blank %}
        <div class="about-us__story-text">
          {{ section.settings.brand_text }}
        </div>
      {% endif %}

      {% if section.settings.founder_name != blank or section.settings.founder_image != blank %}
        <div class="about-us__story-founder">

          {% if section.settings.founder_image != blank %}
            <div class="about-us__story-avatar">
              {{
                section.settings.founder_image
                | image_url: width: 96
                | image_tag:
                  loading: 'lazy',
                  widths: '48, 96',
                  class: 'about-us__story-avatar-image'
              }}
            </div>
          {% endif %}

          <div class="about-us__story-founder-meta">
            {% if section.settings.founder_name != blank %}
              <p class="about-us__story-founder-name">
                {{ section.settings.founder_name }}
              </p>
            {% endif %}

            {% if section.settings.founder_designation != blank %}
              <p class="about-us__story-founder-role">
                {{ section.settings.founder_designation }}
              </p>
            {% endif %}
          </div>

        </div>
      {% endif %}

    </div>

  </div>


  <!-- =========================================
       YOUTUBE MODAL
       ========================================== -->

  {% if youtube_id != blank %}

    <div
      class="about-us__modal"
      data-video-modal
      aria-hidden="true"
    >

      <div class="about-us__modal-backdrop" data-video-close></div>

      <div
        class="about-us__modal-content"
        role="dialog"
        aria-modal="true"
        aria-label="Video"
      >

        <button
          type="button"
          class="about-us__modal-close"
          data-video-close
          aria-label="Close video"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 5L19 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M19 5L5 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <div class="about-us__modal-video">
          <iframe
            data-video-iframe
            src=""
            title="YouTube video"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>

      </div>

    </div>

  {% endif %}

</section>


<style>
  .about-us__promise-icon-image {
  width: 62px;
  height: 62px;
  object-fit: contain;
}

  .about-us-section{
    margin-top: 65px;
  }
  #about-us-{{ section.id }} {
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-heading: {{ section.settings.heading_color }};
    --about-link: {{ section.settings.link_color }};
    --about-overlay: {{ section.settings.banner_overlay_opacity | divided_by: 100.0 }};
  }

  #about-us-{{ section.id }} {
    background: var(--about-bg);
    color: var(--about-text);
    overflow: hidden;
  }


  /* =========================================
     CONTAINER
     ========================================== */

  #about-us-{{ section.id }} .about-us__container {
    width: min(
      calc(100% - 40px),
      {{ section.settings.content_width }}px
    );

    margin: 0 auto;
  }


  /* =========================================
     EYEBROWS
     ========================================== */

  #about-us-{{ section.id }} .about-us__eyebrow {
    margin: 0;

    font-family: 'Quicksand', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
  }

  #about-us-{{ section.id }} .about-us__eyebrow--orange {
    color: #f4793a;
  }

  #about-us-{{ section.id }} .about-us__eyebrow--teal {
    color: #3aaccc;
  }

  #about-us-{{ section.id }} .about-us__eyebrow--purple {
    color: #9b7fd4;
  }


  /* =========================================
     HERO
     ========================================== */

  #about-us-{{ section.id }} .about-us__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;

    max-width: 960px;
    margin: 0 auto;
    padding: 60px 20px 40px;

    text-align: center;
  }

  #about-us-{{ section.id }} .about-us__hero-heading {
    margin: 0;

    max-width: 840px;

    color: var(--about-heading);

    font-family: 'Nunito', sans-serif;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 900;
    line-height: 1.18;
    letter-spacing: -0.6px;
  }

  #about-us-{{ section.id }} .about-us__hero-subheading {
    margin: 0;

    max-width: 680px;

    color: var(--about-text);

    font-family: 'Poppins', sans-serif;
    font-size: 15.5px;
    line-height: 1.6;
  }


  /* =========================================
     HERO PHOTO
     ========================================== */

  #about-us-{{ section.id }} .about-us__photo {
    position: relative;

    min-height: 440px;

    margin-bottom: 8px;
    padding: 0;

    background: #ede7de;
    border-radius: 18px;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  #about-us-{{ section.id }} .about-us__photo-blob {
    position: absolute;
    z-index: 1;

    border-radius: 50%;

    pointer-events: none;
  }

  #about-us-{{ section.id }} .about-us__photo-blob--1 {
    left: 8%;
    top: 41%;

    width: 25%;
    height: 82%;

    background: #fbe1d3;
  }

  #about-us-{{ section.id }} .about-us__photo-blob--2 {
    right: 5%;
    top: -9%;

    width: 17%;
    padding-bottom: 17%;

    background: #d9eef6;
  }

  #about-us-{{ section.id }} .about-us__photo-blob--3 {
    right: 24%;
    bottom: 8%;

    width: 10%;
    padding-bottom: 10%;

    background: #f3efe7;
  }

  #about-us-{{ section.id }} .about-us__photo-image {
    position: relative;
    z-index: 2;

    display: block;

    width: 100%;
    min-height:440px;
    max-height:440px;
    {% comment %} height: auto; {% endcomment %}

    border-radius: 14px;

    object-fit: cover;

    box-shadow: 0 20px 45px rgba(44, 42, 39, 0.14);
  }

  #about-us-{{ section.id }} .about-us__photo-badge {
    position: absolute;
    z-index: 3;

    left: 32px;
    bottom: 24px;

    display: flex;
    align-items: center;
    gap: 8px;

    padding: 8px 16px 8px 14px;

    background: #fff;
    border-radius: 20px;

    box-shadow: 0 8px 20px rgba(44, 42, 39, 0.12);
  }

  #about-us-{{ section.id }} .about-us__photo-badge-dot {
    flex: none;

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #f4793a;
  }

  #about-us-{{ section.id }} .about-us__photo-badge-text {
    color: #2c2a27;

    font-family: 'Quicksand', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }


  /* =========================================
     INTRO
     ========================================== */

  #about-us-{{ section.id }} .about-us__intro {
    max-width: {{ section.settings.text_max_width }}px;
    margin: {{ section.settings.section_spacing }}px auto 0;
    text-align: {{ section.settings.content_alignment }};
  }

  #about-us-{{ section.id }} .about-us__intro-text {
    color: var(--about-heading);

    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    line-height: 1.7;
  }

  #about-us-{{ section.id }} .about-us__intro-text p {
    margin: 0 0 16px;
  }

  #about-us-{{ section.id }} .about-us__intro-text p:last-child {
    margin-bottom: 0;
  }


  /* =========================================
     COMMON HEADING (legacy / intro heading)
     ========================================== */

  #about-us-{{ section.id }} .about-us__heading {
    margin: 0 0 20px;

    color: var(--about-heading);

    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
  }


  /* =========================================
     LINK
     ========================================== */

  #about-us-{{ section.id }} .about-us__link {
    display: inline-block;

    margin-top: 24px;

    color: var(--about-link);

    font-size: 16px;
    font-weight: 600;

    text-decoration: underline;
    text-underline-offset: 4px;

    transition: opacity 0.2s ease;
  }

  #about-us-{{ section.id }} .about-us__link:hover {
    opacity: 0.7;
  }


  /* =========================================
     VIDEO
     ========================================== */

  #about-us-{{ section.id }} .about-us__video-wrapper {
    margin-top: {{ section.settings.section_spacing }}px;
  }

  #about-us-{{ section.id }} .about-us__video {
    position: relative;

    display: block;

    width: 100%;
    padding: 0;

    border: 0;
    background: transparent;

    cursor: pointer;

    overflow: hidden;

    border-radius: {{ section.settings.video_radius }}px;
  }

  #about-us-{{ section.id }} .about-us__video-thumbnail {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 16 / 9;

    object-fit: cover;

    transition: transform 0.4s ease;
  }

  #about-us-{{ section.id }} .about-us__video:hover .about-us__video-thumbnail {
    transform: scale(1.03);
  }

  #about-us-{{ section.id }} .about-us__video-play {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 76px;
    height: 76px;

    transform: translate(-50%, -50%);

    display: flex;
    align-items: center;
    justify-content: center;

    color: #fff;

    background: rgba(0, 0, 0, 0.75);

    border-radius: 50%;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  #about-us-{{ section.id }} .about-us__video:hover .about-us__video-play {
    transform: translate(-50%, -50%) scale(1.08);
    background: rgba(0, 0, 0, 0.9);
  }


  /* =========================================
     WHAT WE MAKE
     ========================================== */

  #about-us-{{ section.id }} .about-us__categories {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;

    padding: 44px 20px;
  }

  #about-us-{{ section.id }} .about-us__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;

    max-width: 900px;
  }

  #about-us-{{ section.id }} .about-us__pill {
    padding: 10px 20px;

    border-radius: 24px;

    color: #2c2a27;

    font-family: 'Quicksand', sans-serif;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  #about-us-{{ section.id }} .about-us__pill--peach {
    background: #fce9de;
  }

  #about-us-{{ section.id }} .about-us__pill--blue {
    background: #ddf0f4;
  }

  #about-us-{{ section.id }} .about-us__pill--green {
    background: #e2f0e6;
  }

  #about-us-{{ section.id }} .about-us__pill--purple {
    background: #ece5f8;
  }


  /* =========================================
     THE CRESTE PROMISE
     ========================================== */

  #about-us-{{ section.id }} .about-us__promise {
    padding: 56px 20px 45px;

    background: #f7f4ef;
  }

  #about-us-{{ section.id }} .about-us__promise-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;

    text-align: center;
  }

  #about-us-{{ section.id }} .about-us__promise-heading {
    margin: 0;

    color: var(--about-heading);

    font-family: 'Nunito', sans-serif;
    font-size: 32px;
    font-weight: 900;
    letter-spacing: -0.4px;
  }

  #about-us-{{ section.id }} .about-us__promise-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;

    max-width: {{ section.settings.content_width }}px;
    margin: 32px auto 0;
    background: white;
    padding: 20px 10px 20px 10px;
  }

  #about-us-{{ section.id }} .about-us__promise-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;

    padding: 26px 24px;

    background: #fff;
    border: 1px solid #e6e1d8;
    border-radius: 16px;
  }

  #about-us-{{ section.id }} .about-us__promise-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 52px;
    height: 52px;

    border-radius: 14px;
  }

  #about-us-{{ section.id }} .about-us__promise-icon-glyph {
    display: block;

    width: 20px;
    height: 20px;

    border-radius: 5px;
    border: 1.5px solid currentColor;
  }

  #about-us-{{ section.id }} .about-us__promise-icon--peach {
    background: #fce9de;
    color: #f4793a;
  }

  #about-us-{{ section.id }} .about-us__promise-icon--blue {
    background: #ddf0f4;
    color: #3aaccc;
  }

  #about-us-{{ section.id }} .about-us__promise-icon--green {
    background: #e2f0e6;
    color: #5bad6f;
  }

  #about-us-{{ section.id }} .about-us__promise-icon--purple {
    background: #ece5f8;
    color: #9b7fd4;
  }

  #about-us-{{ section.id }} .about-us__promise-title {
    margin: 0;

    color: var(--about-heading);

    font-family: 'Nunito', sans-serif;
    font-size: 18px;
    font-weight: 800;
  }

  #about-us-{{ section.id }} .about-us__promise-text {
    margin: 0;

    color: var(--about-text);

    font-family: 'Poppins', sans-serif;
    font-size: 13.5px;
    line-height: 1.55;
  }


  /* =========================================
     OUR STORY
     ========================================== */

  #about-us-{{ section.id }} .about-us__story-wrapper {
    padding: 22px 20px 64px;

    background: #f7f4ef;
  }

  #about-us-{{ section.id }} .about-us__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;

    max-width: 1000px;
    margin: 0 auto;

    background: #fff;
    padding: 41px;
  }

  #about-us-{{ section.id }} .about-us__story-heading {
    margin: 0;

    color: var(--about-heading);

    font-family: 'Nunito', sans-serif;
    font-size: 30px;
    font-weight: 900;
    line-height: 1.27;
    letter-spacing: -0.4px;
  }

  #about-us-{{ section.id }} .about-us__story-text {
    width: 100%;

    color: var(--about-text);

    font-family: 'Poppins', sans-serif;
    font-size: 15.5px;
    line-height: 1.68;
  }

  #about-us-{{ section.id }} .about-us__story-text p {
    margin: 0 0 16px;
  }

  #about-us-{{ section.id }} .about-us__story-text p:last-child {
    margin-bottom: 0;
  }

