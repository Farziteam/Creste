<script>
  (function() {

    const section = document.querySelector(
      '#about-us-{{ section.id }}'
    );

    if (!section) return;

    const videoButton = section.querySelector(
      '[data-video-id]'
    );

    const modal = section.querySelector(
      '[data-video-modal]'
    );

    const iframe = section.querySelector(
      '[data-video-iframe]'
    );

    const closeButtons = section.querySelectorAll(
      '[data-video-close]'
    );

    if (!videoButton || !modal || !iframe) return;


    function openVideo() {

      const videoId =
        videoButton.getAttribute('data-video-id');

      if (!videoId) return;

      iframe.src =
        'https://www.youtube.com/embed/' +
        videoId +
        '?autoplay=1&rel=0';

      modal.classList.add('is-open');

      modal.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.style.overflow = 'hidden';
    }


    function closeVideo() {

      iframe.src = '';

      modal.classList.remove('is-open');

      modal.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.style.overflow = '';
    }


    videoButton.addEventListener(
      'click',
      openVideo
    );


    closeButtons.forEach(function(button) {

      button.addEventListener(
        'click',
        closeVideo
      );

    });


    document.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Escape' &&
          modal.classList.contains('is-open')
        ) {
          closeVideo();
        }

      }
    );

  })();
</script>


