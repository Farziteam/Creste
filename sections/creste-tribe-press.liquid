{{ 'https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600&family=Fredoka+One&family=Quicksand:wght@500;600;700&display=swap' | stylesheet_tag }}

<section class="tribe-press" id="tribe-press-{{ section.id }}">
  <div class="tribe-press__wrap">
    <p class="tribe-press__eyebrow">{{ section.settings.eyebrow | default: 'Press' }}</p>
    <h2 class="tribe-press__h2">{{ section.settings.heading | default: 'Creste In The News' }}</h2>
  </div>
  <div class="tribe-press__strip">
    <div class="tribe-press__track">
      {% for i in (1..2) %}
        {% for block in section.blocks %}
          {% if block.type == 'logo' %}
            <div class="tribe-press__logo" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 260 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ block.settings.name }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
#tribe-press-{{ section.id }}{
  --ink:#3B2D22; --brown:#7A5C3E; --orange:#F4793A; --white:#FFFFFF; --line:#E6DDD1;
  --f-display:'Nunito','Trebuchet MS',sans-serif; --f-ui:'Quicksand','Nunito',sans-serif; --f-body:'Poppins','Helvetica Neue',sans-serif;
  --maxw:1280px; --pad:clamp(1.1rem,4vw,3.5rem); --sec:clamp(3.5rem,7vw,6.5rem);
  padding-block:var(--sec);font-family:var(--f-body);
}
#tribe-press-{{ section.id }} *{box-sizing:border-box}
#tribe-press-{{ section.id }} .tribe-press__wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:var(--pad)}
#tribe-press-{{ section.id }} .tribe-press__eyebrow{
  font-family:var(--f-ui);font-weight:700;font-size:.74rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--orange);margin:0 0 .7rem
}
#tribe-press-{{ section.id }} .tribe-press__h2{
  font-family:var(--f-display);font-weight:800;line-height:1.12;margin:0;color:var(--ink);
  font-size:clamp(1.85rem,3.7vw,3.1rem)
}
#tribe-press-{{ section.id }} .tribe-press__strip{margin-top:2.2rem;overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
#tribe-press-{{ section.id }} .tribe-press__track{display:flex;width:max-content;gap:1.1rem;
  animation:tribe-press-slide-{{ section.id }} 34s linear infinite}
#tribe-press-{{ section.id }} .tribe-press__track:hover{animation-play-state:paused}
@keyframes tribe-press-slide-{{ section.id }}{to{transform:translateX(-50%)}}
#tribe-press-{{ section.id }} .tribe-press__logo{
  flex:0 0 auto;width:clamp(96px,9.5vw,130px);aspect-ratio:1;border-radius:20px;
  display:grid;place-items:center;background:var(--white);border:2px solid var(--line);
  font-family:var(--f-display);font-weight:800;font-size:.82rem;
  color:var(--brown);text-align:center;padding:.6rem;line-height:1.25;
  filter:grayscale(1);opacity:.65;transition:.25s ease
}
#tribe-press-{{ section.id }} .tribe-press__logo img{max-width:100%;max-height:100%;object-fit:contain;filter:inherit}
#tribe-press-{{ section.id }} .tribe-press__logo:hover{filter:none;opacity:1;transform:translateY(-4px) rotate(-2deg);
  border-color:var(--orange);color:var(--ink)}
</style>

{% schema %}
{
  "name": "Tribe Press",
  "tag": "section",
  "class": "section-tribe-press",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Press"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Creste In The News"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name (shown if no image)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tribe Press"
    }
  ]
}
{% endschema %}
