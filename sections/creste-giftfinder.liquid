<style>
#creste-gb-{{ section.id }}{padding:{{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;}
#creste-gb-{{ section.id }} .gb-inner{max-width:{{ section.settings.max_width }}px;margin:0 auto;}
#creste-gb-{{ section.id }} a{display:block;}
#creste-gb-{{ section.id }} img,#creste-gb-{{ section.id }} .gb-ph svg{display:block;width:100%;height:auto;border-radius:{{ section.settings.radius }}px;}
#creste-gb-{{ section.id }} .gb-m{display:none;}
@media(max-width:749px){#creste-gb-{{ section.id }}.has-m .gb-d{display:none;}#creste-gb-{{ section.id }}.has-m .gb-m{display:block;}}
</style>
<div id='creste-gb-{{ section.id }}' class='creste-section{% if section.settings.image_mobile != blank %} has-m{% endif %}'>
<div class='gb-inner'>
{% if section.settings.link != blank %}<a href='{{ section.settings.link }}'>{% endif %}
{% if section.settings.image != blank %}<img class='gb-d' src='{{ section.settings.image | image_url: width: 2400 }}' alt='{{ section.settings.alt | escape }}' loading='lazy'>{% else %}<div class='gb-ph'>{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endif %}
{% if section.settings.image_mobile != blank %}<img class='gb-m' src='{{ section.settings.image_mobile | image_url: width: 1200 }}' alt='{{ section.settings.alt | escape }}' loading='lazy'>{% endif %}
{% if section.settings.link != blank %}</a>{% endif %}
</div>
</div>
{% schema %}
{
  "name": "Creste Banner",
  "tag": "section",
  "settings": [ {"type":"image_picker","id":"image","label":"Banner image"}, {"type":"image_picker","id":"image_mobile","label":"Mobile banner (optional)"}, {"type":"url","id":"link","label":"Link (optional)"}, {"type":"text","id":"alt","label":"Alt text","default":"Creste banner"}, {"type":"range","id":"max_width","min":600,"max":1600,"step":20,"unit":"px","label":"Max width","default":1200}, {"type":"range","id":"radius","min":0,"max":48,"step":2,"unit":"px","label":"Corner radius","default":24}, {"type":"range","id":"padding_top","min":0,"max":80,"step":2,"unit":"px","label":"Padding top","default":16}, {"type":"range","id":"padding_bottom","min":0,"max":80,"step":2,"unit":"px","label":"Padding bottom","default":16} ],
  "presets": [ {"name":"Creste Banner"} ]
}
{% endschema %}