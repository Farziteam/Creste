<section id="store-hero-{{ section.id }}" class="store-hero">
  <div class="store-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="store-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="store-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="store-hero__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="store-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: '#' }}" class="store-hero__btn store-hero__btn--primary">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#' }}" class="store-hero__btn store-hero__btn--secondary">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="store-hero__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="store-hero__stat" {{ block.shopify_attributes }}>
              <p class="store-hero__stat-value store-hero__stat-value--{{ block.settings.color }}">{{ block.settings.value }}</p>
              <p class="store-hero__stat-label">{{ block.settings.label }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #store-hero-{{ section.id }} {
    --store-bg: {{ section.settings.background_color }};
    background: var(--store-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #store-hero-{{ section.id }} .store-hero__inner { display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 960px; margin: 0 auto; padding: 0 20px; text-align: center; }
  #store-hero-{{ section.id }} .store-hero__eyebrow { margin: 0; font-family: 'Quicksand', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #3aaccc; }
  #store-hero-{{ section.id }} .store-hero__heading { margin: 0; max-width: 840px; color: #2c2a27; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: clamp(28px, 5vw, 50px); line-height: 1.15; letter-spacing: -0.7px; }
  #store-hero-{{ section.id }} .store-hero__subheading { margin: 0; max-width: 690px; color: #6e6a64; font-family: 'Poppins', sans-serif; font-size: 16px; line-height: 1.6; }
  #store-hero-{{ section.id }} .store-hero__subheading p { margin: 0; }
  #store-hero-{{ section.id }} .store-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  #store-hero-{{ section.id }} .store-hero__btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 28px; border-radius: 999px; font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 700; text-decoration: none; transition: transform 0.15s ease, opacity 0.15s ease; border: 1.5px solid transparent; }
  #store-hero-{{ section.id }} .store-hero__btn:hover { transform: translateY(-1px); opacity: 0.92; }
  #store-hero-{{ section.id }} .store-hero__btn--primary { background: #f4793a; color: #fff; }
  #store-hero-{{ section.id }} .store-hero__btn--secondary { background: #fff; color: #2c2a27; border-color: #e6e1d8; }
  #store-hero-{{ section.id }} .store-hero__stats { display: flex; justify-content: center; gap: 32px; margin-top: 12px; padding: 24px 32px; background: #fff; border-radius: 20px; box-shadow: 0 12px 30px rgba(44, 42, 39, 0.06); }
  #store-hero-{{ section.id }} .store-hero__stat { text-align: center; }
  #store-hero-{{ section.id }} .store-hero__stat-value { margin: 0; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 30px; }
  #store-hero-{{ section.id }} .store-hero__stat-value--orange { color: #f4793a; }
  #store-hero-{{ section.id }} .store-hero__stat-value--teal { color: #3aaccc; }
  #store-hero-{{ section.id }} .store-hero__stat-value--purple { color: #9b7fd4; }
  #store-hero-{{ section.id }} .store-hero__stat-label { margin: 2px 0 0; font-family: 'Poppins', sans-serif; font-size: 13.5px; color: #9c968d; font-weight:600; }
  @media screen and (max-width: 749px) {
    #store-hero-{{ section.id }} .store-hero__stats { flex-wrap: wrap; gap: 20px 24px; padding: 20px; }
    #store-hero-{{ section.id }} .store-hero__actions { flex-direction: column; width: 100%; }
    #store-hero-{{ section.id }} .store-hero__btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Store Hero",
  "tag": "section",
  "class": "section-store-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come make with us in store" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Browse kits, join a hands-on workshop, or plan return gifts and bulk orders with our team. Drop by — the kettle's on and the craft table's ready.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Find a store near you" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Book a workshop" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F7F4EF" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 64 }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3" },
        { "type": "text", "id": "label", "label": "Label", "default": "stores & counting" },
        { "type": "select", "id": "color", "label": "Color", "options": [
            { "value": "orange", "label": "Orange" }, { "value": "teal", "label": "Teal" }, { "value": "purple", "label": "Purple" }
          ], "default": "orange" }
      ] }
  ],
  "presets": [
    { "name": "Store Hero", "blocks": [
        { "type": "stat", "settings": { "value": "3", "label": "stores & counting", "color": "orange" } },
        { "type": "stat", "settings": { "value": "Weekly", "label": "hands-on workshops", "color": "teal" } },
        { "type": "stat", "settings": { "value": "1000+", "label": "little makers hosted", "color": "purple" } }
      ] }
  ]
}
{% endschema %}
