{%- comment -%} Creste — Customer Reviews (editable; swap for a reviews app later) {%- endcomment -%}
{%- liquid assign uid = section.id -%}
<section id="CpdpRev-{{ uid }}" class="cpdprev">
  <div class="cpdprev__wrap">
    <h2 class="cpdprev__title">Customer Reviews</h2>
    <div class="cpdprev__summary">
      <div class="cpdprev__score">
        <div class="cpdprev__stars-lg" aria-hidden="true">★★★★★</div>
        <p class="cpdprev__avg">{{ section.settings.average | default: '4.56' }} out of 5</p>
        <p class="cpdprev__count">Based on {{ section.settings.count | default: '9' }} reviews</p>
      </div>
      <div class="cpdprev__bars">
        {%- assign dist = section.settings.distribution | default: '5,4,0,0,0' | split: ',' -%}
        {%- assign total = 0 -%}
        {%- for d in dist -%}{%- assign total = total | plus: d -%}{%- endfor -%}
        {%- if total == 0 -%}{%- assign total = 1 -%}{%- endif -%}
        {%- for d in dist -%}
          {%- assign starnum = 5 | minus: forloop.index0 -%}
          {%- assign pct = d | times: 100 | divided_by: total -%}
          <div class="cpdprev__bar-row"><span class="cpdprev__bar-stars">{% for i in (1..starnum) %}★{% endfor %}{% for i in (1..5) %}{% if i > starnum %}☆{% endif %}{% endfor %}</span><span class="cpdprev__bar"><span class="cpdprev__bar-fill" style="width:{{ pct }}%"></span></span><span class="cpdprev__bar-n">{{ d }}</span></div>
        {%- endfor -%}
      </div>
      <div class="cpdprev__cta">
        {%- if section.settings.write_url != blank -%}<a href="{{ section.settings.write_url }}" class="cpdprev__write">Write a review</a>{%- else -%}<span class="cpdprev__write">Write a review</span>{%- endif -%}
      </div>
    </div>
    <div class="cpdprev__list">
      {%- for block in section.blocks -%}
        <div class="cpdprev__item" {{ block.shopify_attributes }}>
          <div class="cpdprev__item-top">
            <span class="cpdprev__item-stars">{% assign r = block.settings.rating | plus: 0 %}{% for i in (1..5) %}{% if i <= r %}★{% else %}☆{% endif %}{% endfor %}</span>
            <span class="cpdprev__item-date">{{ block.settings.date }}</span>
          </div>
          <div class="cpdprev__item-user"><span class="cpdprev__avatar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8a7bd8" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg></span><span class="cpdprev__name">{{ block.settings.name }}</span></div>
          <h3 class="cpdprev__item-title">{{ block.settings.title }}</h3>
          <p class="cpdprev__item-body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  #CpdpRev-{{ uid }}{--cpdprev-teal:#3B8FA6;--cpdprev-purple:#6B4EE6;--cpdprev-brown:#3D2817;--cpdprev-ink:#5b5750;--cpdprev-line:#ECE9E2;
    --cpdprev-head: var(--font-heading-family, 'Baloo 2','Poppins',system-ui,sans-serif);
    --cpdprev-body: var(--font-body-family, 'Poppins',system-ui,sans-serif);
    background:#fff;font-family:var(--cpdprev-body);}
  #CpdpRev-{{ uid }} *{box-sizing:border-box;}
  #CpdpRev-{{ uid }} .cpdprev__wrap{max-width:1100px;margin:0 auto;padding:{{ section.settings.padding_top | default: 56 }}px 20px {{ section.settings.padding_bottom | default: 56 }}px;}
  #CpdpRev-{{ uid }} .cpdprev__title{text-align:center;letter-spacing:.14em;text-transform:uppercase;color:var(--cpdprev-teal);font-size:16px;font-weight:700;padding-bottom:12px;border-bottom:2px solid var(--cpdprev-line);margin:0 auto 32px;width:fit-content;}
  #CpdpRev-{{ uid }} .cpdprev__summary{display:grid;grid-template-columns:1fr 1.2fr auto;gap:30px;align-items:center;margin-bottom:36px;}
  #CpdpRev-{{ uid }} .cpdprev__stars-lg{color:#F5B301;font-size:24px;letter-spacing:2px;}
  #CpdpRev-{{ uid }} .cpdprev__avg{font-weight:700;color:var(--cpdprev-brown);margin:6px 0 2px;}
  #CpdpRev-{{ uid }} .cpdprev__count{color:var(--cpdprev-ink);font-size:14px;margin:0;}
  #CpdpRev-{{ uid }} .cpdprev__bars{display:flex;flex-direction:column;gap:8px;}
  #CpdpRev-{{ uid }} .cpdprev__bar-row{display:flex;align-items:center;gap:10px;}
  #CpdpRev-{{ uid }} .cpdprev__bar-stars{color:#F5B301;font-size:13px;letter-spacing:1px;white-space:nowrap;}
  #CpdpRev-{{ uid }} .cpdprev__bar{flex:1;height:14px;background:#EFEDE7;border-radius:6px;overflow:hidden;}
  #CpdpRev-{{ uid }} .cpdprev__bar-fill{display:block;height:100%;background:var(--cpdprev-purple);border-radius:6px;}
  #CpdpRev-{{ uid }} .cpdprev__bar-n{color:#8a8f98;font-size:13px;width:16px;text-align:right;}
  #CpdpRev-{{ uid }} .cpdprev__write{display:inline-block;background:var(--cpdprev-purple);color:#fff;font-weight:700;padding:14px 26px;border-radius:10px;text-decoration:none;}
  #CpdpRev-{{ uid }} .cpdprev__list{display:flex;flex-direction:column;}
  #CpdpRev-{{ uid }} .cpdprev__item{padding:24px 0;border-top:1px solid var(--cpdprev-line);}
  #CpdpRev-{{ uid }} .cpdprev__item-top{display:flex;justify-content:space-between;align-items:center;}
  #CpdpRev-{{ uid }} .cpdprev__item-stars{color:#7B5CD6;font-size:16px;letter-spacing:1px;}
  #CpdpRev-{{ uid }} .cpdprev__item-date{color:#a7a29a;font-size:13px;}
  #CpdpRev-{{ uid }} .cpdprev__item-user{display:flex;align-items:center;gap:8px;margin:8px 0;}
  #CpdpRev-{{ uid }} .cpdprev__avatar{width:28px;height:28px;border-radius:999px;background:#EFEAFB;display:grid;place-items:center;}
  #CpdpRev-{{ uid }} .cpdprev__name{color:#7B5CD6;font-weight:600;font-size:15px;}
  #CpdpRev-{{ uid }} .cpdprev__item-title{font-weight:800;color:var(--cpdprev-brown);font-size:18px;margin:6px 0 8px;}
  #CpdpRev-{{ uid }} .cpdprev__item-body{color:var(--cpdprev-ink);line-height:1.6;margin:0;}
  @media (max-width:760px){ #CpdpRev-{{ uid }} .cpdprev__summary{grid-template-columns:1fr;gap:20px;text-align:center;} #CpdpRev-{{ uid }} .cpdprev__cta{justify-self:center;} }
</style>
{% schema %}
{
  "name": "Creste Reviews",
  "tag": "section",
  "class": "creste-reviews-section",
  "settings": [
    { "type": "paragraph", "content": "Editable placeholder reviews. For live reviews, connect a reviews app (Judge.me, Loox, etc.)." },
    { "type": "text", "id": "average", "label": "Average score", "default": "4.56" },
    { "type": "text", "id": "count", "label": "Review count", "default": "9" },
    { "type": "text", "id": "distribution", "label": "Star distribution (5,4,3,2,1)", "default": "5,4,0,0,0" },
    { "type": "url", "id": "write_url", "label": "Write-a-review link" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "date", "label": "Date" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "body", "label": "Review" }
    ] }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Creste Reviews" } ]
}
{% endschema %}
